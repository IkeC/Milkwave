MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// Exit Sunlight by felixfaire (Shadertoy llBXWV) / https://www.shadertoy.com/view/llBXWV
comp_2=// CC BY-NC-SA 3.0
comp_3=// Transpiled to HLSL using Milkwave
comp_4=
comp_5=// CONV: adding helper functions
comp_6=float mod_conv(float x, float y) { return x - y * floor(x / y); }
comp_7=float2 mod_conv(float2 x, float2 y) { return x - y * floor(x / y); }
comp_8=float3 mod_conv(float3 x, float3 y) { return x - y * floor(x / y); }
comp_9=float4 mod_conv(float4 x, float4 y) { return x - y * floor(x / y); }
comp_10=
comp_11=static float3 col1 = float3( 0.938, 0.678, 0.375 );
comp_12=static float3 col2 = float3( 0.455, 0.456, 0.55 );
comp_13=
comp_14=static float hillSoftening = 0.01;
comp_15=static float reflectionSoftening = 0.1;
comp_16=
comp_17=float lenv2(float2 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_18=
comp_19=float hash( float n )
comp_20={
comp_21=  return frac(sin(n)*43758.5453);
comp_22=}
comp_23=
comp_24=float noise( in float2 x )
comp_25={
comp_26=  float2 p = floor(x);
comp_27=  float2 f = frac(x);
comp_28=  f = f*f*(3.0-2.0*f);
comp_29=  float n = p.x + p.y*57.0;
comp_30=  float res = lerp(lerp( hash(n+  0.0), hash(n+  1.0),f.x), lerp( hash(n+ 57.0), hash(n+ 58.0),f.x),f.y);
comp_31=  return res;
comp_32=}
comp_33=
comp_34=float fbm( float2 p )
comp_35={
comp_36=  float f = 0.0;
comp_37=  f += 0.50000*noise( p ); p = p*2.02;
comp_38=  f += 0.25000*noise( p ); p = p*2.03;
comp_39=  f += 0.12500*noise( p ); p = p*2.01;
comp_40=  f += 0.06250*noise( p ); p = p*2.04;
comp_41=  f += 0.03125*noise( p );
comp_42=  return f/0.984375;
comp_43=}
comp_44=
comp_45=float4 mod289(float4 x)
comp_46={
comp_47=  return x - floor(x * (1.0 / 289.0)) * 289.0;
comp_48=}
comp_49=
comp_50=float4 permute(float4 x)
comp_51={
comp_52=  return mod289(((x*34.0)+1.0)*x);
comp_53=}
comp_54=
comp_55=float4 taylorInvSqrt(float4 r)
comp_56={
comp_57=  return 1.79284291400159 - 0.85373472095314 * r;
comp_58=}
comp_59=
comp_60=float2 fade(float2 t) {
comp_61=  return t*t*t*(t*(t*6.0-15.0)+10.0);
comp_62=}
comp_63=
comp_64=float pnoise(float2 P, float2 rep)
comp_65={
comp_66=  float4 Pi = floor(P.xyxy) + float4(0.0, 0.0, 1.0, 1.0);
comp_67=  float4 Pf = frac(P.xyxy) - float4(0.0, 0.0, 1.0, 1.0);
comp_68=  Pi = mod_conv(Pi, rep.xyxy);
comp_69=  // To create noise with explicit period
comp_70=  Pi = mod289(Pi);
comp_71=  // To avoid truncation effects in permutation
comp_72=  float4 ix = Pi.xzxz;
comp_73=  float4 iy = Pi.yyww;
comp_74=  float4 fx = Pf.xzxz;
comp_75=  float4 fy = Pf.yyww;
comp_76=
comp_77=  float4 i = permute(permute(ix) + iy);
comp_78=
comp_79=  float4 gx = frac(i * (1.0 / 41.0)) * 2.0 - 1.0 ;
comp_80=  float4 gy = abs(gx) - 0.5 ;
comp_81=  float4 tx = floor(gx + 0.5);
comp_82=  gx = gx - tx;
comp_83=
comp_84=  float2 g00 = float2(gx.x,gy.x);
comp_85=  float2 g10 = float2(gx.y,gy.y);
comp_86=  float2 g01 = float2(gx.z,gy.z);
comp_87=  float2 g11 = float2(gx.w,gy.w);
comp_88=
comp_89=  float4 norm = taylorInvSqrt(float4(dot(g00, g00), dot(g01, g01), dot(g10, g10), dot(g11, g11)));
comp_90=  g00 *= norm.x;
comp_91=  g01 *= norm.y;
comp_92=  g10 *= norm.z;
comp_93=  g11 *= norm.w;
comp_94=
comp_95=  float n00 = dot(g00, float2(fx.x, fy.x));
comp_96=  float n10 = dot(g10, float2(fx.y, fy.y));
comp_97=  float n01 = dot(g01, float2(fx.z, fy.z));
comp_98=  float n11 = dot(g11, float2(fx.w, fy.w));
comp_99=
comp_100=  float2 fade_xy = fade(Pf.xy);
comp_101=  float2 n_x = lerp(float2(n00, n01), float2(n10, n11), fade_xy.x);
comp_102=  float n_xy = lerp(n_x.x, n_x.y, fade_xy.y);
comp_103=  return 2.3 * n_xy;
comp_104=}
comp_105=
comp_106=shader_body {
comp_107=  float4 fragColor = 0;
comp_108=  float2 fragCoord  = uv;
comp_109=  // CONV: Center on screen, then try some aspect correction
comp_110=  uv = (uv*2) - 1;
comp_111=  uv *= aspect.xy;
comp_112=  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_113=  uv = float2(uv.x, -uv.y);
comp_114=  // CONV: Adjust viewpoint (x,y individually or both)
comp_115=  uv += float2(0,0) + 0;
comp_116=  uv *= float2(1,1) * 1;
comp_117=
comp_118=  // float2 uv = fragCoord.xy / uv.xy;
comp_119=  // CONV block above already centers the uv ([0..1] -> [-1..1]) and applies the aspect correction
comp_120=
comp_121=  float3 col = float3( 0.0 ,  0.0 ,  0.0 );
comp_122=
comp_123=  if (abs(uv.x) < 1.0)
comp_124=  {
comp_125=
comp_126=    // add sky
comp_127=    col += lerp( col1, col2, abs(uv.y) ) + 0.2;
comp_128=    col += lerp( float3(1.0, 1.0, 1.0), float3(0.3, 0.3, 0.3), abs((uv.y - 0.45) * 1.5) ) * 0.3;
comp_129=
comp_130=    // add hills
comp_131=    for (int i = 0; i < 2; i++)
comp_132=    {
comp_133=      float edge = fbm( float2(0.0, uv.x * 3.0 + float(i)) ) * 0.15 + 0.1;
comp_134=      if (uv.y < edge + hillSoftening && uv.y > 0.0)
comp_135=      col -= 0.8 * smoothstep( edge + hillSoftening, edge, uv.y );
comp_136=    }
comp_137=
comp_138=    // add vignette
comp_139=    float r = lenv2( uv );
comp_140=    col -= r * r * 0.2;
comp_141=
comp_142=    float dist = 1.0 - abs(uv.y) * 0.9;
comp_143=    uv.y *= 0.9;
comp_144=
comp_145=    // add shadows
comp_146=    if (uv.y < 0.1)
comp_147=    {
comp_148=      uv.x *= dist * 1.2;
comp_149=      col -= 0.6 * smoothstep(-0.3, 0.1, uv.y);
comp_150=
comp_151=      float sand = pnoise(float2(uv.x * 3.5 * dist + dist * 100.0, uv.y * 40.0 * dist), float2(100.0, 100.0)) -
comp_152=      pnoise(float2(uv.x * 5.0 * dist * dist * dist, uv.y * 1.0 * dist), float2(100.0, 100.0));
comp_153=      if (sand > 0.4)
comp_154=      col -= smoothstep(0.4, 0.7, dist) * 0.2 * smoothstep( 0.4, 0.8, sand);
comp_155=
comp_156=    }
comp_157=
comp_158=    // warp reflections
comp_159=    if (uv.y < 0.0)
comp_160=    {
comp_161=      uv.x += 0.05 * pnoise(float2(uv.x * 10.0 * dist, uv.y * 100.0 * dist + time * 0.5), float2(100.0, 100.0));
comp_162=      uv.y += 0.04 * pnoise(float2(uv.x * 10.0 * dist, uv.y * (100.0 * dist + 20.0) + time * 0.5), float2(50.0, 100.0)) * (0.5 + abs(uv.x) * 2.0) - 0.05;
comp_163=    }
comp_164=
comp_165=    // add mountain reflections
comp_166=    for (int i = 0; i < 2; i++)
comp_167=    {
comp_168=      float edge = fbm( float2(0.0, uv.x * 3.0 + float(i)) ) * 0.1 + 0.1;
comp_169=
comp_170=      if (uv.y > -edge - reflectionSoftening && uv.y < 0.1)
comp_171=      col -= 0.3 * smoothstep( -edge - reflectionSoftening, -edge, uv.y );
comp_172=    }
comp_173=
comp_174=    // highlights
comp_175=    col -= smoothstep( 0.5, 0.0, abs(uv.y + 0.6) ) * 0.2;
comp_176=    col += smoothstep( 0.3, 0.0, abs(uv.y + 0.3) ) * 0.1;
comp_177=    col -= smoothstep( 0.6, 0.0, abs(uv.y + 1.0) ) * 0.1;
comp_178=    col.z += 0.05 * (1.0 - dist);
comp_179=  }
comp_180=
comp_181=  fragColor = float4(col,1.0);
comp_182=  ret = fragColor;
comp_183=}
