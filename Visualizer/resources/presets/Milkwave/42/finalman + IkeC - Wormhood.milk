MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// Wormhood by finalman (Shadertoy MdcSRj) / https://www.shadertoy.com/view/MdcSRj
comp_2=// CC BY-NC-SA 3.0
comp_3=// Transpiled to HLSL using Milkwave
comp_4=
comp_5=#define tx (sin(time)*0.5+1)
comp_6=
comp_7=// CONV: setting iChannel samplers to default noise texture
comp_8=#define iChannel0 sampler_noise_lq
comp_9=
comp_10=// CONV: adding helper functions
comp_11=float mod_conv(float x, float y) { return x - y * floor(x / y); }
comp_12=float2 mod_conv(float2 x, float2 y) { return x - y * floor(x / y); }
comp_13=float3 mod_conv(float3 x, float3 y) { return x - y * floor(x / y); }
comp_14=float4 mod_conv(float4 x, float4 y) { return x - y * floor(x / y); }
comp_15=
comp_16=static const int MAX_STEPS = 200;
comp_17=static const int NUM_SPHERES = 12;
comp_18=
comp_19=float lenv(float2 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_20=float lenv(float3 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_21=
comp_22=float sphere(float3 pos, float radius, float3 smpl)
comp_23={
comp_24=  return lenv(pos - smpl) - radius;
comp_25=}
comp_26=
comp_27=float plane(float3 dir, float offset, float3 smpl)
comp_28={
comp_29=  return dot(dir, smpl) + offset;
comp_30=}
comp_31=
comp_32=float dfDist(float3 smpl)
comp_33={
comp_34=  float T1 = 10.0;
comp_35=  float T2 = 2.0 * T1;
comp_36=
comp_37=  float result = 10000.0;
comp_38=
comp_39=  smpl.y += sin(smpl.z * 0.2 + time) * sin(time * 1.33)
comp_40=  + sin(smpl.x * 0.3 + time) * sin(time * 3.22)
comp_41=  + sin(smpl.x * 0.5 + smpl.z * 0.22 + time) * sin(time * 2.22 + smpl.z * 0.1);
comp_42=  float o = floor((smpl.z + T1) / T2);
comp_43=  smpl.x += o * 7.0;
comp_44=  smpl.xz = mod_conv(smpl.xz + T1, float2(T2, T2)) - T1;
comp_45=
comp_46=  for (int i = 0; i < NUM_SPHERES; i++)
comp_47=  {
comp_48=    float t = float(i) / float(NUM_SPHERES);
comp_49=    float n = t + time * 0.25 + o * 0.5;
comp_50=    float3 pos = float3(sin(n * 5.0) * 5.0, cos(n * 3.0) * 9.0, cos(n * 2.0) * 3.0 + 5.0);
comp_51=    float radius = frac(sin(t * 154.31 + 1.7) * 43758.5453) * 2.0 + 1.4;
comp_52=    result = min(result, sphere(pos, radius, smpl));
comp_53=  }
comp_54=
comp_55=  result = min(result, plane(float3(0, -1, 0), 10.0, smpl));
comp_56=  result = min(result, plane(float3(0, 1, 0), 10.0, smpl));
comp_57=
comp_58=  return result;
comp_59=}
comp_60=
comp_61=float3 dfNormal(float3 smpl)
comp_62={
comp_63=  static const float E = 0.04;
comp_64=
comp_65=  float d0 = dfDist(smpl);
comp_66=  float dX = dfDist(smpl + float3(E, 0, 0));
comp_67=  float dY = dfDist(smpl + float3(0, E, 0));
comp_68=  float dZ = dfDist(smpl + float3(0, 0, E));
comp_69=
comp_70=  return normalize(float3(dX - d0, dY - d0, dZ - d0));
comp_71=}
comp_72=
comp_73=float dfOcclusion(float3 smpl, float3 normal)
comp_74={
comp_75=  float N = 1.0;
comp_76=  return clamp(dfDist(smpl + normal * N) / N, 0.0, 1.0);
comp_77=}
comp_78=
comp_79=float trace(inout float3 pos, float3 dir, inout float3 normal)
comp_80={
comp_81=  int steps = 0;
comp_82=  for (int i = 0; i < MAX_STEPS; i++)
comp_83=  {
comp_84=    steps++;
comp_85=    float d = dfDist(pos);
comp_86=    pos += d * dir * 1.0;
comp_87=
comp_88=    if (d < 0.001)
comp_89=    {
comp_90=      // CONV: replaced break with breaking condition
comp_91=      i = MAX_STEPS;
comp_92=    }
comp_93=
comp_94=  }
comp_95=
comp_96=  normal = dfNormal(pos);
comp_97=  return float(steps) / float(MAX_STEPS);
comp_98=}
comp_99=
comp_100=shader_body {
comp_101=  float4 fragColor = 0;
comp_102=  float2 fragCoord = uv;
comp_103=  // CONV: Center on screen, then try some aspect correction
comp_104=  uv = (uv*2) - 1;
comp_105=  uv *= aspect.xy;
comp_106=  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_107=  uv = float2(uv.x, -uv.y);
comp_108=  // CONV: Adjust viewpoint (x,y individually or both)
comp_109=  uv += float2(0,0) + 0;
comp_110=  uv *= float2(1,1) * 1;
comp_111=  // AUDIO: 1 = calm (bass_smooth), 2 = more reactive (bass_att), 3+ = static - see the remote's Version tooltip
comp_112=  #ifdef bass_smooth
comp_113=    float aRng = (int)vis_version == 1 ? 0.26 : 0.45;
comp_114=    float aFac = (int)vis_version > 2 ? 1*vis_intensity+vis_shift
comp_115=      : (1.0 - aRng*0.5 + smoothstep(0,2,(int)vis_version == 1 ? bass_smooth : bass_att)*aRng) * vis_intensity + vis_shift;
comp_116=  #else
comp_117=    float aFac = (1.0 - 0.15) + smoothstep(0,2,bass_att)*0.30;
comp_118=  #endif
comp_119=  float aDev = aFac - 1.0;   // 0 at the track average, +loud, -quiet
comp_120=  float aBe  = aDev * 4.0, aCol = (int)vis_version == 1 ? 0.7 : 1.3;   // beat scale, colour reaction scale
comp_121=  // AUDIO: the camera only pulls back on beats, so it never ends up inside a worm
comp_122=  fragCoord = (fragCoord - 0.5) * (1.0 + max(aDev, 0.0) * 0.6) + 0.5;
comp_123=
comp_124=  float3 opos = float3(4.5,sin(time * 0.4) * 3.0 + 2.0,-7.0 + time * 3.0);
comp_125=  float3 pos = opos;
comp_126=  float3 dir = normalize(float3((fragCoord.x - 0.5) * texsize.x / texsize.y, 0.5 - fragCoord.y, 1.0));
comp_127=  float3 normal = float3(0, 0, 0);
comp_128=
comp_129=  float steps = trace(pos, dir, normal);
comp_130=  float occ = dfOcclusion(pos, normal);
comp_131=  float fogAmt = 1.0 - exp(-lenv(opos - pos) * 0.01);
comp_132=  float3 fogCol = float3(0.2, 0.14, 0.18);
comp_133=
comp_134=  float3 diffuse = float3(0.4, 0.5, 0.6) * dot(normal, normalize(float3(1.0, 0.3, -1.0)));
comp_135=  float3 ambient = float3(0.4, 0.2, 0.1);
comp_136=  float3 color = (ambient + diffuse) * float3(1.0 - steps, 1.0 - steps, 1.0 - steps) + pow(1.0 - occ, 1.5) * float3(1.0, 0.9, 0.8) * 0.8;
comp_137=
comp_138=  color = lerp(color, fogCol, fogAmt);
comp_139=  color = (1.0 - exp(-color * 1.5)) * 1.3;
comp_140=  fragColor = float4(color, 1.0);
comp_141=  ret = fragColor;
comp_142=  // AUDIO: the flesh colours rotate with the level
comp_143=  ret = lerp(ret, ret.zyx, aBe * 0.15 * aCol);
comp_144=}
comp_145=
