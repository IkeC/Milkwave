MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// Particle Experiment 7 by aiekick (Shadertoy MddGWN) / https://www.shadertoy.com/view/MddGWN
comp_2=// CC BY-NC-SA 3.0
comp_3=// Transpiled to HLSL using Milkwave
comp_4=
comp_5=#define tx (sin(time)*0.5+1)
comp_6=
comp_7=// CONV2: guarded length helpers (legacy compiler reports lenv() as division by zero)
comp_8=float lenv(float2 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_9=float lenv(float3 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_10=
comp_11=shader_body {
comp_12=  float4 fragColor = 0;
comp_13=  float2 fragCoord  = uv;
comp_14=  // CONV: Center on screen, then try some aspect correction
comp_15=  uv = (uv*2) - 1;
comp_16=  uv *= aspect.xy;
comp_17=  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_18=  uv = float2(uv.x, -uv.y);
comp_19=  // CONV: Adjust viewpoint (x,y individually or both)
comp_20=  uv += float2(0,0) + 0;
comp_21=  uv *= float2(1,1) * 1;
comp_22=
comp_23=  float t = time+5.;
comp_24=  float z = 6.;
comp_25=
comp_26=  const int n = 100;
comp_27=  // particle count
comp_28=
comp_29=  float3 startColor = float3(0,0.64,0.2);
comp_30=  float3 endColor = float3(0.06,0.35,0.85);
comp_31=
comp_32=  float startRadius = 0.84;
comp_33=  float endRadius = 1.6;
comp_34=
comp_35=  float power = 0.51;
comp_36=  float duration = 4.;
comp_37=
comp_38=  float2 s = texsize.xy;
comp_39=  float2 pix = fragCoord.xy * texsize.xy;
comp_40=  float2 v = z*(2.*pix - s)/s.y;
comp_41=
comp_42=  // Mouse axis y => zoom
comp_43=  if(mouse.z>0.) v *= mouse.y * 20.;
comp_44=
comp_45=  // Mouse axis x => duration
comp_46=  if(mouse.z>0.) duration = mouse.x * 10.;
comp_47=
comp_48=  float3 col = float3(0., 0., 0.);
comp_49=
comp_50=  float2 pm = v.yx*2.8;
comp_51=
comp_52=  float dMax = duration;
comp_53=
comp_54=  float evo = (sin(time*.01+400.)*.5+.5)*99.+1.;
comp_55=
comp_56=  float mb = 0.;
comp_57=  float mbRadius = 0.;
comp_58=  float sum = 0.;
comp_59=  for(int i=min(frame,0);i<n;i++)
comp_60=  {
comp_61=    float d = frac(t*power+48934.4238*sin(float(i/int(evo))*692.7398));
comp_62=
comp_63=    float tt = 0.;
comp_64=
comp_65=    float a = 6.28*float(i)/float(n);
comp_66=
comp_67=    float x = d*cos(a)*duration;
comp_68=
comp_69=    float y = d*sin(a)*duration;
comp_70=
comp_71=    float distRatio = d/dMax;
comp_72=
comp_73=    mbRadius = lerp(startRadius, endRadius, distRatio);
comp_74=
comp_75=    float2 p = v - float2(x,y);
comp_76=    // *float2(1,sin(a+3.14159/2.));
comp_77=
comp_78=    mb = mbRadius/dot(p,p);
comp_79=
comp_80=    sum += mb;
comp_81=
comp_82=    col = lerp(col, lerp(startColor, endColor, distRatio), mb/sum);
comp_83=  }
comp_84=
comp_85=  sum /= float(n);
comp_86=
comp_87=  col = normalize(col) * sum;
comp_88=
comp_89=  sum = clamp(sum, 0., .4);
comp_90=
comp_91=  float3 tex = float3(1., 1., 1.);
comp_92=
comp_93=  col *= smoothstep(tex, float3(0., 0., 0.), float3(sum, sum, sum));
comp_94=
comp_95=  fragColor.rgb = col;
comp_96=  ret = fragColor;
comp_97=}
