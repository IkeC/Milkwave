MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// Moon Surface II by 4rknova (Shadertoy 4tlXzr) / https://www.shadertoy.com/view/4tlXzr
comp_2=// CC BY-NC-SA 3.0
comp_3=// Transpiled to HLSL using Milkwave
comp_4=
comp_5=#define tx (sin(time)*0.5+1)
comp_6=
comp_7=#define EPS		.001
comp_8=#define PI		3.14159265359
comp_9=#define RADIAN	180. / PI
comp_10=#define SPEED	25.
comp_11=
comp_12=float hash(in float n) { return frac(sin(n)*43758.5453123); }
comp_13=
comp_14=float hash(float2 p)
comp_15={
comp_16=  return frac(sin(dot(p,float2(127.1,311.7))) * 43758.5453123);
comp_17=}
comp_18=
comp_19=float noise(float2 p)
comp_20={
comp_21=  float2 i = floor(p), f = frac(p);
comp_22=  f *= f*(3.-2.*f);
comp_23=
comp_24=  float2 c = float2(0,1);
comp_25=
comp_26=  return lerp(lerp(hash(i + c.xx),
comp_27=  hash(i + c.yx), f.x),
comp_28=  lerp(hash(i + c.xy),
comp_29=  hash(i + c.yy), f.x), f.y);
comp_30=}
comp_31=
comp_32=float fbm(in float2 p)
comp_33={
comp_34=  return	.5000 * noise(p)
comp_35=  +.2500 * noise(p * 2.)
comp_36=  +.1250 * noise(p * 4.)
comp_37=  +.0625 * noise(p * 8.);
comp_38=}
comp_39=
comp_40=float lenv(float3 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_41=
comp_42=float dst(float3 p)
comp_43={
comp_44=  return dot(float3(p.x, p.y
comp_45=  + 0.45 * fbm(p.zx)
comp_46=  + 2.55 * noise(.1 * p.xz)
comp_47=  + 0.83 * noise(.4 * p.xz)
comp_48=  + 3.33 * noise(.001 * p.xz)
comp_49=  + 3.59 * noise(.0005 * (p.xz + 132.453))
comp_50=  , p.z),  float3(0.,1.,0.));
comp_51=}
comp_52=
comp_53=float3 nrm(float3 p, float d)
comp_54={
comp_55=  return normalize(
comp_56=  float3(dst(float3(p.x + EPS, p.y, p.z)),
comp_57=  dst(float3(p.x, p.y + EPS, p.z)),
comp_58=  dst(float3(p.x, p.y, p.z + EPS))) - d);
comp_59=}
comp_60=
comp_61=bool rmarch(float3 ro, float3 rd, out float3 p, out float3 n)
comp_62={
comp_63=  p = ro;
comp_64=  float3 pos = p;
comp_65=  float d = 1.;
comp_66=
comp_67=  for (int i = min(frame,0); i < 64; i++) {
comp_68=    d = dst(pos);
comp_69=
comp_70=    if (d < EPS) {
comp_71=      p = pos;
comp_72=      // CONV: replaced break with breaking condition
comp_73=      i = 64;
comp_74=    }
comp_75=
comp_76=    pos += d * rd;
comp_77=  }
comp_78=
comp_79=  n = nrm(p, d);
comp_80=  return d < EPS;
comp_81=}
comp_82=
comp_83=float4 render(float2 uv_conv)
comp_84={
comp_85=  float t = time;
comp_86=
comp_87=  float2 uvn = uv_conv;
comp_88=
comp_89=  float vel = SPEED * t;
comp_90=
comp_91=  float3 cu = float3(2. * noise(float2(.3 * t, .3 * t)) - 1.,1., 1. * fbm(float2(.8 * t, .8 * t)));
comp_92=  float3 cp = float3(0, 3.1 + noise(float2(t, t)) * 3.1, vel);
comp_93=  float3 ct = float3(1.5 * sin(t),
comp_94=  -2. + cos(t) + fbm(cp.xz) * .4, 13. + vel);
comp_95=
comp_96=  float3 ro = cp,
comp_97=  rd = normalize(float3(uvn, 1. / tan(60. * RADIAN)));
comp_98=
comp_99=  float3 cd = ct - cp,
comp_100=  rz = normalize(cd),
comp_101=  rx = normalize(cross(rz, cu)),
comp_102=  ry = normalize(cross(rx, rz));
comp_103=
comp_104=  rd = normalize(mul(rd, float3x3(rx, ry, rz)));
comp_105=
comp_106=  float3 sp, sn;
comp_107=  float3 col = (rmarch(ro, rd, sp, sn) ?
comp_108=  float3(.6, .6, .6) * dot(sn, normalize(float3(cp.x, cp.y + .5, cp.z) - sp))
comp_109=  : float3(0., 0., 0.));
comp_110=
comp_111=  return float4(col, lenv(ro-sp));
comp_112=}
comp_113=
comp_114=shader_body {
comp_115=  float4 fragColor = 0;
comp_116=  float2 fragCoord = uv;
comp_117=  // CONV: Center on screen, then try some aspect correction
comp_118=  uv = (uv*2) - 1;
comp_119=  uv *= aspect.xy;
comp_120=  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_121=  uv = float2(uv.x, -uv.y);
comp_122=  // CONV: Adjust viewpoint (x,y individually or both)
comp_123=  uv += float2(0,0) + 0;
comp_124=  uv *= float2(1,1) * 1;
comp_125=
comp_126=  // float2 uv = fragCoord.xy / uv.xy * 2. - 1.;
comp_127=
comp_128=  float3 col = float3(0., 0., 0.);
comp_129=
comp_130=  if (abs(EPS + uv.y) < .7) {
comp_131=    float4 res = render(uv);
comp_132=    col = res.xyz;
comp_133=    col *= 1.75 * smoothstep(sqrt(max(dot(uv, uv), 0.000001)) * .35, .75, .4);
comp_134=    float noiseN = hash((hash(uv.x) + uv.y) * time) * .15;
comp_135=    col += noiseN;
comp_136=    col *= smoothstep(EPS, 3.5, time);
comp_137=  }
comp_138=
comp_139=  fragColor = float4(col, 1);
comp_140=  ret = fragColor;
comp_141=}
