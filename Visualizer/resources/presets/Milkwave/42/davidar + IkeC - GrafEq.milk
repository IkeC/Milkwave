MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// davidar - GrafEq / https://www.shadertoy.com/view/Xs3GWj
comp_2=// License: Creative Commons Attribution-NonCommercial-ShareAlike 3.0 (Shadertoy default)
comp_3=// Transpiled to HLSL using Milkwave
comp_4=
comp_5=#define tx (sin(time)*0.5+1)
comp_6=
comp_7=// CONV: adding helper functions
comp_8=float mod_conv(float x, float y) { return x - y * floor(x / y); }
comp_9=float2 mod_conv(float2 x, float2 y) { return x - y * floor(x / y); }
comp_10=float3 mod_conv(float3 x, float3 y) { return x - y * floor(x / y); }
comp_11=float4 mod_conv(float4 x, float4 y) { return x - y * floor(x / y); }
comp_12=
comp_13=#define AA 4.
comp_14=
comp_15=#define PI 3.141592653589793
comp_16=
comp_17=float2 CRTCurveUV( float2 uv_conv ) {
comp_18=  uv_conv = uv_conv * 2.0 - 1.0;
comp_19=  float2 offset = abs( uv_conv.yx ) / float2( 6.0, 4.0 );
comp_20=  uv_conv = uv_conv + uv_conv * offset * offset;
comp_21=  uv_conv = uv_conv * 0.5 + 0.5;
comp_22=  return uv_conv;
comp_23=}
comp_24=
comp_25=void DrawVignette( inout float3 color, float2 uv_conv ) {
comp_26=  float vignette = uv_conv.x * uv_conv.y * ( 1.0 - uv_conv.x ) * ( 1.0 - uv_conv.y );
comp_27=  vignette = clamp( pow( 16.0 * vignette, 0.3 ), 0.0, 1.0 );
comp_28=  color *= vignette;
comp_29=}
comp_30=
comp_31=void DrawScanline( inout float3 color, float2 uv_conv ) {
comp_32=  float scanline      = clamp( 0.95 + 0.05 * cos( 3.14 * ( uv_conv.y + 0.008 * time ) * 240.0 * 1.0 ), 0.0, 1.0 );
comp_33=  float grille        = 0.85 + 0.15 * clamp( 1.5 * cos( 3.14 * uv_conv.x * 640.0 * 1.0 ), 0.0, 1.0 );
comp_34=  color *= scanline * grille * 1.2;
comp_35=}
comp_36=
comp_37=float atanp(in float2 p) { return atan2(p.y,p.x); }
comp_38=float cube_root(float x) { return sign(x) * pow(abs(x), 1./3.); }
comp_39=float sq(float x) { return x*x; }
comp_40=
comp_41=float3 margarita(in float2 p) {
comp_42=  float z = length(p) - 3.5 * atanp(p) + sin(p.x) + cos(p.y);
comp_43=  float3 r = float3(1, 1, 1);
comp_44=  if(mod_conv(z,7.*PI) < PI/2.) r = float3(1,0,0);
comp_45=  if(mod_conv(z,1.*PI) < PI/2.) r = float3(0, 0, 0);
comp_46=  return r;
comp_47=}
comp_48=
comp_49=float3 digital_bacteria(in float2 p) {
comp_50=  p /= 4.;
comp_51=  float x = sq(sin(p.x)+p.y) + sq(cos(p.y)+p.x);
comp_52=  float y = cos(10.*p.x) + cos(10.*p.y) - sin(p.x*p.y);
comp_53=  float z = sq(sin(floor(p.x))+floor(p.y)) + sq(cos(floor(p.y))+floor(p.x));
comp_54=  float3 r = float3(85./256.,85./256.,0.);
comp_55=  if(17. < x && x < 21. && 17. < z && z < 21. && y < 0.) r = float3(1.,1.,85./256.);
comp_56=  if(17. < z && z < 21.) r = float3(85./256.,0.,0.);
comp_57=  if(17. < x && x < 21.) r = float3(170./256.,170./256.,0.);
comp_58=  return r;
comp_59=}
comp_60=
comp_61=float3 threesome(in float2 p) {
comp_62=  p /= 3.;
comp_63=  float z = 1.;
comp_64=  z *= sin(length(p + float2(5,0))) * cos(8.*atanp(p + float2(5,0)));
comp_65=  z *= sin(length(p - float2(5,5))) * cos(8.*atanp(p - float2(5,5)));
comp_66=  z *= sin(length(p + float2(0,5))) * cos(8.*atanp(p + float2(0,5)));
comp_67=  float3 r = float3(1, 1, 1);
comp_68=  if(-0.1 < z && z < 0. || 0.2 < z) r = float3(0, 0, 0);
comp_69=  return r;
comp_70=}
comp_71=
comp_72=float3 plaid_meltdown(in float2 p) {
comp_73=  p /= 15.;
comp_74=  p += 7.;
comp_75=  float a = 2.*sin(p.x*sin(p.y) + p.y*sin(p.x));
comp_76=  float b = cube_root(sin(2.5*sqrt(2.) * (p.x - p.y)));
comp_77=  float c = cube_root(sin(2.5*sqrt(2.) * (p.x + p.y)));
comp_78=  float d = sin(80.*p.x) + sin(80.*p.y);
comp_79=  float3 r = float3(1, 1, 1);
comp_80=  if(0.25 * (a + b + c) > 0.5 * d) r = float3(0, 0, 0);
comp_81=  return r;
comp_82=}
comp_83=
comp_84=float3 sunlight_revealed(in float2 p) {
comp_85=  p /= 6.;
comp_86=  p.x += 2.;
comp_87=  float a = length(float2(3.-p.x,p.y)) + abs(p.y) + abs(1.-p.x);
comp_88=  float f = atan2(p.y,p.x-1.);
comp_89=  float c = atan2(p.y,p.x-3.);
comp_90=  float R = sq(p.x-1.) + sq(p.y);
comp_91=  float3 col = float3(0, 0, 0);
comp_92=  bool mix = false;
comp_93=  if(5. < a && a < 7. && mod_conv(f,PI/7.) < PI/14.) {
comp_94=    col += float3(0.,82./256.,173./256.);
comp_95=    if(mix) col /= 2.;
comp_96=    mix = true;
comp_97=  }
comp_98=
comp_99=  if(5. < a && a < 7. && mod_conv(c,PI/9.) < PI/18.) {
comp_100=    col += float3(1,0,0);
comp_101=    if(mix) col /= 2.;
comp_102=    mix = true;
comp_103=  }
comp_104=
comp_105=  if(5. < a && a < 7. && mod_conv(f,PI/8.) < PI/16.) {
comp_106=    col += float3(1,1,0);
comp_107=    if(mix) col /= 2.;
comp_108=    mix = true;
comp_109=  }
comp_110=
comp_111=  if((45.-3.*p.x)*PI/180. < f && f < (47.-p.x)*PI/180. && p.y > 0.1*p.x
comp_112=  && mod_conv(log(R)/log(f),2.) < 1.) {
comp_113=    col += float3(1, 1, 1);
comp_114=    if(mix) col /= 2.;
comp_115=  }
comp_116=
comp_117=  return col;
comp_118=}
comp_119=
comp_120=shader_body {
comp_121=  float4 fragColor = 0;
comp_122=  float2 fragCoord = uv;
comp_123=  // CONV: Center on screen, then try some aspect correction
comp_124=  uv = (uv*2) - 1;
comp_125=  uv *= aspect.xy;
comp_126=  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_127=  uv = float2(uv.x, -uv.y);
comp_128=  // CONV: Adjust viewpoint (x,y individually or both)
comp_129=  uv += float2(0,0) + 0;
comp_130=  uv *= float2(1,1) * 1;
comp_131=
comp_132=  float t = mod_conv(time,10.);
comp_133=  float3 color = float3(0, 0, 0);
comp_134=  for(float i = 0.; i < AA*AA - 0.5; i += 1.) {
comp_135=    float2 uv2 = fragCoord.xy + float2(floor(i/AA), mod_conv(i,AA))/(AA*texsize.xy);
comp_136=    float2 crtUV = CRTCurveUV( uv2 );
comp_137=    if ( crtUV.x >= 0.0 && crtUV.x <= 1.0 && crtUV.y >= 0.0 && crtUV.y <= 1.0 ) {
comp_138=    float2 p = 50.0 * crtUV - 25.0;
comp_139=    p *= 0.75 + 0.05*mod_conv(time,10.);
comp_140=    p += mod_conv(time,10.) - 5.;
comp_141=    p.x *= texsize.x / texsize.y;
comp_142=    if(t < 2. || 8. < t) {
comp_143=      float fade = smoothstep(0.,2.,t) - smoothstep(8.,10.,t);
comp_144=      float scale = texsize.y/50.*float(AA)*fade + 1.;
comp_145=      p = floor(p.xy*scale)/scale;
comp_146=    }
comp_147=
comp_148=    float3 c = float3(0, 0, 0);
comp_149=    if     (mod_conv(0.1*time,5.) < 1.) c = margarita(p);
comp_150=    else if(mod_conv(0.1*time,5.) < 2.) c = plaid_meltdown(p);
comp_151=    else if(mod_conv(0.1*time,5.) < 3.) c = sunlight_revealed(p);
comp_152=    else if(mod_conv(0.1*time,5.) < 4.) c = threesome(p);
comp_153=    else if(mod_conv(0.1*time,5.) < 5.) c = digital_bacteria(p);
comp_154=
comp_155=    DrawVignette( c, crtUV );
comp_156=    DrawScanline( c, uv2 );
comp_157=    color += c / float(AA*AA); }
comp_158=  }
comp_159=
comp_160=  fragColor.xyz = color;
comp_161=  fragColor.w = 1.0;
comp_162=  ret = fragColor;
comp_163=}
