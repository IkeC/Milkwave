comp_245=float icosahedral(float3 p, float r) {
comp_246=  float s = abs(dot(p,n4));
comp_247=  s = max(s, abs(dot(p,n5)));
comp_248=  s = max(s, abs(dot(p,n6)));
comp_249=  s = max(s, abs(dot(p,n7)));
comp_250=  s = max(s, abs(dot(p,n8)));
comp_251=  s = max(s, abs(dot(p,n9)));
comp_252=  s = max(s, abs(dot(p,n10)));
comp_253=  s = max(s, abs(dot(p,n11)));
comp_254=  s = max(s, abs(dot(p,n12)));
comp_255=  s = max(s, abs(dot(p,n13)));
comp_256=  return s - r;
comp_257=}
