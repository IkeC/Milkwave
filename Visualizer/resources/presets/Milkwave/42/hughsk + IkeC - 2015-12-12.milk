comp_299=shader_body {
comp_300=  float4 fragColor = 0;
comp_301=  float2 fragCoord = uv;
comp_302=  // CONV: Center on screen, then try some aspect correction
comp_303=  uv = (uv*2) - 1;
comp_304=  uv *= aspect.xy;
comp_305=  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_306=  uv = float2(uv.x, -uv.y);
comp_307=  // CONV: Adjust viewpoint (x,y individually or both)
comp_308=  uv += float2(0,0) + 0;
comp_309=  uv *= float2(1,1) * 1;
comp_310=
comp_311=  float3 ro, rd;
comp_312=
comp_313=  float2  suv      = uv;
comp_314=  float2  pixCoord = float2(fragCoord.x, 1.0-fragCoord.y) * texsize.xy;
comp_315=  float dist     = 4.5;
comp_316=  float rotation = mouse.z > 0.0
comp_317=  ? 6. * mouse.x
comp_318=  : time * 0.45;
comp_319=  float height = mouse.z > 0.0
comp_320=  ? 5. * (mouse.y * 2.0 - 1.0)
comp_321=  : -0.2;
comp_322=
comp_323=  orbitCamera_421267681(rotation, height, dist, texsize.xy, ro, rd, pixCoord);
comp_324=
comp_325=  float3 color = bg(ro, rd);
comp_326=  float2 t = calcRayIntersection_3975550108(ro, rd);
comp_327=  if (t.x > -0.5) {
comp_328=    float3 pos = ro + rd * t.x;
comp_329=    float3 nor = calcNormal_3606979787(pos);
comp_330=    float3 ldir1 = normalize(float3(0.8, 1, 0));
comp_331=    float3 ldir2 = normalize(float3(-0.4, -1.3, 0));
comp_332=    float3 lcol1 = float3(0.6, 0.5, 1.1);
comp_333=    float3 lcol2 = float3(1.4, 0.9, 0.8) * 0.7;
comp_334=
comp_335=    float3 ref = refract(rd, nor, 0.97);
comp_336=    float2 u = calcRayIntersection_766934105(ro + ref * 0.1, ref);
comp_337=    if (u.x > -0.5) {
comp_338=      float3 pos2 = ro + ref * u.x;
comp_339=      float3 nor2 = calcNormal_1245821463(pos2);
comp_340=      float spec = cookTorranceSpecular_1460171947(ldir1, -ref, nor2, 0.6, 0.95) * 2.;
comp_341=      float diff1 = 0.05 + max(0., dot(ldir1, nor2));
comp_342=      float diff2 = max(0., dot(ldir2, nor2));
comp_343=
comp_344=      color = spec + (diff1 * lcol1 + diff2 * lcol2);
comp_345=    }
comp_346=
comp_347=    else {
comp_348=      color = bg(ro + ref * 0.1, ref) * 1.1;
comp_349=    }
comp_350=
comp_351=    color += color * cookTorranceSpecular_1460171947(ldir1, -rd, nor, 0.2, 0.9) * 2.;
comp_352=    color += 0.05;
comp_353=  }
comp_354=
comp_355=  float vignette = 1.0 - max(0.0, dot(suv * 0.155, suv));
comp_356=
comp_357=  color.r = smoothstep(0.05, 0.995, color.r);
comp_358=  color.b = smoothstep(-0.05, 0.95, color.b);
comp_359=  color.g = smoothstep(-0.1, 0.95, color.g);
comp_360=  color.b *= vignette;
comp_361=
comp_362=  fragColor.rgb = color;
comp_363=  fragColor.a   = clamp(t.x, 0.5, 1.0);
comp_364=  ret = fragColor;
comp_365=}
