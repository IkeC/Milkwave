comp_258=float2 mapSolid(float3 p) {
comp_259=  p.xz = rotate2D(p.xz, time * 1.25);
comp_260=  p.yx = rotate2D(p.yx, time * 1.85);
comp_261=  p.y += sin(time) * 0.25;
comp_262=  p.x += cos(time) * 0.25;
comp_263=
comp_264=  float d = lenv(p) - 0.25;
comp_265=  float id = 1.0;
comp_266=  float pulse = pow(sin(time * 2.) * 0.5 + 0.5, 9.0) * 2.;
comp_267=
comp_268=  d = lerp(d, sdBox_1117569599(p, float3(0.175, 0.175, 0.175)), pulse);
comp_269=
comp_270=  return float2(d, id);
comp_271=}
