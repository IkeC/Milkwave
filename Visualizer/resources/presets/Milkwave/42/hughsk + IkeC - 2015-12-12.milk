comp_110=float beckmannDistribution_2315452051(float x, float roughness) {
comp_111=  float NdotH = max(x, 0.0001);
comp_112=  float cos2Alpha = NdotH * NdotH;
comp_113=  float tan2Alpha = (cos2Alpha - 1.0) / cos2Alpha;
comp_114=  float roughness2 = roughness * roughness;
comp_115=  float denom = 3.141592653589793 * roughness2 * cos2Alpha * cos2Alpha;
comp_116=  return exp(tan2Alpha / roughness2) / denom;
comp_117=}
