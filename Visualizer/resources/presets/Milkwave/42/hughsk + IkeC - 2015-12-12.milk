comp_122=float beckmannDistribution_2315452051(float x, float roughness) {
comp_123=  float NdotH = max(x, 0.0001);
comp_124=  float cos2Alpha = NdotH * NdotH;
comp_125=  float tan2Alpha = (cos2Alpha - 1.0) / cos2Alpha;
comp_126=  float roughness2 = roughness * roughness;
comp_127=  float denom = 3.141592653589793 * roughness2 * cos2Alpha * cos2Alpha;
comp_128=  return exp(tan2Alpha / roughness2) / denom;
comp_129=}
