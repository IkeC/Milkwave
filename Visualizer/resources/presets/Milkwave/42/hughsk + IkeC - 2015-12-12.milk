comp_289=float3 bg(float3 ro, float3 rd) {
comp_290=  float3 col = 0.1 + (
comp_291=  palette(clamp((random_2281831123(rd.xz + sin(time * 0.1)) * 0.5 + 0.5) * 0.035 - rd.y * 0.5 + 0.35, -1.0, 1.0)
comp_292=  , float3(0.5, 0.45, 0.55)
comp_293=  , float3(0.5, 0.5, 0.5)
comp_294=  , float3(1.05, 1.0, 1.0)
comp_295=  , float3(0.275, 0.2, 0.19)
comp_296=  )
comp_297=  );
comp_298=
comp_299=  float t = intersectPlane(ro, rd, float3(0, 1, 0), 4.);
comp_300=
comp_301=  if (t > 0.0) {
comp_302=    float3 p = ro + rd * t;
comp_303=    float g = (1.0 - pow(abs(sin(p.x) * cos(p.z)), 0.25));
comp_304=
comp_305=    col += (1.0 - fogFactorExp2_529295689(t, 0.04)) * g * float3(5, 4, 2) * 0.075;
comp_306=  }
comp_307=
comp_308=  return col;
comp_309=}
