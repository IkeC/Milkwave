comp_181=void orbitCamera_421267681(
comp_182=in float camAngle,
comp_183=in float camHeight,
comp_184=in float camDistance,
comp_185=in float2 screenResolution,
comp_186=out float3 rayOrigin,
comp_187=out float3 rayDirection,
comp_188=in float2 coord
comp_189=) {
comp_190=  float2 screenPos = squareFrame_1062606552(screenResolution, coord);
comp_191=  float3 rayTarget = float3(0.0, 0.0, 0.0);
comp_192=
comp_193=  rayOrigin = float3(
comp_194=  camDistance * sin(camAngle),
comp_195=  camHeight,
comp_196=  camDistance * cos(camAngle)
comp_197=  );
comp_198=
comp_199=  rayDirection = getRay_870892966(rayOrigin, rayTarget, screenPos, 2.0);
comp_200=}
