comp_234=static float3 n4 = float3(0.577,0.577,0.577);
comp_235=static float3 n5 = float3(-0.577,0.577,0.577);
comp_236=static float3 n6 = float3(0.577,-0.577,0.577);
comp_237=static float3 n7 = float3(0.577,0.577,-0.577);
comp_238=static float3 n8 = float3(0.000,0.357,0.934);
comp_239=static float3 n9 = float3(0.000,-0.357,0.934);
comp_240=static float3 n10 = float3(0.934,0.000,0.357);
comp_241=static float3 n11 = float3(-0.934,0.000,0.357);
comp_242=static float3 n12 = float3(0.357,0.934,0.000);
comp_243=static float3 n13 = float3(-0.357,0.934,0.000);
