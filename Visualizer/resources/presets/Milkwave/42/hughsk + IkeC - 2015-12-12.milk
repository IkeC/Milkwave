comp_34=float2 calcRayIntersection_3975550108(float3 rayOrigin, float3 rayDir, float maxd, float precis) {
comp_35=  float latest = precis * 2.0;
comp_36=  float dist   = +0.0;
comp_37=  float type   = -1.0;
