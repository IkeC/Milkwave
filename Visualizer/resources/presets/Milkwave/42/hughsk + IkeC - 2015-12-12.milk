comp_218=float fogFactorExp2_529295689(
comp_219=float dist,
comp_220=float density
comp_221=) {
comp_222=  const float LOG2 = -1.442695;
comp_223=  float d = density * dist;
comp_224=  return 1.0 - clamp(exp2(d * d * LOG2), 0.0, 1.0);
comp_225=}
