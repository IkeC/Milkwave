comp_227=float intersectPlane(float3 ro, float3 rd, float3 nor, float dist) {
comp_228=  float denom = dot(rd, nor);
comp_229=  float t = -(dot(ro, nor) + dist) / denom;
comp_230=
comp_231=  return t;
comp_232=}
