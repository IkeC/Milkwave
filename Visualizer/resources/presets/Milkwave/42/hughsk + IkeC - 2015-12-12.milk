comp_206=float fogFactorExp2_529295689(
comp_207=float dist,
comp_208=float density
comp_209=) {
comp_210=  const float LOG2 = -1.442695;
comp_211=  float d = density * dist;
comp_212=  return 1.0 - clamp(exp2(d * d * LOG2), 0.0, 1.0);
