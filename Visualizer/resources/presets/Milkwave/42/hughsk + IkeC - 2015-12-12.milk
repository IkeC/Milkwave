comp_119=float cookTorranceSpecular_1460171947(
comp_120=float3 lightDirection,
comp_121=float3 viewDirection,
comp_122=float3 surfaceNormal,
comp_123=float roughness,
comp_124=float fresnel) {
comp_125=
comp_126=  float VdotN = max(dot(viewDirection, surfaceNormal), 0.0);
comp_127=  float LdotN = max(dot(lightDirection, surfaceNormal), 0.0);
comp_128=
comp_129=  float3 H = normalize(lightDirection + viewDirection);
comp_130=
comp_131=  float NdotH = max(dot(surfaceNormal, H), 0.0);
comp_132=  float VdotH = max(dot(viewDirection, H), 0.000001);
comp_133=  float LdotH = max(dot(lightDirection, H), 0.000001);
comp_134=  float G1 = (2.0 * NdotH * VdotN) / VdotH;
comp_135=  float G2 = (2.0 * NdotH * LdotN) / LdotH;
comp_136=  float G = min(1.0, min(G1, G2));
comp_137=
comp_138=  float D = beckmannDistribution_2315452051(NdotH, roughness);
comp_139=
comp_140=  float F = pow(1.0 - VdotN, fresnel);
comp_141=
comp_142=  return  G * F * D / max(3.14159265 * VdotN, 0.000001);
comp_143=}
