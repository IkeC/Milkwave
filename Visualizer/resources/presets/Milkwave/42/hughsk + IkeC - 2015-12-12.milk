comp_277=float3 bg(float3 ro, float3 rd) {
comp_278=  float3 col = 0.1 + (
comp_279=  palette(clamp((random_2281831123(rd.xz + sin(time * 0.1)) * 0.5 + 0.5) * 0.035 - rd.y * 0.5 + 0.35, -1.0, 1.0)
comp_280=  , float3(0.5, 0.45, 0.55)
comp_281=  , float3(0.5, 0.5, 0.5)
comp_282=  , float3(1.05, 1.0, 1.0)
comp_283=  , float3(0.275, 0.2, 0.19)
comp_284=  )
comp_285=  );
comp_286=
comp_287=  float t = intersectPlane(ro, rd, float3(0, 1, 0), 4.);
comp_288=
comp_289=  if (t > 0.0) {
comp_290=    float3 p = ro + rd * t;
comp_291=    float g = (1.0 - pow(abs(sin(p.x) * cos(p.z)), 0.25));
comp_292=
comp_293=    col += (1.0 - fogFactorExp2_529295689(t, 0.04)) * g * float3(5, 4, 2) * 0.075;
comp_294=  }
comp_295=
comp_296=  return col;
comp_297=}
