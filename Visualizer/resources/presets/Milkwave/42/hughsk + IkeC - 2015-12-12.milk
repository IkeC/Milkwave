comp_19=// AUDIO: level deviation, used by the inner and outer shape functions below
comp_20=float mwDeviation() {
comp_21=#ifdef bass_smooth
comp_22=  float aRng = (int)vis_version == 1 ? 0.30 : 0.26;
comp_23=  float aFac = (int)vis_version > 2 ? 1*vis_intensity+vis_shift
comp_24=    : (1.0 - aRng*0.5 + smoothstep(0,2,(int)vis_version == 1 ? bass_smooth : bass_att)*aRng) * vis_intensity + vis_shift;
comp_25=#else
comp_26=  float aFac = (1.0 - 0.15) + smoothstep(0,2,bass_att)*0.30;
comp_27=#endif
comp_28=  return aFac - 1.0;
comp_29=}
