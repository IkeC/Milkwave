comp_233=float icosahedral(float3 p, float r) {
comp_234=  float s = abs(dot(p,n4));
comp_235=  s = max(s, abs(dot(p,n5)));
comp_236=  s = max(s, abs(dot(p,n6)));
comp_237=  s = max(s, abs(dot(p,n7)));
comp_238=  s = max(s, abs(dot(p,n8)));
comp_239=  s = max(s, abs(dot(p,n9)));
comp_240=  s = max(s, abs(dot(p,n10)));
comp_241=  s = max(s, abs(dot(p,n11)));
comp_242=  s = max(s, abs(dot(p,n12)));
comp_243=  s = max(s, abs(dot(p,n13)));
comp_244=  return s - r;
comp_245=}
