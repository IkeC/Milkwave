comp_40=  for (int i=min(frame,0); i < 50; i++) {
comp_41=    // CONV: replaced break with breaking condition
comp_42=    if (latest < precis || dist > maxd)  i = 50;
comp_43=
comp_44=    float2 result = mapRefrac(rayOrigin + rayDir * dist);
comp_45=
comp_46=    latest = result.x;
comp_47=    type   = result.y;
comp_48=    dist  += latest;
comp_49=  }
comp_50=
comp_51=  if (dist < maxd) {
comp_52=    res = float2(dist, type);
comp_53=  }
comp_54=
comp_55=  return res;
comp_56=}
