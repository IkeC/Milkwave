comp_269=
comp_270=float2 mapSolid(float3 p) {
comp_271=  p.xz = rotate2D(p.xz, time * 1.25);
comp_272=  p.yx = rotate2D(p.yx, time * 1.85);
comp_273=  p.y += sin(time) * 0.25;
comp_274=  p.x += cos(time) * 0.25;
comp_275=
comp_276=  float d = lenv(p) - (0.25 + mwDeviation() * 0.06);
comp_277=  float id = 1.0;
comp_278=  float pulse = pow(sin(time * 2.) * 0.5 + 0.5, 9.0) * 2.;
comp_279=
comp_280=  d = lerp(d, sdBox_1117569599(p, float3(0.175, 0.175, 0.175) * (1.0 + mwDeviation() * 0.30)), pulse);
comp_281=
comp_282=  return float2(d, id);
comp_283=}
