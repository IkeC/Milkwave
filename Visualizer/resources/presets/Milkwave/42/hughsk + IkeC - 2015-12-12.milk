comp_215=float intersectPlane(float3 ro, float3 rd, float3 nor, float dist) {
comp_216=  float denom = dot(rd, nor);
comp_217=  float t = -(dot(ro, nor) + dist) / denom;
comp_218=
comp_219=  return t;
