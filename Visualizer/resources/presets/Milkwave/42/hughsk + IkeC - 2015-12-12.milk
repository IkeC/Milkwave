comp_151=float3x3 calcLookAtMatrix_1535977339(float3 origin, float3 target, float roll) {
comp_152=  float3 rr = float3(sin(roll), cos(roll), 0.0);
comp_153=  float3 ww = normalize(target - origin);
comp_154=  float3 uu = normalize(cross(ww, rr));
comp_155=  float3 vv = normalize(cross(uu, ww));
comp_156=
comp_157=  return float3x3(uu, vv, ww);
comp_158=}
