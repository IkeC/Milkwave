comp_27=
comp_28=  for (int i=min(frame,0); i < 50; i++) {
comp_29=    // CONV: replaced break with breaking condition
comp_30=    if (latest < precis || dist > maxd)  i = 50;
comp_31=
comp_32=    float2 result = mapRefrac(rayOrigin + rayDir * dist);
comp_33=
comp_34=    latest = result.x;
comp_35=    type   = result.y;
comp_36=    dist  += latest;
comp_37=  }
comp_38=
comp_39=  if (dist < maxd) {
comp_40=    res = float2(dist, type);
comp_41=  }
comp_42=
comp_43=  return res;
