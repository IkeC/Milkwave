comp_163=float3x3 calcLookAtMatrix_1535977339(float3 origin, float3 target, float roll) {
comp_164=  float3 rr = float3(sin(roll), cos(roll), 0.0);
comp_165=  float3 ww = normalize(target - origin);
comp_166=  float3 uu = normalize(cross(ww, rr));
comp_167=  float3 vv = normalize(cross(uu, ww));
comp_168=
comp_169=  return float3x3(uu, vv, ww);
comp_170=}
