comp_157=float2 squareFrame_1062606552(float2 screenSize, float2 coord) {
comp_158=  float2 position = 2.0 * (coord.xy / screenSize.xy) - 1.0;
comp_159=  position.x *= screenSize.x / screenSize.y;
comp_160=  return position;
