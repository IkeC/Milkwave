comp_311=shader_body {
comp_312=  float4 fragColor = 0;
comp_313=  float2 fragCoord = uv;
comp_314=  // CONV: Center on screen, then try some aspect correction
comp_315=  uv = (uv*2) - 1;
comp_316=  uv *= aspect.xy;
comp_317=  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_318=  uv = float2(uv.x, -uv.y);
comp_319=  // CONV: Adjust viewpoint (x,y individually or both)
comp_320=  uv += float2(0,0) + 0;
comp_321=  uv *= float2(1,1) * 1;
comp_322=
comp_323=  float3 ro, rd;
comp_324=
comp_325=  float2  suv      = uv;
comp_326=  float2  pixCoord = float2(fragCoord.x, 1.0-fragCoord.y) * texsize.xy;
comp_327=  float dist     = 4.5;
comp_328=  float rotation = mouse.z > 0.0
comp_329=  ? 6. * mouse.x
comp_330=  : time * 0.45;
comp_331=  float height = mouse.z > 0.0
comp_332=  ? 5. * (mouse.y * 2.0 - 1.0)
comp_333=  : -0.2;
comp_334=
comp_335=  orbitCamera_421267681(rotation, height, dist, texsize.xy, ro, rd, pixCoord);
comp_336=
comp_337=  float3 color = bg(ro, rd);
comp_338=  float2 t = calcRayIntersection_3975550108(ro, rd);
comp_339=  if (t.x > -0.5) {
comp_340=    float3 pos = ro + rd * t.x;
comp_341=    float3 nor = calcNormal_3606979787(pos);
comp_342=    float3 ldir1 = normalize(float3(0.8, 1, 0));
comp_343=    float3 ldir2 = normalize(float3(-0.4, -1.3, 0));
comp_344=    float3 lcol1 = float3(0.6, 0.5, 1.1);
comp_345=    float3 lcol2 = float3(1.4, 0.9, 0.8) * 0.7;
comp_346=
comp_347=    float3 ref = refract(rd, nor, 0.97);
comp_348=    float2 u = calcRayIntersection_766934105(ro + ref * 0.1, ref);
comp_349=    if (u.x > -0.5) {
comp_350=      float3 pos2 = ro + ref * u.x;
comp_351=      float3 nor2 = calcNormal_1245821463(pos2);
comp_352=      float spec = cookTorranceSpecular_1460171947(ldir1, -ref, nor2, 0.6, 0.95) * 2.;
comp_353=      float diff1 = 0.05 + max(0., dot(ldir1, nor2));
comp_354=      float diff2 = max(0., dot(ldir2, nor2));
comp_355=
comp_356=      color = spec + (diff1 * lcol1 + diff2 * lcol2);
comp_357=    }
comp_358=
comp_359=    else {
comp_360=      color = bg(ro + ref * 0.1, ref) * 1.1;
comp_361=    }
comp_362=
comp_363=    color += color * cookTorranceSpecular_1460171947(ldir1, -rd, nor, 0.2, 0.9) * 2.;
comp_364=    color += 0.05;
comp_365=  }
comp_366=
comp_367=  float vignette = 1.0;   // vignette removed on request
comp_368=
comp_369=  color.r = smoothstep(0.05, 0.995, color.r);
comp_370=  color.b = smoothstep(-0.05, 0.95, color.b);
comp_371=  color.g = smoothstep(-0.1, 0.95, color.g);
comp_372=  color.b *= vignette;
comp_373=
comp_374=  fragColor.rgb = color;
comp_375=  fragColor.a   = clamp(t.x, 0.5, 1.0);
comp_376=  ret = fragColor;
comp_377=}
