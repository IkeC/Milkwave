comp_202=float sdBox_1117569599(float3 position, float3 dimensions) {
comp_203=  float3 d = abs(position) - dimensions;
comp_204=
comp_205=  return min(max(d.x, max(d.y,d.z)), 0.0) + lenv(max(d, 0.0));
