comp_131=float cookTorranceSpecular_1460171947(
comp_132=float3 lightDirection,
comp_133=float3 viewDirection,
comp_134=float3 surfaceNormal,
comp_135=float roughness,
comp_136=float fresnel) {
comp_137=
comp_138=  float VdotN = max(dot(viewDirection, surfaceNormal), 0.0);
comp_139=  float LdotN = max(dot(lightDirection, surfaceNormal), 0.0);
comp_140=
comp_141=  float3 H = normalize(lightDirection + viewDirection);
comp_142=
comp_143=  float NdotH = max(dot(surfaceNormal, H), 0.0);
comp_144=  float VdotH = max(dot(viewDirection, H), 0.000001);
comp_145=  float LdotH = max(dot(lightDirection, H), 0.000001);
comp_146=  float G1 = (2.0 * NdotH * VdotN) / VdotH;
comp_147=  float G2 = (2.0 * NdotH * LdotN) / LdotH;
comp_148=  float G = min(1.0, min(G1, G2));
comp_149=
comp_150=  float D = beckmannDistribution_2315452051(NdotH, roughness);
comp_151=
comp_152=  float F = pow(1.0 - VdotN, fresnel);
comp_153=
comp_154=  return  G * F * D / max(3.14159265 * VdotN, 0.000001);
comp_155=}
