MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// Generators by Kali (Shadertoy Xtf3Rn) / https://www.shadertoy.com/view/Xtf3Rn
comp_2=// CC BY-NC-SA 3.0
comp_3=// Transpiled to HLSL using Milkwave
comp_4=
comp_5=#define tx (sin(time)*0.5+1)
comp_6=
comp_7=// CONV: setting iChannel samplers to default noise texture
comp_8=#define iChannel0 sampler_noise_lq
comp_9=
comp_10=// CONV: adding helper functions
comp_11=float mod_conv(float x, float y) { return x - y * floor(x / y); }
comp_12=float2 mod_conv(float2 x, float2 y) { return x - y * floor(x / y); }
comp_13=float3 mod_conv(float3 x, float3 y) { return x - y * floor(x / y); }
comp_14=float4 mod_conv(float4 x, float4 y) { return x - y * floor(x / y); }
comp_15=
comp_16=#define ENABLE_HARD_SHADOWS
comp_17=// turn off to enable faster AO soft shadows
comp_18=#define ENABLE_POSTPROCESS
comp_19=// Works better on window view rather than full screen
comp_20=
comp_21=#define RAY_STEPS 70
comp_22=#define SHADOW_STEPS 50
comp_23=#define LIGHT_COLOR float3(.85,.9,1.)
comp_24=#define AMBIENT_COLOR float3(.8,.83,1.)
comp_25=#define FLOOR_COLOR float3(1.,.7,.9)
comp_26=#define ENERGY_COLOR float3(1.,.7,.4)
comp_27=#define BRIGHTNESS .9
comp_28=#define GAMMA 1.3
comp_29=#define SATURATION .85
comp_30=
comp_31=#define detail .00005
comp_32=#define t time*.25
comp_33=
comp_34=static float lenv2(float2 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_35=float lenv3(float3 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_36=static float3 lightdir=normalize(float3(0.5,-0.3,-1.));
comp_37=static float3 ambdir=normalize(float3(0.,0.,1.));
comp_38=static const float3 origin=float3(0.,3.11,0.);
comp_39=static float3 energy=float3(0.01, 0.01, 0.01);
comp_40=#ifdef ENABLE_VIBRATION
comp_41=static float vibration=sin(time*60.)*.0013;
comp_42=#else
comp_43=static float vibration=0.;
comp_44=#endif
comp_45=static float det=0.0;
comp_46=static float3 pth1;
comp_47=
comp_48=float2x2 rot(float a) {
comp_49=  return float2x2(cos(a),sin(a),-sin(a),cos(a));
comp_50=}
comp_51=
comp_52=float3 path(float ti) {
comp_53=  return float3(sin(ti),.3-sin(ti*.632)*.3,cos(ti*.5))*.5;
comp_54=}
comp_55=
comp_56=float Sphere(float3 p, float3 rd, float r){
comp_57=// A RAY TRACED SPHERE
comp_58=float b = dot( -p, rd );
comp_59=float inner = b * b - dot( p, p ) + r * r;
comp_60=float sres = -1.0;
comp_61=if( inner >= 0.0 ) sres = b - sqrt( max(inner, 0.0) );
comp_62=return sres;
comp_63=}
comp_64=
comp_65=float2 de(float3 pos) {
comp_66=  float hid=0.;
comp_67=  float3 tpos=pos;
comp_68=  tpos.xz=abs(.5-mod_conv(tpos.xz,1.));
comp_69=  float4 p=float4(tpos,1.);
comp_70=  float y=max(0.,.35-abs(pos.y-3.35))/.35;
comp_71=  for (int i=0; i<7; i++) {
comp_72=  // LOWERED THE ITERS
comp_73=  p.xyz = abs(p.xyz)-float3(-0.02,1.98,-0.02);
comp_74=  p=p*(2.0+vibration*y)/clamp(dot(p.xyz,p.xyz),.4,1.)-float4(0.5,1.,0.4,0.);
comp_75=  p.xz = mul(p.xz, transpose(float2x2(-0.416,-0.91,0.91,-0.416)));
comp_76=}
comp_77=
comp_78=float fl=pos.y-3.013;
comp_79=float fr=(length(max(abs(p.xyz)-float3(0.1,5.0,0.1),float3(0.0,0.0,0.0)))-0.05)/p.w;
comp_80=// RETURN A RRECT
comp_81=float d=min(fl,fr);
comp_82=d=min(d,-pos.y+3.95);
comp_83=if (abs(d-fl)<.001) hid=1.;
comp_84=return float2(d,hid);
comp_85=}
comp_86=
comp_87=float3 normal(float3 p) {
comp_88=  float3 e = float3(0.0,det,0.0);
comp_89=
comp_90=  return normalize(float3(
comp_91=  de(p+e.yxx).x-de(p-e.yxx).x,
comp_92=  de(p+e.xyx).x-de(p-e.xyx).x,
comp_93=  de(p+e.xxy).x-de(p-e.xxy).x
comp_94=  )
comp_95=  );
comp_96=}
comp_97=
comp_98=float shadow(float3 pos, float3 sdir) {
comp_99=// THIS ONLY RUNS WHEN WITH HARD SHADOWS
comp_100=float sh=1.0;
comp_101=float totdist =2.0*det;
comp_102=float dist=10.;
comp_103=float t1=Sphere((pos-.005*sdir)-pth1,-sdir,0.015);
comp_104=if (t1>0. && t1<.5) {
comp_105=  float3 sphglowNorm=normalize(pos-t1*sdir-pth1);
comp_106=  sh=1.-pow(max(.0,dot(sphglowNorm,sdir))*1.2,3.);
comp_107=}
comp_108=
comp_109=for (int steps=min(frame,0); steps<SHADOW_STEPS; steps++) {
comp_110=  if (totdist<.6 && dist>detail) {
comp_111=    float3 p = pos - totdist * sdir;
comp_112=    dist = de(p).x;
comp_113=    sh = min( sh, max(50.*dist/totdist,0.0) );
comp_114=    totdist += max(.01,dist);
comp_115=  }
comp_116=
comp_117=}
comp_118=
comp_119=return clamp(sh,0.1,1.0);
comp_120=}
comp_121=
comp_122=float calcAO( const float3 pos, const float3 nor ) {
comp_123=  float aodet=detail*40.;
comp_124=  float totao = 0.0;
comp_125=  float sca = 14.0;
comp_126=  for( int aoi=0; aoi<5; aoi++ ) {
comp_127=    float hr = aodet*float(aoi*aoi);
comp_128=    float3 aopos =  nor * hr + pos;
comp_129=    float dd = de( aopos ).x;
comp_130=    totao += -(dd-hr)*sca;
comp_131=    sca *= 0.7;
comp_132=  }
comp_133=
comp_134=  return clamp( 1.0 - 5.0*totao, 0., 1.0 );
comp_135=}
comp_136=
comp_137=float _tex2D(float3 p) {
comp_138=  p=abs(.5-frac(p*10.));
comp_139=  float3 c=float3(3., 3., 3.);
comp_140=  float es, l=es=0.;
comp_141=  for (int i = 0; i < 10; i++) {
comp_142=    p = abs(p + c) - abs(p - c) - p;
comp_143=    p/= clamp(dot(p, p), .0, 1.);
comp_144=    p = p* -1.5 + c;
comp_145=    if ( mod_conv(float(i), 2.) < 1. ) {
comp_146=      float pl = l;
comp_147=      l = lenv3(p);
comp_148=      es+= exp(-1. / max(abs(l - pl), 1e-6));
comp_149=    }
comp_150=
comp_151=  }
comp_152=
comp_153=  return es;
comp_154=}
comp_155=
comp_156=float3 light(in float3 p, in float3 dir, in float3 n, in float hid) {
comp_157=// PASSING IN THE NORMAL
comp_158=#ifdef ENABLE_HARD_SHADOWS
comp_159=float sh=shadow(p, lightdir);
comp_160=#else
comp_161=float sh=calcAO(p,-2.5*lightdir);
comp_162=// USING AO TO MAKE VERY SOFT SHADOWS
comp_163=#endif
comp_164=float ao=calcAO(p,n);
comp_165=float diff=max(0.,dot(lightdir,-n))*sh;
comp_166=float y=3.35-p.y;
comp_167=float3 amb=max(.5,dot(dir,-n))*.5*AMBIENT_COLOR;
comp_168=if (hid<.5) {
comp_169=  amb+=max(0.2,dot(float3(0.,1.,0.),-n))*FLOOR_COLOR*pow(max(0.,.2-abs(3.-p.y))/.2,1.5)*2.;
comp_170=  amb+=energy*pow(max(0.,.4-abs(y))/.4,2.)*max(0.2,dot(float3(0.,-sign(y),0.),-n))*2.;
comp_171=}
comp_172=
comp_173=float3 r = reflect(lightdir,n);
comp_174=float spec=pow(max(0.,dot(dir,-r))*sh,10.);
comp_175=float3 col;
comp_176=float energysource=pow(max(0.,.04-abs(y))/.04,4.)*2.;
comp_177=if (hid>1.5) {col=float3(1., 1., 1.); spec=spec*spec;}
comp_178=else{
comp_179=  float k=_tex2D(p)*.23+.2;
comp_180=  k=min(k,1.5-energysource);
comp_181=  col=lerp(float3(k,k*k,k*k*k),float3(k, k, k),.3);
comp_182=  if (abs(hid-1.)<.001) col*=FLOOR_COLOR*1.3;
comp_183=}
comp_184=
comp_185=col=col*(amb+diff*LIGHT_COLOR)+spec*LIGHT_COLOR;
comp_186=if (hid<.5) {
comp_187=  col=max(col,energy*2.*energysource);
comp_188=}
comp_189=
comp_190=col*=min(1.,ao+length(energy)*.5*max(0.,.1-abs(y))/.1);
comp_191=return col;
comp_192=}
comp_193=
comp_194=float3 raymarch(in float3 from, in float3 dir)
comp_195=
comp_196={
comp_197=  float ey=mod_conv(t*.5,1.);
comp_198=  float glow,eglow,ref,sphdist,totdist=glow=eglow=ref=sphdist=0.;
comp_199=  float2 d=float2(1.,0.);
comp_200=  float3 p, col=float3(0., 0., 0.);
comp_201=  float3 origdir=dir,origfrom=from,sphNorm;
comp_202=
comp_203=  float3 wob=cos(dir*500.0*lenv3(from-pth1)+(from-pth1)*250.+time*10.)*0.0005;
comp_204=  float t1=Sphere(from-pth1+wob,dir,0.015);
comp_205=  float tg=Sphere(from-pth1+wob,dir,0.02);
comp_206=  if(t1>0.){
comp_207=    ref=1.0;from+=t1*dir;sphdist=t1;
comp_208=    sphNorm=normalize(from-pth1+wob);
comp_209=    dir=reflect(dir,sphNorm);
comp_210=  }
comp_211=
comp_212=  else if (tg>0.) {
comp_213=    float3 sphglowNorm=normalize(from+tg*dir-pth1+wob);
comp_214=    glow+=pow(max(0.,dot(sphglowNorm,-dir)),5.);
comp_215=    };
comp_216=
comp_217=    for (int i=min(frame,0); i<RAY_STEPS; i++) {
comp_218=      if (d.x>det && totdist<3.0) {
comp_219=        p=from+totdist*dir;
comp_220=        d=de(p);
comp_221=        det=detail*(1.+totdist*60.)*(1.+ref*5.);
comp_222=        totdist+=d.x;
comp_223=        energy=ENERGY_COLOR*(1.5+sin(time*20.+p.z*10.))*.25;
comp_224=        if(d.x<0.015)glow+=max(0.,.015-d.x)*exp(-totdist);
comp_225=        if (d.y<.5 && d.x<0.03){
comp_226=        // ONLY DOING THE GLOW WHEN IT IS CLOSE ENOUGH
comp_227=        float glw=min(abs(3.35-p.y-ey),abs(3.35-p.y+ey));
comp_228=        // 2 glows at once
comp_229=        eglow+=max(0.,.03-d.x)/.03*
comp_230=        (pow(max(0.,.05-glw)/.05,5.)
comp_231=        +pow(max(0.,.15-abs(3.35-p.y))/.15,8.))*1.5;
comp_232=      }
comp_233=
comp_234=    }
comp_235=
comp_236=  }
comp_237=
comp_238=  float l=pow(max(0.,dot(normalize(-dir.xz),normalize(lightdir.xz))),2.);
comp_239=  l*=max(0.2,dot(-dir,lightdir));
comp_240=  float3 backg=.5*(1.2-l)+LIGHT_COLOR*l*.7;
comp_241=  backg*=AMBIENT_COLOR;
comp_242=  if (d.x<=det) {
comp_243=    float3 norm=normal(p-abs(d.x-det)*dir);
comp_244=    // DO THE NORMAL CALC OUTSIDE OF LIGHTING (since we already have the sphere normal)
comp_245=    col=light(p-abs(d.x-det)*dir, dir, norm, d.y)*exp(-.2*totdist*totdist);
comp_246=    col = lerp(col, backg, 1.0-exp(-1.*pow(totdist,1.5)));
comp_247=  }
comp_248=
comp_249=  else {
comp_250=    col=backg;
comp_251=  }
comp_252=
comp_253=  float3 lglow=LIGHT_COLOR*pow(l,30.)*.5;
comp_254=  col+=glow*(backg+lglow)*1.3;
comp_255=  col+=pow(eglow,2.)*energy*.015;
comp_256=  col+=lglow*min(1.,totdist*totdist*.3);
comp_257=  if (ref>0.5) {
comp_258=    float3 sphlight=light(origfrom+sphdist*origdir,origdir,sphNorm,2.);
comp_259=    col=lerp(col*.3+sphlight*.7,backg,1.0-exp(-1.*pow(sphdist,1.5)));
comp_260=  }
comp_261=
comp_262=  return col;
comp_263=}
comp_264=
comp_265=float3 move(inout float2x2 rotview1,inout float2x2 rotview2) {
comp_266=  float3 go=path(t);
comp_267=  float3 adv=path(t+.7);
comp_268=  float3 advec=normalize(adv-go);
comp_269=  float an=atan2(advec.x,advec.z);
comp_270=  rotview1=float2x2(cos(an),sin(an),-sin(an),cos(an));
comp_271=  an=advec.y*1.7;
comp_272=  rotview2=float2x2(cos(an),sin(an),-sin(an),cos(an));
comp_273=  return go;
comp_274=}
comp_275=
comp_276=// AUDIO/LOOK: saturation as if the Remote's "Saturation" control were 0.4 (baked in at request).
comp_277=// Same math as shiftHSV() in include.fx, with hue and brightness left alone.
comp_278=float3 saturate40(float3 c) {
comp_279=  float4 mwK = float4(0, -1.0/3.0, 2.0/3.0, -1);
comp_280=  float4 mwP = lerp(float4(c.bg, mwK.wz), float4(c.gb, mwK.xy), step(c.b, c.g));
comp_281=  float4 mwQ = lerp(float4(mwP.xyw, c.r), float4(c.r, mwP.yzx), step(mwP.x, c.r));
comp_282=  float mwD = mwQ.x - min(mwQ.w, mwQ.y), mwE = 1e-10;
comp_283=  float mwH = frac(abs(mwQ.z + (mwQ.w - mwQ.y) / (6.0*mwD + mwE)));
comp_284=  float mwS = mwD / (mwQ.x + mwE);
comp_285=  float3 mwT = abs(frac(mwH + float3(0, 2.0/3.0, 1.0/3.0)) * 6.0 - 3.0);
comp_286=  return mwQ.x * lerp(float3(1,1,1), saturate(mwT - 1.0), mwS + (1.0 - mwS) * 0.4);
comp_287=}
comp_288=
comp_289=shader_body {
comp_290=  float4 fragColor = 0;
comp_291=  float2 fragCoord  = uv;
comp_292=  // CONV: Center on screen, then try some aspect correction
comp_293=  uv = (uv*2) - 1;
comp_294=  uv *= aspect.xy;
comp_295=  // CONV: Adjust this to flip the output (Â±uv.x, Â±uv.y)
comp_296=  uv = float2(uv.x, -uv.y);
comp_297=  // CONV: Adjust viewpoint (x,y individually or both)
comp_298=  uv += float2(0,0) + 0;
comp_299=  uv *= float2(1,1) * 1;
comp_300=  // AUDIO: 1 = calm (bass_smooth), 2 = more reactive (bass_att), 3+ = static - see the remote's Version tooltip
comp_301=  #ifdef bass_smooth
comp_302=    float aRng = (int)vis_version == 1 ? 0.26 : 0.45;
comp_303=    float aFac = (int)vis_version > 2 ? 1*vis_intensity+vis_shift
comp_304=      : (1.0 - aRng*0.5 + smoothstep(0,2,(int)vis_version == 1 ? bass_smooth : bass_att)*aRng) * vis_intensity + vis_shift;
comp_305=  #else
comp_306=    float aFac = (1.0 - 0.15) + smoothstep(0,2,bass_att)*0.30;
comp_307=  #endif
comp_308=  float aDev = aFac - 1.0;   // 0 at the track average, +loud, -quiet
comp_309=  float aBe  = aDev * 4.0, aCol = (int)vis_version == 1 ? 0.7 : 1.3;   // beat scale, colour reaction scale
comp_310=  // AUDIO: the camera eases forward on the level
comp_311=  uv *= 1.0 - aDev * 0.6;
comp_312=
comp_313=  pth1 = path(t+.3)+origin+float3(0.,.01,0.);
comp_314=  // float2 uv = fragCoord.xy / uv.xy*2.-1.;
comp_315=  float2 uv2=uv;
comp_316=  #ifdef ENABLE_POSTPROCESS
comp_317=  uv*=1.+pow(lenv2(uv2*uv2*uv2*uv2),4.)*.07;
comp_318=  #endif
comp_319=  // CONV: aspect correction is already done by the prologue (was applied twice)
comp_320=  float2 mpos=(mouse.xy-.5)*3.;
comp_321=  if (mouse_clicked<1.) mpos=float2(0., 0.);
comp_322=  float2x2 rotview1 = float2x2(1,0,0,1), rotview2 = float2x2(1,0,0,1);
comp_323=  float3 from=origin+move(rotview1,rotview2);
comp_324=  float3 dir=normalize(float3(uv*.8,1.));
comp_325=  dir.yz = mul(dir.yz, transpose(rot(mpos.y)));
comp_326=  dir.xz = mul(dir.xz, transpose(rot(mpos.x)));
comp_327=  dir.yz = mul(dir.yz, transpose(rotview2));
comp_328=  dir.xz = mul(dir.xz, transpose(rotview1));
comp_329=  float3 color=raymarch(from,dir);
comp_330=  color=clamp(color,float3(.0, .0, .0),float3(1., 1., 1.));
comp_331=  color=pow(color,float3(GAMMA, GAMMA, GAMMA))*BRIGHTNESS;
comp_332=  float clen=lenv3(color);
comp_333=color=lerp(float3(clen, clen, clen),color,SATURATION);
comp_334=  // (the baked saturation is applied at the very end, like the engine's own shift)
comp_335=  #ifdef ENABLE_POSTPROCESS
comp_336=  float3 rain=pow(tex2D(iChannel0,uv2+time*7.25468).rgb,float3(1.5, 1.5, 1.5));
comp_337=  // noise intro removed on request (scene is visible from the first frame)
comp_338=  // vignette removed on request
comp_339=  uv2.y *= texsize.y / 360.0;
comp_340=  color.r*=(.5+abs(.5-mod_conv(uv2.y     ,.021)/.021)*.5)*1.5;
comp_341=  color.g*=(.5+abs(.5-mod_conv(uv2.y+.007,.021)/.021)*.5)*1.5;
comp_342=  color.b*=(.5+abs(.5-mod_conv(uv2.y+.014,.021)/.021)*.5)*1.5;
comp_343=  color*=.9+rain*.35;
comp_344=  #endif
comp_345=  fragColor = float4(color,1.);
comp_346=  ret = fragColor;
comp_347=  // AUDIO: the scenery gains colour on beats
comp_348=  ret = saturate40(lerp(float3(lum(ret), lum(ret), lum(ret)), ret, 1.0 + aBe * 0.7 * aCol));   // default saturation = the 0.4 setting
comp_349=}
comp_350=
