MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// Kali - Star Nest / https://www.shadertoy.com/view/XlfGRj
comp_2=// License: MIT
comp_3=// Transpiled to HLSL using Milkwave
comp_4=
comp_5=#define tx (sin(time)*0.5+1)
comp_6=
comp_7=// CONV: adding helper functions
comp_8=float mod_conv(float x, float y) { return x - y * floor(x / y); }
comp_9=float2 mod_conv(float2 x, float2 y) { return x - y * floor(x / y); }
comp_10=float3 mod_conv(float3 x, float3 y) { return x - y * floor(x / y); }
comp_11=float4 mod_conv(float4 x, float4 y) { return x - y * floor(x / y); }
comp_12=
comp_13=#define iterations 17
comp_14=#define formuparam 0.53
comp_15=
comp_16=#define volsteps 20
comp_17=#define stepsize 0.1
comp_18=
comp_19=#define zoom   0.800
comp_20=#define tile   0.850
comp_21=#define speed  0.010
comp_22=
comp_23=#define brightness 0.0015
comp_24=#define darkmatter 0.300
comp_25=#define distfading 0.730
comp_26=#define saturation 0.850
comp_27=
comp_28=shader_body {
comp_29=  float4 fragColor = 0;
comp_30=  float2 fragCoord  = uv;
comp_31=  // CONV: Center on screen, then try some aspect correction
comp_32=  uv = (uv*2) - 1;
comp_33=  uv *= aspect.xy;
comp_34=  // CONV: Adjust this to flip the output (Â±uv.x, Â±uv.y)
comp_35=  uv = float2(uv.x, -uv.y);
comp_36=  // CONV: Adjust viewpoint (x,y individually or both)
comp_37=  uv += float2(0,0) + 0;
comp_38=  uv *= float2(1,1) * 1;
comp_39=  // AUDIO: version 1 = slow (bass_smooth), 2 = fast (bass_att), >2 = off - see the remote's Version tooltip
comp_40=  #ifdef bass_smooth
comp_41=    float aRng = (int)vis_version == 1 ? 0.30 : 0.45;
comp_42=    float aFac = (int)vis_version > 2 ? 1*vis_intensity+vis_shift
comp_43=      : (1.0 - aRng*0.5 + smoothstep(0,2,(int)vis_version == 1 ? bass_smooth : bass_att)*aRng) * vis_intensity + vis_shift;
comp_44=  #else
comp_45=    float aFac = (1.0 - 0.15) + smoothstep(0,2,bass_att)*0.30;
comp_46=  #endif
comp_47=  float aDev = aFac - 1.0;   // 0 at the track average, +loud, -quiet
comp_48=  float aBe  = aDev * 4.0;   // beat scale used by the colour reaction
comp_49=  // AUDIO: the nebula rolls very slowly with the level
comp_50=  float aAng = aDev * 0.7;
comp_51=  uv = float2(uv.x*cos(aAng) - uv.y*sin(aAng), uv.x*sin(aAng) + uv.y*cos(aAng));
comp_52=
comp_53=  // get coords and direction
comp_54=  // original fragment uv line removed (iResolution->uv mangled it); CONV uv is equivalent up to scale
comp_55=  // original aspect line removed (CONV header already applies aspect)
comp_56=  float3 dir=float3(uv*zoom,1.);
comp_57=  float time_conv=time*speed+.25;
comp_58=
comp_59=  // mouse rotation
comp_60=  float a1=.5+mouse.x*0.4;
comp_61=  float a2=.8+mouse.y*0.4;
comp_62=  float2x2 rot1=float2x2(cos(a1),sin(a1),-sin(a1),cos(a1));
comp_63=  float2x2 rot2=float2x2(cos(a2),sin(a2),-sin(a2),cos(a2));
comp_64=  dir.xz = mul(dir.xz, transpose(rot1));
comp_65=  dir.xy = mul(dir.xy, transpose(rot2));
comp_66=  float3 from=float3(1.,.5,0.5);
comp_67=  from+=float3(time_conv*2.,time_conv,-2.);
comp_68=  from.xz = mul(from.xz, transpose(rot1));
comp_69=  from.xy = mul(from.xy, transpose(rot2));
comp_70=
comp_71=  // volumetric rendering
comp_72=  float s=0.1,fade=1.;
comp_73=  float3 v=float3(0., 0., 0.);
comp_74=  for (int r=0; r<volsteps; r++) {
comp_75=    float3 p=from+s*dir*.5;
comp_76=    p = abs(float3(tile,tile,tile)-mod_conv(p,float3(tile*2.,tile*2.,tile*2.)));
comp_77=    // tiling fold
comp_78=    float pa,a=pa=0.;
comp_79=    for (int i=0; i<iterations; i++) {
comp_80=      p=abs(p)/max(dot(p,p), 1e-6)-formuparam;
comp_81=      // the magic formula
comp_82=      a+=abs(length(p)-pa);
comp_83=      // absolute sum of average change
comp_84=      pa=length(p);
comp_85=    }
comp_86=
comp_87=    float dm=max(0.,darkmatter-a*a*.001);
comp_88=    // dark matter
comp_89=    a*=a*a;
comp_90=    // add contrast
comp_91=    if (r>6) fade*=1.-dm;
comp_92=    // dark matter, don't render near
comp_93=    // v+=float3(dm,dm*.5,0.);
comp_94=    v+=fade;
comp_95=    v+=float3(s,s*s,s*s*s*s)*a*brightness*fade;
comp_96=    // coloring based on distance
comp_97=    fade*=distfading;
comp_98=    // distance fading
comp_99=    s+=stepsize;
comp_100=  }
comp_101=
comp_102=  v=lerp(float3(length(v), length(v), length(v)),v,saturation);
comp_103=  // color adjust
comp_104=  fragColor = float4(v*.01,1.);
comp_105=
comp_106=  ret = fragColor;
comp_107=  // AUDIO: a faint twinkle on beats (kept low - it reads as noise)
comp_108=  ret += saturate(ret * 8.0) * 0.05 * saturate(aBe);
comp_109=}
comp_110=
