MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// Kali - Star Nest / https://www.shadertoy.com/view/XlfGRj
comp_2=// License: MIT
comp_3=// Transpiled to HLSL using Milkwave
comp_4=
comp_5=#define tx (sin(time)*0.5+1)
comp_6=
comp_7=// CONV: adding helper functions
comp_8=float mod_conv(float x, float y) { return x - y * floor(x / y); }
comp_9=float2 mod_conv(float2 x, float2 y) { return x - y * floor(x / y); }
comp_10=float3 mod_conv(float3 x, float3 y) { return x - y * floor(x / y); }
comp_11=float4 mod_conv(float4 x, float4 y) { return x - y * floor(x / y); }
comp_12=
comp_13=#define iterations 17
comp_14=#define formuparam 0.53
comp_15=
comp_16=#define volsteps 20
comp_17=#define stepsize 0.1
comp_18=
comp_19=#define zoom   0.800
comp_20=#define tile   0.850
comp_21=#define speed  0.010
comp_22=
comp_23=#define brightness 0.0015
comp_24=#define darkmatter 0.300
comp_25=#define distfading 0.730
comp_26=#define saturation 0.850
comp_27=
comp_28=shader_body {
comp_29=  float4 fragColor = 0;
comp_30=  float2 fragCoord  = uv;
comp_31=  // CONV: Center on screen, then try some aspect correction
comp_32=  uv = (uv*2) - 1;
comp_33=  uv *= aspect.xy;
comp_34=  // CONV: Adjust this to flip the output (Â±uv.x, Â±uv.y)
comp_35=  uv = float2(uv.x, -uv.y);
comp_36=  // CONV: Adjust viewpoint (x,y individually or both)
comp_37=  uv += float2(0,0) + 0;
comp_38=  uv *= float2(1,1) * 1;
comp_39=
comp_40=  // get coords and direction
comp_41=  // original fragment uv line removed (iResolution->uv mangled it); CONV uv is equivalent up to scale
comp_42=  // original aspect line removed (CONV header already applies aspect)
comp_43=  float3 dir=float3(uv*zoom,1.);
comp_44=  float time_conv=time*speed+.25;
comp_45=
comp_46=  // mouse rotation
comp_47=  float a1=.5+mouse.x*2.;
comp_48=  float a2=.8+mouse.y*2.;
comp_49=  float2x2 rot1=float2x2(cos(a1),sin(a1),-sin(a1),cos(a1));
comp_50=  float2x2 rot2=float2x2(cos(a2),sin(a2),-sin(a2),cos(a2));
comp_51=  dir.xz = mul(dir.xz, transpose(rot1));
comp_52=  dir.xy = mul(dir.xy, transpose(rot2));
comp_53=  float3 from=float3(1.,.5,0.5);
comp_54=  from+=float3(time_conv*2.,time_conv,-2.);
comp_55=  from.xz = mul(from.xz, transpose(rot1));
comp_56=  from.xy = mul(from.xy, transpose(rot2));
comp_57=
comp_58=  // volumetric rendering
comp_59=  float s=0.1,fade=1.;
comp_60=  float3 v=float3(0., 0., 0.);
comp_61=  for (int r=0; r<volsteps; r++) {
comp_62=    float3 p=from+s*dir*.5;
comp_63=    p = abs(float3(tile,tile,tile)-mod_conv(p,float3(tile*2.,tile*2.,tile*2.)));
comp_64=    // tiling fold
comp_65=    float pa,a=pa=0.;
comp_66=    for (int i=0; i<iterations; i++) {
comp_67=      p=abs(p)/max(dot(p,p), 1e-6)-formuparam;
comp_68=      // the magic formula
comp_69=      a+=abs(length(p)-pa);
comp_70=      // absolute sum of average change
comp_71=      pa=length(p);
comp_72=    }
comp_73=
comp_74=    float dm=max(0.,darkmatter-a*a*.001);
comp_75=    // dark matter
comp_76=    a*=a*a;
comp_77=    // add contrast
comp_78=    if (r>6) fade*=1.-dm;
comp_79=    // dark matter, don't render near
comp_80=    // v+=float3(dm,dm*.5,0.);
comp_81=    v+=fade;
comp_82=    v+=float3(s,s*s,s*s*s*s)*a*brightness*fade;
comp_83=    // coloring based on distance
comp_84=    fade*=distfading;
comp_85=    // distance fading
comp_86=    s+=stepsize;
comp_87=  }
comp_88=
comp_89=  v=lerp(float3(length(v), length(v), length(v)),v,saturation);
comp_90=  // color adjust
comp_91=  fragColor = float4(v*.01,1.);
comp_92=
comp_93=  ret = fragColor;
comp_94=}
