MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// zackpudil - Muddy Cavern / https://www.shadertoy.com/view/4sKSzR
comp_2=// License: Creative Commons Attribution-NonCommercial-ShareAlike 3.0 (Shadertoy default)
comp_3=// Transpiled to HLSL using Milkwave
comp_4=
comp_5=#define tx (sin(time)*0.5+1)
comp_6=
comp_7=// CONV2: guarded length helpers (legacy compiler reports lenv() as division by zero)
comp_8=float lenv(float2 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_9=float lenv(float3 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_10=
comp_11=float hash(float n) {
comp_12=  return frac(sin(n)*43578.4545);
comp_13=}
comp_14=
comp_15=float noise(float3 x) {
comp_16=  float3 p = floor(x);
comp_17=  float3 f = frac(x);
comp_18=
comp_19=  f = f*f*(3.0 - 2.0*f);
comp_20=
comp_21=  float n = p.x + p.y*57.0 + p.z*113.0;
comp_22=
comp_23=  return lerp(
comp_24=  lerp(
comp_25=  lerp(hash(n + 000.0), hash(n + 001.0), f.x),
comp_26=  lerp(hash(n + 057.0), hash(n + 058.0), f.x),
comp_27=  f.y),
comp_28=  lerp(
comp_29=  lerp(hash(n + 113.0), hash(n + 114.0), f.x),
comp_30=  lerp(hash(n + 170.0), hash(n + 171.0), f.x),
comp_31=  f.y),
comp_32=  f.z);
comp_33=}
comp_34=
comp_35=float fbm(float3 p) {
comp_36=  float f = 0.0;
comp_37=
comp_38=  f += 0.500*noise(p); p *= 2.01;
comp_39=  f += 0.250*noise(p); p *= 2.04;
comp_40=  f += 0.125*noise(p);
comp_41=
comp_42=  f /= 0.875;
comp_43=  return f;
comp_44=}
comp_45=
comp_46=float2 path(float z) {
comp_47=  return float2(sin(0.5*z), 2.0*cos(0.12*z));
comp_48=}
comp_49=
comp_50=float3 camPath() {
comp_51=  float3 ro = float3(0, 0, 2.0*time);
comp_52=  ro.xy = path(ro.z);
comp_53=
comp_54=  return ro;
comp_55=}
comp_56=
comp_57=float3 lookat(float3 ro) {
comp_58=  float3 la = ro + float3(0, 0, 1);
comp_59=  la.xy = path(la.z);
comp_60=
comp_61=  return la;
comp_62=}
comp_63=
comp_64=float3 lightPath(float3 la) {
comp_65=  float3 lp = la;
comp_66=  lp.xy += 0.2*float2(sin(time), cos(time));
comp_67=
comp_68=  return lp;
comp_69=}
comp_70=
comp_71=float map(float3 p) {
comp_72=  float r = 0.6*smoothstep(0.3, 1.0, noise(1.5*p));
comp_73=  float f = 0.1*smoothstep(0.0, 1.0, fbm(6.0*p + 3.0*float3(0, time, 0)));
comp_74=
comp_75=  float l = lenv(p - lightPath(lookat(camPath()))) - 0.01;
comp_76=  float2 tun = abs(p.xy - path(p.z))*float2(.6, 3);
comp_77=  float t = 1.0 - max(tun.x, tun.y);
comp_78=  return min(l, t - (r + f));
comp_79=}
comp_80=
comp_81=float march(float3 ro, float3 rd) {
comp_82=  float t = 0.0;
comp_83=
comp_84=  for (int i=min(frame,0); i < 150; i++) {
comp_85=    float h = map(ro + rd*t);
comp_86=    // CONV: replaced break with breaking condition
comp_87=    if(abs(h) < 0.0001 || t >= 30.0)  i = 150;
comp_88=    t += h*0.5;
comp_89=  }
comp_90=
comp_91=  return t;
comp_92=}
comp_93=
comp_94=float3 normal(float3 p) {
comp_95=  float2 h = float2(0.01, 0.0);
comp_96=
comp_97=  float3 n = float3(
comp_98=  map(p + h.xyy) - map(p - h.xyy),
comp_99=  map(p + h.yxy) - map(p - h.yxy),
comp_100=  map(p + h.yyx) - map(p - h.yyx)
comp_101=  );
comp_102=
comp_103=  return normalize(n);
comp_104=}
comp_105=
comp_106=float3x3 camera(float3 e, float3 l) {
comp_107=  float3 f = normalize(l - e);
comp_108=  float3 r = normalize(cross(float3(0, 1, 0), f));
comp_109=  float3 u = normalize(cross(f, r));
comp_110=
comp_111=  return float3x3(r, u, f);
comp_112=}
comp_113=
comp_114=shader_body {
comp_115=  float4 fragColor = 0;
comp_116=  float2 fragCoord  = uv;
comp_117=  // CONV: Center on screen, then try some aspect correction
comp_118=  uv = (uv*2) - 1;
comp_119=  uv *= aspect.xy;
comp_120=  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_121=  uv = float2(uv.x, -uv.y);
comp_122=  // CONV: Adjust viewpoint (x,y individually or both)
comp_123=  uv += float2(0,0) + 0;
comp_124=  uv *= float2(1,1) * 1;
comp_125=
comp_126=  // float2 uv = (-1.0 + 2.0*(fragCoord.xy/uv.xy))*float2(uv.x/uv.y, 1.0);
comp_127=
comp_128=  float3 ro = camPath();
comp_129=
comp_130=  float3 la = lookat(ro);
comp_131=
comp_132=  float3 rd = mul(transpose(camera(ro, la)), normalize(float3(uv, 1.97)));
comp_133=
comp_134=  float3 col = float3(0, 0, 0);
comp_135=
comp_136=  float i = march(ro, rd);
comp_137=
comp_138=  if(i < 30.0) {
comp_139=    float3 pos = ro + rd*i;
comp_140=    float3 nor = normal(pos);
comp_141=
comp_142=    float3 rig = lightPath(la);
comp_143=    float3 lig = normalize(rig - pos);
comp_144=    float3 ref = reflect(rd, nor);
comp_145=
comp_146=    float dis = max(lenv(pos - rig), 0.001);
comp_147=    if(dis <= 0.015) {
comp_148=      col = float3(1, 1, 1);
comp_149=    }
comp_150=
comp_151=    else {
comp_152=      float att = 1.0/(1.0 + 1.5*dis + 2.0*dis*dis);
comp_153=
comp_154=      float dif = clamp(dot(lig, nor), 0.0, 1.0);
comp_155=      float spe = pow(clamp(dot(lig, ref), 0.0, 1.0), 32.0);
comp_156=
comp_157=      col =  0.7*dif*float3(1, 1, 1);
comp_158=      col *= float3(0.8, 0.6, 0.2);
comp_159=      col += spe*float3(1, 1, 1)*dif;
comp_160=
comp_161=      col *= att;
comp_162=    }
comp_163=
comp_164=  }
comp_165=
comp_166=  col = pow(col, float3(.4545, .4545, .4545));
comp_167=
comp_168=  fragColor = float4(col, 1);
comp_169=  ret = fragColor;
comp_170=}
