MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// ADOB - Waves Remix / https://www.shadertoy.com/view/4ljGD1
comp_2=// License: Creative Commons Attribution-NonCommercial-ShareAlike 3.0 (Shadertoy default)
comp_3=// Transpiled to HLSL using Milkwave
comp_4=
comp_5=#define tx (sin(time)*0.5+1)
comp_6=
comp_7=// CONV: setting iChannel samplers to default noise texture
comp_8=#define iChannel0 sampler_noise_lq
comp_9=
comp_10=// CONV: adding helper functions
comp_11=float mod_conv(float x, float y) { return x - y * floor(x / y); }
comp_12=float2 mod_conv(float2 x, float2 y) { return x - y * floor(x / y); }
comp_13=float3 mod_conv(float3 x, float3 y) { return x - y * floor(x / y); }
comp_14=float4 mod_conv(float4 x, float4 y) { return x - y * floor(x / y); }
comp_15=
comp_16=// CONV2: guarded length helpers (legacy compiler reports lenv() as division by zero)
comp_17=float lenv(float2 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_18=float lenv(float3 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_19=float lenv(float4 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_20=
comp_21=float squared(float value) { return value * value; }
comp_22=
comp_23=float getAmp(float frequency) { return tex2D(iChannel0, float2(frequency / 512.0, 0)).x; }
comp_24=
comp_25=float getWeight(float f) {
comp_26=  return (+ getAmp(f-2.0) + getAmp(f-1.0) + getAmp(f+2.0) + getAmp(f+1.0) + getAmp(f)) / 5.0; }
comp_27=
comp_28=  shader_body {
comp_29=    float4 fragColor = 0;
comp_30=    float2 fragCoord  = uv;
comp_31=    // CONV: Center on screen, then try some aspect correction
comp_32=    uv = (uv*2) - 1;
comp_33=    uv *= aspect.xy;
comp_34=    // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_35=    uv = float2(uv.x, -uv.y);
comp_36=    // CONV: Adjust viewpoint (x,y individually or both)
comp_37=    uv += float2(0,0) + 0;
comp_38=    uv *= float2(1,1) * 1;
comp_39=
comp_40=    float2 uvTrue = fragCoord.xy / texsize.xy;
comp_41=    // float2 uv = -1.0 + 2.0 * uvTrue;
comp_42=
comp_43=    float lineIntensity;
comp_44=    float glowWidth;
comp_45=    float3 color = float3(0.0, 0.0, 0.0);
comp_46=
comp_47=    for(float i = 0.0; i < 5.0; i++) {
comp_48=
comp_49=      uv.y += (0.2 * sin(uv.x + i/7.0 - time * 0.6));
comp_50=      float Y = uv.y + getWeight(squared(i) * 20.0) *
comp_51=      (tex2D(iChannel0, float2(uvTrue.x, 1)).x - 0.5);
comp_52=      lineIntensity = 0.4 + squared(1.6 * abs(mod_conv(uvTrue.x + i / 1.3 + time,2.0) - 1.0));
comp_53=      glowWidth = abs(lineIntensity / (150.0 * Y));
comp_54=      color += float3(glowWidth * (2.0 + sin(time * 0.13)),
comp_55=      glowWidth * (2.0 - sin(time * 0.23)),
comp_56=      glowWidth * (2.0 - cos(time * 0.19)));
comp_57=    }
comp_58=
comp_59=    fragColor = float4(color, 1.0);
comp_60=    ret = fragColor;
comp_61=  }
