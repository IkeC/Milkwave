MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// ADOB - Waves Remix / https://www.shadertoy.com/view/4ljGD1
comp_2=// License: Creative Commons Attribution-NonCommercial-ShareAlike 3.0 (Shadertoy default)
comp_3=// Transpiled to HLSL using Milkwave
comp_4=
comp_5=#define tx (sin(time)*0.5+1)
comp_6=
comp_7=// CONV: setting iChannel samplers to default noise texture
comp_8=#define iChannel0 sampler_noise_lq
comp_9=
comp_10=// CONV: adding helper functions
comp_11=float mod_conv(float x, float y) { return x - y * floor(x / y); }
comp_12=float2 mod_conv(float2 x, float2 y) { return x - y * floor(x / y); }
comp_13=float3 mod_conv(float3 x, float3 y) { return x - y * floor(x / y); }
comp_14=float4 mod_conv(float4 x, float4 y) { return x - y * floor(x / y); }
comp_15=
comp_16=// CONV2: guarded length helpers (legacy compiler reports lenv() as division by zero)
comp_17=float lenv(float2 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_18=float lenv(float3 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_19=float lenv(float4 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_20=
comp_21=float squared(float value) { return value * value; }
comp_22=
comp_23=float getAmp(float frequency) {
comp_24=  // AUDIO: version 1 reads the smoothed music spectrum, version 2 the peak-hold one, version > 2 the original noise
comp_25=  float aNoise = tex2D(iChannel0, float2(frequency / 512.0, 0)).x;
comp_26=  return (int)vis_version > 2 ? aNoise : lerp(aNoise, (int)vis_version == 1 ? get_fft_hz(frequency) : get_fft_peak_hz(frequency), saturate(vis_intensity));
comp_27=}
comp_28=
comp_29=float getWeight(float f) {
comp_30=  return (+ getAmp(f-2.0) + getAmp(f-1.0) + getAmp(f+2.0) + getAmp(f+1.0) + getAmp(f)) / 5.0; }
comp_31=
comp_32=  shader_body {
comp_33=    float4 fragColor = 0;
comp_34=    float2 fragCoord  = uv;
comp_35=    // CONV: Center on screen, then try some aspect correction
comp_36=    uv = (uv*2) - 1;
comp_37=    uv *= aspect.xy;
comp_38=    // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_39=    uv = float2(uv.x, -uv.y);
comp_40=    // CONV: Adjust viewpoint (x,y individually or both)
comp_41=    uv += float2(0,0) + 0;
comp_42=    uv *= float2(1,1) * 1;
comp_43=    // AUDIO: version 1 = slow (bass_smooth), 2 = fast (bass_att), >2 = off - see the remote's Version tooltip
comp_44=    #ifdef bass_smooth
comp_45=      float aRng = (int)vis_version == 1 ? 0.30 : 0.45;
comp_46=      float aFac = (int)vis_version > 2 ? 1*vis_intensity+vis_shift
comp_47=        : (1.0 - aRng*0.5 + smoothstep(0,2,(int)vis_version == 1 ? bass_smooth : bass_att)*aRng) * vis_intensity + vis_shift;
comp_48=    #else
comp_49=      float aFac = (1.0 - 0.15) + smoothstep(0,2,bass_att)*0.30;
comp_50=    #endif
comp_51=    float aDev = aFac - 1.0;   // 0 at the track average, +loud, -quiet
comp_52=    float aBe  = aDev * 4.0;   // beat scale used by the colour reaction
comp_53=    // AUDIO: the wave displacement follows the music spectrum instead of the noise texture (see getAmp)
comp_54=
comp_55=    float2 uvTrue = fragCoord.xy / texsize.xy;
comp_56=    // float2 uv = -1.0 + 2.0 * uvTrue;
comp_57=
comp_58=    float lineIntensity;
comp_59=    float glowWidth;
comp_60=    float3 color = float3(0.0, 0.0, 0.0);
comp_61=
comp_62=    for(float i = 0.0; i < 5.0; i++) {
comp_63=
comp_64=      uv.y += (0.2 * sin(uv.x + i/7.0 - time * 0.6));
comp_65=      float Y = uv.y + getWeight(squared(i) * 20.0) *
comp_66=      (tex2D(iChannel0, float2(uvTrue.x, 1)).x - 0.5);
comp_67=      lineIntensity = 0.4 + squared(1.6 * abs(mod_conv(uvTrue.x + i / 1.3 + time,2.0) - 1.0));
comp_68=      glowWidth = abs(lineIntensity / (150.0 * Y));
comp_69=      color += float3(glowWidth * (2.0 + sin(time * 0.13)),
comp_70=      glowWidth * (2.0 - sin(time * 0.23)),
comp_71=      glowWidth * (2.0 - cos(time * 0.19)));
comp_72=    }
comp_73=
comp_74=    fragColor = float4(color, 1.0);
comp_75=    ret = fragColor;
comp_76=    // AUDIO: the line colours rotate slowly with the level
comp_77=    ret = lerp(ret, ret.zyx, aBe * 0.15);
comp_78=  }
comp_79=
