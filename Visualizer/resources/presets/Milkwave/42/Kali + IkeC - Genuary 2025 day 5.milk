MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// Genuary 2025 day 5 by Kali (Shadertoy X3KcWR) / https://www.shadertoy.com/view/X3KcWR
comp_2=// CC BY-NC-SA 3.0
comp_3=// Transpiled to HLSL using Milkwave
comp_4=
comp_5=#define tx (sin(time)*0.5+1)
comp_6=
comp_7=// CONV: adding helper functions
comp_8=float mod_conv(float x, float y) { return x - y * floor(x / y); }
comp_9=float2 mod_conv(float2 x, float2 y) { return x - y * floor(x / y); }
comp_10=float3 mod_conv(float3 x, float3 y) { return x - y * floor(x / y); }
comp_11=float4 mod_conv(float4 x, float4 y) { return x - y * floor(x / y); }
comp_12=
comp_13=#define samples 3
comp_14=
comp_15=float2x2 rot(float a) {
comp_16=  float c = cos(a);
comp_17=  float s = sin(a);
comp_18=  return float2x2(c, -s, s, c);
comp_19=}
comp_20=
comp_21=static float x, y;
comp_22=float cir1(float2 p) {
comp_23=  x=1000., y=1000.;
comp_24=  for (float i=0.; i<7.; i++) {
comp_25=    p=abs(p)/clamp(p.x*p.y,.3,5.)-1.;
comp_26=    x=min(x,abs(p.x));
comp_27=    y=min(y,abs(p.y));
comp_28=  }
comp_29=
comp_30=  x=exp(-.5*x);
comp_31=  y=exp(-1.*y);
comp_32=  return x-y*.1;
comp_33=}
comp_34=
comp_35=float cir2(float2 p) {
comp_36=  p.x-=1.5;
comp_37=  float x=1000., y=1000.;
comp_38=  for (float i=0.; i<5.; i++) {
comp_39=    p=abs(p)/clamp(abs(p.x*p.y),.2,2.)-1.;
comp_40=    x=min(x,abs(p.x));
comp_41=    y=min(y,abs(p.y));
comp_42=  }
comp_43=
comp_44=  y=exp(-.7*y)-x*.1;
comp_45=  return y;
comp_46=}
comp_47=
comp_48=float struc(float3 p) {
comp_49=  float d=length(p+float3(0.,-3.,0.))+.6;
comp_50=  d=min(d,length(p.xy+float2(0.,-3.))+1.3);
comp_51=  d=min(d,length(p.zy+float2(0.,-3.))+1.5);
comp_52=  float2 s=sign(p.xz);
comp_53=  p.xz=abs(p.xz);
comp_54=  d=min(d,max(length(p.xz-5.-s*.5)+.5+p.y*.2,p.y-2.));
comp_55=  return d;
comp_56=}
comp_57=
comp_58=static float h;
comp_59=float de(float3 p) {
comp_60=  p.yz = mul(p.yz, transpose(rot(.6)));
comp_61=  p.xz = mul(p.xz, transpose(rot(.6)));
comp_62=  p.xy+=time*.7+15.;
comp_63=  p.x+=time*.3+0.;
comp_64=  p.xz=mod_conv(p.xz,float2(16.,16.))-8.;
comp_65=  float r1=cir1(p.xz*.1);
comp_66=  float r2=cir2(p.yz*.02);
comp_67=  float sup = p.y;
comp_68=  float sph = struc(p);
comp_69=  float d = min(sup, sph);
comp_70=  h=r1*.7+r2*1.2;
comp_71=  d-=h;
comp_72=  return d*.5;
comp_73=}
comp_74=
comp_75=static float det = 0.005;
comp_76=
comp_77=float3 normal(float3 p) {
comp_78=  float2 e = float2(0.0, det);
comp_79=  return normalize(float3(de(p + e.yxx), de(p + e.xyx), de(p + e.xxy)) - de(p));
comp_80=}
comp_81=
comp_82=float3 march(float3 from, float3 dir) {
comp_83=  from.xy*=5.;
comp_84=  float3 p = from, col = float3(0.0, 0.0, 0.0);
comp_85=  float d=0.;
comp_86=  for (int i = min(frame,0); i < 100; i++) {
comp_87=    p += d * dir;
comp_88=    d = de(p);
comp_89=    // CONV: replaced break with breaking condition
comp_90=    if (d < det)  i = 100;
comp_91=  }
comp_92=
comp_93=  if (d < det) {
comp_94=    float cx=x,cy=y;
comp_95=    float3 n = normal(p);
comp_96=    float3 ldir = normalize(float3(-1., 1., -1.0));
comp_97=    float dif = smoothstep(.8,1.,max(0., dot(ldir, n)));
comp_98=    dif+=smoothstep(.5,.8,max(0.,dot(-dir,n)))*.35;
comp_99=    col = float3(1.8,1.,.5)*dif;
comp_100=    float shadow = 1.0;
comp_101=    float3 shadowRay = p + n * 0.01;
comp_102=    for (int i = min(frame,0); i < 30; i++) {
comp_103=      float d = de(shadowRay);
comp_104=      if (d < 0.005) {
comp_105=        shadow = 0.0;
comp_106=        // CONV: replaced break with breaking condition
comp_107=        i = 30;
comp_108=      }
comp_109=
comp_110=      shadowRay += ldir * d;
comp_111=    }
comp_112=
comp_113=    col+=step(cx,.87)*float3(0.,1.,1.)*.5;
comp_114=    col*=.3+shadow*.7;
comp_115=    col+=step(frac(cy*3.),.25)*float3(1.,0.3,0.1);
comp_116=  }
comp_117=
comp_118=  return col;
comp_119=}
comp_120=
comp_121=float3 antialiasedMarch(float3 from, float3 dir) {
comp_122=  float3 color = float3(0.0, 0.0, 0.0);
comp_123=  float2 offsetScale = 2./texsize.xy;
comp_124=
comp_125=  for (int i = 0; i < samples; i++) {
comp_126=    for (int j = 0; j < samples; j++) {
comp_127=      float2 offset = float2(float(i), float(j)) / float(samples) - 0.5;
comp_128=      float3 displacedFrom = from + float3(offset* offsetScale, 0.0) ;
comp_129=      color += march(displacedFrom, dir);
comp_130=    }
comp_131=
comp_132=  }
comp_133=
comp_134=  return color / float(samples * samples);
comp_135=}
comp_136=
comp_137=shader_body {
comp_138=  float4 fragColor = 0;
comp_139=  float2 fragCoord = uv;
comp_140=  // CONV: Center on screen, then try some aspect correction
comp_141=  uv = (uv*2) - 1;
comp_142=  uv *= aspect.xy;
comp_143=  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_144=  uv = float2(uv.x, -uv.y);
comp_145=  // CONV: Adjust viewpoint (x,y individually or both)
comp_146=  uv += float2(0,0) + 0;
comp_147=  uv *= float2(1,1) * 1;
comp_148=
comp_149=  // float2 uv = (fragCoord - uv.xy * 0.5) / uv.y;
comp_150=  float3 from = float3(uv, -6.);
comp_151=  float3 dir = normalize(float3(0.,0., 1.));
comp_152=  float3 col = antialiasedMarch(from, dir)+.05;
comp_153=  col*=exp(-3.*length(fragCoord/uv.xy-.5))*1.3+.2;
comp_154=  fragColor = float4(col, 1.0);
comp_155=  ret = fragColor;
comp_156=}
