MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// Another Cloudy Tunnel 2 by aiekick (Shadertoy XlSSzV) / https://www.shadertoy.com/view/XlSSzV
comp_2=// CC BY-NC-SA 3.0
comp_3=// Transpiled to HLSL using Milkwave
comp_4=
comp_5=#define tx (sin(time)*0.5+1)
comp_6=
comp_7=// CONV2: guarded length helpers (legacy compiler reports lenv() as division by zero)
comp_8=float lenv(float2 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_9=float lenv(float3 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_10=
comp_11=// CONV: setting iChannel samplers to default noise texture
comp_12=#define iChannel0 sampler_noise_lq
comp_13=
comp_14=static float t;
comp_15=
comp_16=float cosPath(float3 p, float3 dec){return dec.x * cos(p.z * dec.y + dec.z);}
comp_17=float sinPath(float3 p, float3 dec){return dec.x * sin(p.z * dec.y + dec.z);}
comp_18=
comp_19=float2 getCylinder(float3 p, float2 pos, float r, float3 c, float3 s)
comp_20={
comp_21=  return p.xy - pos - float2(cosPath(p, c), sinPath(p, s));
comp_22=}
comp_23=
comp_24=float hash13c(float3 p)
comp_25={
comp_26=  p = frac(p * 0.3183099 + float3(0.1, 0.2, 0.3));
comp_27=  p *= 17.0;
comp_28=  return frac(p.x * p.y * p.z * (p.x + p.y + p.z));
comp_29=}
comp_30=
comp_31=float pn( in float3 x )
comp_32={
comp_33=  float3 p = floor(x);
comp_34=  float3 f = frac(x);
comp_35=  f = f*f*(3.0-2.0*f);
comp_36=  float n000 = hash13c(p);
comp_37=  float n100 = hash13c(p + float3(1., 0., 0.));
comp_38=  float n010 = hash13c(p + float3(0., 1., 0.));
comp_39=  float n110 = hash13c(p + float3(1., 1., 0.));
comp_40=  float n001 = hash13c(p + float3(0., 0., 1.));
comp_41=  float n101 = hash13c(p + float3(1., 0., 1.));
comp_42=  float n011 = hash13c(p + float3(0., 1., 1.));
comp_43=  float n111 = hash13c(p + float3(1., 1., 1.));
comp_44=  float nx00 = lerp(n000, n100, f.x);
comp_45=  float nx10 = lerp(n010, n110, f.x);
comp_46=  float nx01 = lerp(n001, n101, f.x);
comp_47=  float nx11 = lerp(n011, n111, f.x);
comp_48=  float nxy0 = lerp(nx00, nx10, f.y);
comp_49=  float nxy1 = lerp(nx01, nx11, f.y);
comp_50=  return -1.0 + 2.4 * lerp(nxy0, nxy1, f.z);
comp_51=}
comp_52=
comp_53=float fpn(float3 p)
comp_54={
comp_55=  p += t*5.;
comp_56=  return pn(p*0.02)*1.98 + pn(p*0.02)*0.62 + pn(p*0.09)*0.39;
comp_57=}
comp_58=
comp_59=float map(float3 p)
comp_60={
comp_61=  float pnNoise = fpn(p*13.)*.8;
comp_62=  float path = sinPath(p ,float3(6.2, .33, 0.));
comp_63=  float bottom = p.y + pnNoise;
comp_64=  float cyl = 0.;float2 vecOld;
comp_65=  for (float i=min(frame,0);i<6.;i++)
comp_66=  {
comp_67=    float x = 1. * i;
comp_68=    float y	= .88 + 0.0102*i;
comp_69=    float z	 = -0.02 -0.16*i;
comp_70=    float r = 4.4 + 2.45 * i;
comp_71=    float2 vec = getCylinder(p, float2(path, 3.7 * i), r , float3(x,y,z), float3(z,x,y));
comp_72=    cyl = r - min(lenv(vec), lenv(vecOld));
comp_73=    vecOld = vec;
comp_74=  }
comp_75=
comp_76=  cyl += pnNoise;
comp_77=  cyl = min(cyl, bottom);
comp_78=  return cyl;
comp_79=}
comp_80=
comp_81=float3 cam(float2 uv_conv,  float3 ro, float3 cu, float3 cv)
comp_82={
comp_83=  float3 rov = normalize(cv-ro);
comp_84=  float3 u =  normalize(cross(cu, rov));
comp_85=  float3 v =  normalize(cross(rov, u));
comp_86=  float fov = 3.;
comp_87=  float3 rd = normalize(rov + fov*u*uv_conv.x + fov*v*uv_conv.y);
comp_88=  return rd;
comp_89=}
comp_90=
comp_91=shader_body {
comp_92=  float4 f = 0;
comp_93=  float2 g  = uv;
comp_94=  // CONV: Center on screen, then try some aspect correction
comp_95=  uv = (uv*2) - 1;
comp_96=  uv *= aspect.xy;
comp_97=  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_98=  uv = float2(uv.x, -uv.y);
comp_99=  // CONV: Adjust viewpoint (x,y individually or both)
comp_100=  uv += float2(0,0) + 0;
comp_101=  uv *= float2(1,1) * 1;
comp_102=
comp_103=  t = time*2.5;
comp_104=  f = float4(0,0.15,0.32,1);
comp_105=  float2 si = texsize.xy;
comp_106=  float2 uvn = (2.*(g*texsize.xy) - si)/min(si.x, si.y);
comp_107=  float3 ro = float3(0, 0, 0), p=ro;
comp_108=  ro.y = sin(t*.2)*15.+15.;
comp_109=  ro.x = sin(t*.5)*5.;
comp_110=  ro.z = t*5.;
comp_111=  float3 rd = cam(uvn, p, float3(0,1,0), p + float3(0,0,1));
comp_112=  float s = 1., h = .15, td = 0., d=1.,dd=0., w;
comp_113=  float var = 0.03;
comp_114=  if (mouse.z>0.) var = 0.1*mouse.y;
comp_115=  for (float i=min(frame,0);i<200.;i++)
comp_116=  {
comp_117=    // CONV: replaced break with breaking condition
comp_118=    if(s<0.01||d>500.||td>.95) i=200.;
comp_119=    s = map(p) * (s>0.001?var:.2);
comp_120=    if (s < h)
comp_121=    {
comp_122=      w = (1.-td) * (h-s)*i/200.;
comp_123=      f += w;
comp_124=      td += w;
comp_125=    }
comp_126=
comp_127=    dd += 0.012;
comp_128=    td += 0.005;
comp_129=    s = max(s, 0.05);
comp_130=    d+=s;
comp_131=    p = ro+rd*d;
comp_132=  }
comp_133=
comp_134=  f.rgb = lerp( f.rgb, float3(0,0.15,0.52), 1.0 - exp( -0.001*d*d) )/max(dd, 0.000001);
comp_135=  // fog
comp_136=
comp_137=  // vigneting from iq Shader Mike : https://www.shadertoy.com/view/MsXGWr
comp_138=  float2 q = g;
comp_139=  f.rgb *= 0.5 + 0.5*pow( 16.0*q.x*q.y*(1.0-q.x)*(1.0-q.y), 0.25 );
comp_140=  ret = f;
comp_141=}
