MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// Full Spectrum Cyber by Kali (Shadertoy XcXXzS) / https://www.shadertoy.com/view/XcXXzS
comp_2=// CC BY-NC-SA 3.0
comp_3=// Transpiled to HLSL using Milkwave
comp_4=
comp_5=#define tx (sin(time)*0.5+1)
comp_6=
comp_7=// CONV: adding helper functions
comp_8=float mod_conv(float x, float y) { return x - y * floor(x / y); }
comp_9=float2 mod_conv(float2 x, float2 y) { return x - y * floor(x / y); }
comp_10=float3 mod_conv(float3 x, float3 y) { return x - y * floor(x / y); }
comp_11=float4 mod_conv(float4 x, float4 y) { return x - y * floor(x / y); }
comp_12=
comp_13=static int hexid;
comp_14=float lenv(float3 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_15=static float3 hpos, fpoint, pt;
comp_16=static float tcol, bcol, hitbol, hexpos, fparam=0.;
comp_17=
comp_18=float2x2 rot(float a) {
comp_19=  float s=sin(a),c=cos(a);
comp_20=  return float2x2(c,s,-s,c);
comp_21=}
comp_22=
comp_23=float3 path(float t) {
comp_24=  return float3(sin(t*.3+cos(t*.2)*.5)*4.,cos(t*.2)*3.,t);
comp_25=}
comp_26=
comp_27=float hexagon( in float2 p, in float r )
comp_28={
comp_29=  float3 k = float3(-0.866025404,0.5,0.577350269);
comp_30=  p = abs(p);
comp_31=  p -= 2.0*min(dot(k.xy,p),0.0)*k.xy;
comp_32=  p -= float2(clamp(p.x, -k.z*r, k.z*r), r);
comp_33=  return length(p)*sign(p.y);
comp_34=}
comp_35=
comp_36=float hex(float2 p) {
comp_37=  p.x *= 0.57735*2.0;
comp_38=  p.y+=mod_conv(floor(p.x),2.0)*0.5;
comp_39=  p=abs((mod_conv(p,float2(1.,1.))-0.5));
comp_40=  return abs(max(p.x*1.5 + p.y, p.y*2.0) - 1.0);
comp_41=}
comp_42=
comp_43=float3x3 lookat(float3 dir) {
comp_44=  float3 up=float3(0.,1.,0.);
comp_45=  float3 rt=normalize(cross(dir,up));
comp_46=  return float3x3(rt, cross(rt,dir), dir);
comp_47=}
comp_48=
comp_49=float hash12(float2 p)
comp_50={
comp_51=  p*=1000.;
comp_52=  float3 p3  = frac(float3(p.xyx) * .1031);
comp_53=  p3 += dot(p3, p3.yzx + 33.33);
comp_54=  return frac((p3.x + p3.y) * p3.z);
comp_55=}
comp_56=
comp_57=float sphereLineAB(float3 p, float3 a, float3 b, float srad){
comp_58=
comp_59=  p = normalize(p);
comp_60=  // Normalize p. // Set radius: p /= rad;
comp_61=  return dot(p, cross(a, b))/max(lenv(a - b), 1e-6);
comp_62=
comp_63=}
comp_64=
comp_65=float3 erot(float3 p, float3 ax, float ro) {
comp_66=  return lerp(dot(ax, p)*ax, p, cos(ro)) + sin(ro)*cross(ax, p);
comp_67=}
comp_68=
comp_69=#define PI 3.14159265359
comp_70=#define PHI (1. + sqrt(5.))/2.
comp_71=
comp_72=void icosahedronVerts(in float3 p, out float3 face, out float3 a, out float3 b, out float3 c) {
comp_73=
comp_74=  float3 V = float3(PHI, 1,  0);
comp_75=  float3 ap = abs(p), v = V;
comp_76=  if (dot(ap, V.yzx - v) > 0.) v = V.yzx;
comp_77=  if (dot(ap, V.zxy - v) > 0.) v = V.zxy;
comp_78=  a = normalize(v)*sign(p);
comp_79=
comp_80=  v = V.xxx;
comp_81=  V = float3(V.zy, V.x + V.y);
comp_82=  if (dot(ap, V - v) > 0.) v = V;
comp_83=  if (dot(ap, V.yzx - v) > 0.) v = V.yzx;
comp_84=  if (dot(ap, V.zxy - v) > 0.) v = V.zxy;
comp_85=  face = normalize(v)*sign(p);
comp_86=
comp_87=  float r = PI*2./3.;
comp_88=
comp_89=  b = erot(a, face, -r);
comp_90=  c = erot(a, face, r);
comp_91=
comp_92=}
comp_93=
comp_94=float de(float3 p) {
comp_95=  pt=float3(p.xy-path(p.z).xy,p.z);
comp_96=  float h=abs(hexagon(pt.xy,3.+fparam));
comp_97=  hexpos=hex(pt.yz);
comp_98=  tcol=smoothstep(.0,.15,hexpos);
comp_99=  h-=tcol*.1;
comp_100=  float3 pp=p-hpos;
comp_101=  pp = mul(pp, lookat(fpoint));
comp_102=  pp.y-=abs(sin(time))*3.+(fparam-(2.-fparam));
comp_103=  pp.yz = mul(pp.yz, transpose(rot(-time)));
comp_104=
comp_105=  float bola=lenv(pp)-1.;
comp_106=
comp_107=  if(lenv(pp)<1.5){
comp_108=
comp_109=    float3 face;
comp_110=    float3 v0, v1, v2;
comp_111=    icosahedronVerts(pp, face, v0, v1, v2);
comp_112=    float srad = 1.;
comp_113=    // Sphere radius.
comp_114=
comp_115=    float3 mid0 = lerp(v0, v1, 1./3.);
comp_116=    float3 mid1 = lerp(v0, v1, 2./3.);
comp_117=    float3 mid2 = lerp(v1, v2, 1./3.);
comp_118=    float3 mid3 = lerp(v1, v2, 2./3.);
comp_119=    float3 mid4 = lerp(v2, v0, 1./3.);
comp_120=    float3 mid5 = lerp(v2, v0, 2./3.);
comp_121=
comp_122=    float poly = -1e5;
comp_123=    poly = max(poly, sphereLineAB(pp, mid0, mid1, srad));
comp_124=    poly = max(poly, sphereLineAB(pp, mid1, mid2, srad));
comp_125=    poly = max(poly, sphereLineAB(pp, mid2, mid3, srad));
comp_126=    poly = max(poly, sphereLineAB(pp, mid3, mid4, srad));
comp_127=    poly = max(poly, sphereLineAB(pp, mid4, mid5, srad));
comp_128=    poly = max(poly, sphereLineAB(pp, mid5, mid0, srad));
comp_129=
comp_130=    bcol = smoothstep(0., .05, abs(poly));
comp_131=    bola += bcol*.1;
comp_132=
comp_133=  }
comp_134=
comp_135=  float3 pr=p;
comp_136=  pr.z=mod_conv(p.z,6.)-3.;
comp_137=  float d=min(h,bola);
comp_138=  if (d==bola) {
comp_139=    tcol=1.;
comp_140=    hitbol=1.;
comp_141=  }
comp_142=
comp_143=  else {
comp_144=    hitbol=0.;
comp_145=    bcol=1.;
comp_146=  }
comp_147=
comp_148=  return d*.5;
comp_149=}
comp_150=
comp_151=float3 normal(float3 p) {
comp_152=  float2 e=float2(0.,.005);
comp_153=  return normalize(float3(de(p+e.yxx),de(p+e.xyx),de(p+e.xxy))-de(p));
comp_154=}
comp_155=
comp_156=float3 march(float3 from, float3 dir) {
comp_157=  float3 odir=dir;
comp_158=  float3 p=from,col=float3(0., 0., 0.);
comp_159=  float d,td=0.;
comp_160=  float3 g=float3(0., 0., 0.);
comp_161=  for (int i=min(frame,0); i<200; i++) {
comp_162=    d=de(p);
comp_163=    // CONV: replaced break with breaking condition
comp_164=    if (d<.001||td>200.)  i=200;
comp_165=    p+=dir*d;
comp_166=    td+=d;
comp_167=    g+=.1/(.1+d)*hitbol*abs(normalize(fpoint));
comp_168=  }
comp_169=
comp_170=  float hp=hexpos*(1.-hitbol);
comp_171=  p-=dir*.01;
comp_172=  float3 n=normal(p);
comp_173=  if (d<.001) {
comp_174=    col=pow(max(0.,dot(-dir,n)),2.)*float3(.6,.7,.8)*tcol*bcol;
comp_175=  }
comp_176=
comp_177=  col+=float(hexid);
comp_178=  float3 pr=pt;
comp_179=  dir=reflect(dir,n);
comp_180=  td=0.;
comp_181=  for (int i=min(frame,0); i<200; i++) {
comp_182=    d=de(p);
comp_183=    // CONV: replaced break with breaking condition
comp_184=    if (d<.001||td>200.)  i=200;
comp_185=    p+=dir*d;
comp_186=    td+=d;
comp_187=    g+=.1/(.1+d)*abs(normalize(fpoint));
comp_188=  }
comp_189=
comp_190=  float zz=p.z;
comp_191=  if (d<.001) {
comp_192=    float3 refcol=pow(max(0.,dot(-odir,n)),2.)*float3(.6,.7,.8)*tcol*bcol;
comp_193=    p=pr;
comp_194=    p=abs(.5-frac(p*.1));
comp_195=    float m=100.;
comp_196=    for (int i=0; i<10; i++) {
comp_197=      p=abs(p)/max(dot(p,p),1e-6)-.8;
comp_198=      m=min(m,lenv(p));
comp_199=    }
comp_200=
comp_201=    col=lerp(col,refcol,m)-m*.3;
comp_202=    col+=step(.3,hp)*step(.9,frac(pr.z*.05+time*.5+hp*.1))*.7;
comp_203=    col+=step(.3,hexpos)*step(.9,frac(zz*.05+time+hexpos*.1))*.3;
comp_204=  }
comp_205=
comp_206=  col+=g*.03;
comp_207=  col.rb = mul(col.rb, transpose(rot(odir.y*.5)));
comp_208=  return col;
comp_209=}
comp_210=
comp_211=shader_body {
comp_212=  float4 fragColor = 0;
comp_213=  float2 fragCoord  = uv;
comp_214=  // CONV: Center on screen, then try some aspect correction
comp_215=  uv = (uv*2) - 1;
comp_216=  uv *= aspect.xy;
comp_217=  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_218=  uv = float2(uv.x, -uv.y);
comp_219=  // CONV: Adjust viewpoint (x,y individually or both)
comp_220=  uv += float2(0,0) + 0;
comp_221=  uv *= float2(1,1) * 1;
comp_222=  // AUDIO: version 1 = slow (bass_smooth), 2 = fast (bass_att), >2 = off - see the remote's Version tooltip
comp_223=  #ifdef bass_smooth
comp_224=    float aRng = (int)vis_version == 1 ? 0.30 : 0.26;
comp_225=    float aFac = (int)vis_version > 2 ? 1*vis_intensity+vis_shift
comp_226=      : (1.0 - aRng*0.5 + smoothstep(0,2,(int)vis_version == 1 ? bass_smooth : bass_att)*aRng) * vis_intensity + vis_shift;
comp_227=  #else
comp_228=    float aFac = (1.0 - 0.15) + smoothstep(0,2,bass_att)*0.30;
comp_229=  #endif
comp_230=  float aDev = aFac - 1.0;   // 0 at the track average, +loud, -quiet
comp_231=  float aBe  = aDev * 4.0, aCol = (int)vis_version == 1 ? 1.7 : 0.7;   // beat scale, colour reaction scale
comp_232=  // AUDIO: the wall rolls with the level
comp_233=  float aAng = aDev * 0.9;
comp_234=  uv = float2(uv.x*cos(aAng) - uv.y*sin(aAng), uv.x*sin(aAng) + uv.y*cos(aAng));
comp_235=
comp_236=  // float2 uv = fragCoord/uv.xy-.5;
comp_237=  // CONV: aspect correction is already done by the prologue (was applied twice)
comp_238=  float t=time*2.;
comp_239=  float3 from=path(t);
comp_240=  if (mod_conv(time-10.,20.)>10.) {
comp_241=    from=path(floor(t/20.)*20.+10.);
comp_242=    from.x+=2.;
comp_243=  }
comp_244=
comp_245=  hpos=path(t+3.);
comp_246=  float3 adv=path(t+2.);
comp_247=  float3 dir=normalize(float3(uv,.7));
comp_248=  float3 dd=normalize(adv-from);
comp_249=  fpoint=normalize(adv-hpos);
comp_250=  fpoint.xz = mul(fpoint.xz, transpose(rot(sin(time)*.2)));
comp_251=  dir = mul(dir, lookat(dd));
comp_252=  float3 col = march(from, dir);
comp_253=  col*=float3(1.,.9,.8);
comp_254=  fragColor = float4(col,1.0);
comp_255=  ret = fragColor;
comp_256=  // AUDIO: the palette rotates on beats
comp_257=  ret = lerp(ret, ret.zyx, aBe * 0.2 * aCol);
comp_258=}
comp_259=
