MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// [SIG15] EntryLevel by dila (Shadertoy llXXzf) / https://www.shadertoy.com/view/llXXzf
comp_2=// CC BY-NC-SA 3.0
comp_3=// Transpiled to HLSL using Milkwave
comp_4=
comp_5=#define tx (sin(time)*0.5+1)
comp_6=
comp_7=// CONV2: guarded length helpers (legacy compiler reports lenv() as division by zero)
comp_8=float lenv(float2 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_9=float lenv(float3 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_10=
comp_11=// CONV: setting iChannel samplers to default noise texture
comp_12=#define iChannel0 sampler_noise_lq
comp_13=#define iChannel1 sampler_noise_lq
comp_14=
comp_15=static const float pi = 3.14159;
comp_16=
comp_17=float3x3 xrot(float t)
comp_18={
comp_19=  return float3x3(1.0, 0.0, 0.0,
comp_20=  0.0, cos(t), -sin(t),
comp_21=  0.0, sin(t), cos(t));
comp_22=}
comp_23=
comp_24=float3x3 yrot(float t)
comp_25={
comp_26=  return float3x3(cos(t), 0.0, -sin(t),
comp_27=  0.0, 1.0, 0.0,
comp_28=  sin(t), 0.0, cos(t));
comp_29=}
comp_30=
comp_31=float3x3 zrot(float t)
comp_32={
comp_33=  return float3x3(cos(t), -sin(t), 0.0,
comp_34=  sin(t), cos(t), 0.0,
comp_35=  0.0, 0.0, 1.0);
comp_36=}
comp_37=
comp_38=float2 map(float3 p)
comp_39={
comp_40=  p.x += sin(p.z);
comp_41=  p = mul(p, transpose(zrot(p.z)));
comp_42=  float d = 1000.0;
comp_43=  float3 q = frac(p) * 2.0 - 1.0;
comp_44=  float idx = 0.0;
comp_45=  for (int i=min(frame,0); i < 3; ++i) {
comp_46=
comp_47=    q = sign(q) * (1.0 - 1.0 / (1.0 + abs(q) * 0.8));
comp_48=
comp_49=    float md = lenv(q) - 0.5;
comp_50=
comp_51=    float ss = 0.5 + 0.5 * sin(p.z + md * float(i) * 6.0);
comp_52=
comp_53=    float cyl = lenv(p.xy) - 0.5 - ss;
comp_54=
comp_55=    md = max(md, -cyl);
comp_56=
comp_57=    if (md < d) {
comp_58=      d = md;
comp_59=      idx = float(i);
comp_60=    }
comp_61=
comp_62=  }
comp_63=
comp_64=  return float2(d, idx);
comp_65=}
comp_66=
comp_67=float3 normal(float3 p)
comp_68={
comp_69=  float3 o = float3(0.1, 0.0, 0.0);
comp_70=  return normalize(float3(map(p+o.xyy).x - map(p-o.xyy).x,
comp_71=  map(p+o.yxy).x - map(p-o.yxy).x,
comp_72=  map(p+o.yyx).x - map(p-o.yyx).x));
comp_73=}
comp_74=
comp_75=float trace(float3 o, float3 r)
comp_76={
comp_77=  float t = 0.0;
comp_78=  for (int i=min(frame,0); i < 64; ++i) {
comp_79=    float3 p = o + r * t;
comp_80=    float d = map(p).x;
comp_81=    t += d * 0.3;
comp_82=  }
comp_83=
comp_84=  return t;
comp_85=}
comp_86=
comp_87=float3 _tex2D(float3 p)
comp_88={
comp_89=  float3 ta = tex2D(iChannel0, float2(p.y,p.z)).xyz;
comp_90=  float3 tb = tex2D(iChannel0, float2(p.x,p.z)).xyz;
comp_91=  float3 tc = tex2D(iChannel0, float2(p.x,p.y)).xyz;
comp_92=  return (ta + tb + tc) / 3.0;
comp_93=}
comp_94=
comp_95=shader_body {
comp_96=  float4 fragColor = 0;
comp_97=  float2 fragCoord  = uv;
comp_98=  // CONV: Center on screen, then try some aspect correction
comp_99=  uv = (uv*2) - 1;
comp_100=  uv *= aspect.xy;
comp_101=  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_102=  uv = float2(uv.x, -uv.y);
comp_103=  // CONV: Adjust viewpoint (x,y individually or both)
comp_104=  uv += float2(0,0) + 0;
comp_105=  uv *= float2(1,1) * 1;
comp_106=
comp_107=  // float2 uv = fragCoord.xy / uv.xy;
comp_108=
comp_109=  // CONV block above already centers the uv and applies the aspect correction
comp_110=
comp_111=  float3 r = normalize(float3(uv, 1.0 - dot(uv,uv) * 0.33));
comp_112=
comp_113=  r = mul(r, transpose(mul(zrot(time * 0.25), yrot(-sin(time)))));
comp_114=
comp_115=  float3 o = float3(0.0, 0.0, 0.0);
comp_116=  o.z += time;
comp_117=  o.x += -sin(o.z);
comp_118=
comp_119=  float t = trace(o, r);
comp_120=  float3 w = o + r * t;
comp_121=  float3 sn = normal(w);
comp_122=  float2 fd = map(w);
comp_123=  float3 ref = reflect(r, sn);
comp_124=
comp_125=  float3 diff = float3(0.0, 0.0, 0.0);
comp_126=  if (fd.y == 0.0) {
comp_127=    diff = float3(1.0, 0.0, 0.0);
comp_128=  }
comp_129=
comp_130=  else if (fd.y == 1.0) {
comp_131=    diff = float3(0.0, 1.0, 0.0);
comp_132=  }
comp_133=
comp_134=  else if (fd.y == 2.0) {
comp_135=    diff = float3(0.0, 0.0, 1.0);
comp_136=  }
comp_137=
comp_138=  else {
comp_139=    diff = float3(1.0, 1.0, 1.0);
comp_140=  }
comp_141=
comp_142=  diff += _tex2D(w);
comp_143=  diff += tex2D(iChannel1, ref.xy).xyz;
comp_144=
comp_145=  diff = lerp(diff, float3(1.0, 1.0, 1.0), abs(sn.y));
comp_146=  diff = lerp(float3(0.8, 0.0, 0.0), diff, abs(sn.y));
comp_147=
comp_148=  float prod = max(dot(sn, -r), 0.0);
comp_149=  diff *= prod;
comp_150=
comp_151=  float fog = 1.0 / (1.0 + t * t * 0.1 + fd.x * 100.0);
comp_152=  float3 fc = diff * fog;
comp_153=
comp_154=  fragColor = float4(sqrt(fc), 1.0);
comp_155=  ret = fragColor;
comp_156=}
