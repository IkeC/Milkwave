MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// TDM - Seascape / https://www.shadertoy.com/view/Ms2SD1
comp_2=// License: CC BY-NC-SA 3.0 (stated in the source header)
comp_3=// Transpiled to HLSL using Milkwave
comp_4=
comp_5=// CONV2: guarded length helpers (legacy compiler reports length() as division by zero)
comp_6=float lenv(float2 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_7=float lenv(float3 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_8=float lenv(float4 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_9=
comp_10=static const int NUM_STEPS = 32;
comp_11=static const float PI	 	= 3.141592;
comp_12=static const float EPSILON	= 1e-3;
comp_13=#define EPSILON_NRM (0.1 / texsize.x)
comp_14=
comp_15=static const int ITER_GEOMETRY = 3;
comp_16=static const int ITER_FRAGMENT = 5;
comp_17=static const float SEA_HEIGHT = 0.6;
comp_18=static const float SEA_CHOPPY = 4.0;
comp_19=static const float SEA_SPEED = 0.8;
comp_20=static const float SEA_FREQ = 0.16;
comp_21=static const float3 SEA_BASE = float3(0.0,0.09,0.18);
comp_22=static const float3 SEA_WATER_COLOR = float3(0.8,0.9,0.6)*0.6;
comp_23=#define SEA_TIME (1.0 + time * SEA_SPEED)
comp_24=
comp_25=static const float2x2 octave_m = float2x2(1.6,1.2,-1.2,1.6);
comp_26=
comp_27=float3x3 fromEuler(float3 ang_conv) {
comp_28=  float2 a1 = float2(sin(ang_conv.x),cos(ang_conv.x));
comp_29=  float2 a2 = float2(sin(ang_conv.y),cos(ang_conv.y));
comp_30=  float2 a3 = float2(sin(ang_conv.z),cos(ang_conv.z));
comp_31=  float3x3 m;
comp_32=  m[0] = float3(a1.y*a3.y+a1.x*a2.x*a3.x,a1.y*a2.x*a3.x+a3.y*a1.x,-a2.y*a3.x);
comp_33=  m[1] = float3(-a2.y*a1.x,a1.y*a2.y,a2.x);
comp_34=  m[2] = float3(a3.y*a1.x*a2.x+a1.y*a3.x,a1.x*a3.x-a1.y*a3.y*a2.x,a2.y*a3.y);
comp_35=  return m;
comp_36=}
comp_37=
comp_38=float hash( float2 p ) {
comp_39=  float h = dot(p,float2(127.1,311.7));
comp_40=  return frac(sin(h)*43758.5453123);
comp_41=}
comp_42=
comp_43=float noise( in float2 p ) {
comp_44=  float2 i = floor( p );
comp_45=  float2 f = frac( p );
comp_46=  float2 u = f*f*(3.0-2.0*f);
comp_47=  return -1.0+2.0*lerp( lerp( hash( i + float2(0.0,0.0) ),
comp_48=  hash( i + float2(1.0,0.0) ), u.x),
comp_49=  lerp( hash( i + float2(0.0,1.0) ),
comp_50=  hash( i + float2(1.0,1.0) ), u.x), u.y);
comp_51=}
comp_52=
comp_53=float diffuse(float3 n,float3 l,float p) {
comp_54=  return pow(dot(n,l) * 0.4 + 0.6,p);
comp_55=}
comp_56=
comp_57=float specular(float3 n,float3 l,float3 e,float s) {
comp_58=  float nrm = (s + 8.0) / (PI * 8.0);
comp_59=  return pow(max(dot(reflect(e,n),l),0.0),s) * nrm;
comp_60=}
comp_61=
comp_62=float3 getSkyColor(float3 e) {
comp_63=  e.y = (max(e.y,0.0)*0.8+0.2)*0.8;
comp_64=  return float3(pow(1.0-e.y,2.0), 1.0-e.y, 0.6+(1.0-e.y)*0.4) * 1.1;
comp_65=}
comp_66=
comp_67=float sea_octave(float2 uv_conv,  float choppy) {
comp_68=  uv_conv += noise(uv_conv);
comp_69=  float2 wv = 1.0-abs(sin(uv_conv));
comp_70=  float2 swv = abs(cos(uv_conv));
comp_71=  wv = lerp(wv,swv,wv);
comp_72=  return pow(1.0-pow(wv.x * wv.y,0.65),choppy);
comp_73=}
comp_74=
comp_75=float map(float3 p) {
comp_76=  float freq = SEA_FREQ;
comp_77=  float amp = SEA_HEIGHT;
comp_78=  float choppy = SEA_CHOPPY;
comp_79=  float2 uv_conv = p.xz; uv_conv.x *= 0.75;
comp_80=
comp_81=  float d, h = 0.0;
comp_82=  for (int i=min(frame,0); i < ITER_GEOMETRY; i++) {
comp_83=    d = sea_octave((uv_conv+SEA_TIME)*freq,choppy);
comp_84=    d += sea_octave((uv_conv-SEA_TIME)*freq,choppy);
comp_85=    h += d * amp;
comp_86=    uv_conv = mul(octave_m, uv_conv); freq *= 1.9; amp *= 0.22;   // CONV: uv is the engine macro, the octave space is uv_conv
comp_87=    choppy = lerp(choppy,1.0,0.2);
comp_88=  }
comp_89=
comp_90=  return p.y - h;
comp_91=}
comp_92=
comp_93=float map_detailed(float3 p) {
comp_94=  float freq = SEA_FREQ;
comp_95=  float amp = SEA_HEIGHT;
comp_96=  float choppy = SEA_CHOPPY;
comp_97=  float2 uv_conv = p.xz; uv_conv.x *= 0.75;
comp_98=
comp_99=  float d, h = 0.0;
comp_100=  for (int i=min(frame,0); i < ITER_FRAGMENT; i++) {
comp_101=    d = sea_octave((uv_conv+SEA_TIME)*freq,choppy);
comp_102=    d += sea_octave((uv_conv-SEA_TIME)*freq,choppy);
comp_103=    h += d * amp;
comp_104=    uv_conv = mul(octave_m, uv_conv); freq *= 1.9; amp *= 0.22;   // CONV: uv is the engine macro, the octave space is uv_conv
comp_105=    choppy = lerp(choppy,1.0,0.2);
comp_106=  }
comp_107=
comp_108=  return p.y - h;
comp_109=}
comp_110=
comp_111=float3 getSeaColor(float3 p, float3 n, float3 l, float3 eye, float3 dist) {
comp_112=  float fresnel = clamp(1.0 - dot(n, -eye), 0.0, 1.0);
comp_113=  fresnel = min(fresnel * fresnel * fresnel, 0.5);
comp_114=
comp_115=  float3 reflected = getSkyColor(reflect(eye, n));
comp_116=  float3 refracted = SEA_BASE + diffuse(n, l, 80.0) * SEA_WATER_COLOR * 0.12;
comp_117=
comp_118=  float3 color = lerp(refracted, reflected, fresnel);
comp_119=
comp_120=  float atten = max(1.0 - dot(dist, dist) * 0.001, 0.0);
comp_121=  color += SEA_WATER_COLOR * (p.y - SEA_HEIGHT) * 0.18 * atten;
comp_122=
comp_123=  color += specular(n, l, eye, 600.0 * rsqrt(dot(dist,dist)));
comp_124=
comp_125=  return color;
comp_126=}
comp_127=
comp_128=float3 getNormal(float3 p, float eps) {
comp_129=  float3 n;
comp_130=  n.y = map_detailed(p);
comp_131=  n.x = map_detailed(float3(p.x+eps,p.y,p.z)) - n.y;
comp_132=  n.z = map_detailed(float3(p.x,p.y,p.z+eps)) - n.y;
comp_133=  n.y = eps;
comp_134=  return normalize(n);
comp_135=}
comp_136=
comp_137=// CONV: single return (the legacy compiler rejects asymmetric returns from if statements)
comp_138=float heightMapTracing(float3 ori, float3 dir, out float3 p) {
comp_139=  float tm = 0.0;
comp_140=  float tx = 1000.0;
comp_141=  float hx = map(ori + dir * tx);
comp_142=  float hm = map(ori);
comp_143=  float result;
comp_144=  if(hx > 0.0) {
comp_145=    p = ori + dir * tx;
comp_146=    result = tx;
comp_147=  }
comp_148=  else {
comp_149=    for (int i=min(frame,0); i < NUM_STEPS; i++) {
comp_150=      float tmid = lerp(tm, tx, hm / (hm - hx));
comp_151=      p = ori + dir * tmid;
comp_152=      float hmid = map(p);
comp_153=      if(hmid < 0.0) {
comp_154=        tx = tmid;
comp_155=        hx = hmid;
comp_156=      }
comp_157=      else {
comp_158=        tm = tmid;
comp_159=        hm = hmid;
comp_160=      }
comp_161=
comp_162=      // CONV: replaced break with breaking condition
comp_163=      if(abs(hmid) < EPSILON)  i = NUM_STEPS;
comp_164=    }
comp_165=    result = lerp(tm, tx, hm / (hm - hx));
comp_166=  }
comp_167=  return result;
comp_168=}
comp_169=
comp_170=float3 getPixel(in float2 coord, float time_conv, float pitch) {
comp_171=  float2 uv_conv = coord / texsize.xy;   // CONV: coord is in pixels
comp_172=  uv_conv = uv_conv * 2.0 - 1.0;
comp_173=  uv_conv.x *= texsize.x / texsize.y;
comp_174=
comp_175=  float3 ang_conv = float3(sin(time_conv*3.0)*0.1, sin(time_conv)*0.2 + 0.3 + pitch, time_conv);   // AUDIO: pitch reacts to the level
comp_176=  float3 ori = float3(0.0,3.5,time_conv*5.0);
comp_177=  float3 dir = normalize(float3(uv_conv.xy,-2.0)); dir.z += lenv(uv_conv) * 0.14;
comp_178=  dir = mul(fromEuler(ang_conv), normalize(dir));   // CONV: GLSL v * M with the matrix rows holding the GLSL columns
comp_179=
comp_180=  float3 p;
comp_181=  heightMapTracing(ori,dir,p);
comp_182=  float3 dist = p - ori;
comp_183=  float3 n = getNormal(p, dot(dist,dist) * EPSILON_NRM);
comp_184=  float3 light = normalize(float3(0.0,1.0,0.8));
comp_185=
comp_186=  return lerp(
comp_187=  getSkyColor(dir),
comp_188=  getSeaColor(p,n,light,dir,dist),
comp_189=  pow(smoothstep(0.0,-0.02,dir.y),0.2));
comp_190=}
comp_191=
comp_192=shader_body {
comp_193=  float4 fragColor = 0;
comp_194=  // AUDIO: 1 = calm (bass_smooth), 2 = more reactive (bass_att), 3+ = static - see the remote's Version tooltip
comp_195=  #ifdef bass_smooth
comp_196=    float aRng = (int)vis_version == 1 ? 0.26 : 0.45;
comp_197=    float aFac = (int)vis_version > 2 ? 1*vis_intensity+vis_shift
comp_198=      : (1.0 - aRng*0.5 + smoothstep(0,2,(int)vis_version == 1 ? bass_smooth : bass_att)*aRng) * vis_intensity + vis_shift;
comp_199=  #else
comp_200=    float aFac = (1.0 - 0.15) + smoothstep(0,2,bass_att)*0.30;
comp_201=  #endif
comp_202=  float aDev = aFac - 1.0;   // 0 at the track average, +loud, -quiet
comp_203=  float aBe  = aDev * 4.0, aCol = (int)vis_version == 1 ? 0.7 : 1.3;   // beat scale, colour reaction scale
comp_204=  // CONV: Shadertoy fragCoord is in pixels with the origin in the bottom left corner
comp_205=  float2 fragPixel = uv_orig.xy * texsize.xy;
comp_206=  fragPixel.y = texsize.y - fragPixel.y;
comp_207=
comp_208=  // CONV: the original adds iMouse.x*0.01 here - the visualizer has no mouse in the scene, and the
comp_209=  // cursor position would make the whole sea jump and the frozen-frame measurement impossible
comp_210=  float time_conv = time * 0.3;
comp_211=
comp_212=  #ifdef AA
comp_213=  float3 color = float3(0.0, 0.0, 0.0);
comp_214=  for(int i = -1; i <= 1; i++) {
comp_215=    for(int j = -1; j <= 1; j++) {
comp_216=      color += getPixel(fragPixel + float2(i, j)/3.0, time_conv, aDev*0.06);
comp_217=    }
comp_218=  }
comp_219=  color /= 9.0;
comp_220=  #else
comp_221=  float3 color = getPixel(fragPixel, time_conv, aDev*0.06);
comp_222=  #endif
comp_223=
comp_224=  // AUDIO: the sea tilts with the level and the water greens up on beats
comp_225=  color = lerp(color, color * float3(0.92, 1.06, 0.98), saturate(aBe) * 0.35 * aCol);
comp_226=
comp_227=  // post
comp_228=  fragColor = float4(pow(color,float3(0.65, 0.65, 0.65)), 1.0);
comp_229=  ret = fragColor;
comp_230=}
