MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// SnoopethDuckDuck - Golden Electric Spiral / https://www.shadertoy.com/view/csj3zt
comp_2=// License: Creative Commons Attribution-NonCommercial-ShareAlike 3.0 (Shadertoy default)
comp_3=// Transpiled to HLSL using Milkwave
comp_4=
comp_5=// CONV2: guarded length helpers (legacy compiler reports lenv() as division by zero)
comp_6=float lenv(float2 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_7=float lenv(float3 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_8=
comp_9=shader_body {
comp_10=  float2 u = float2((uv.x - 0.5)*texsize.x/texsize.y, -(uv.y - 0.5));
comp_11=
comp_12=  float a = atan2(u.y, u.x);
comp_13=  float2 p = cos(a + time)*float2(cos(0.5*time), sin(0.3*time));
comp_14=
comp_15=  float d1 = lenv(u - p);
comp_16=  float d2 = lenv(u);
comp_17=
comp_18=  float2 uv2 = 2.*cos(log(lenv(u))*0.25 - 0.5*time + log(float2(d1, d2)/(d1 + d2)));
comp_19=
comp_20=  // square tiles: cell count grows with the high end
comp_21=  float tiles = 4.;
comp_22=  #ifdef bass_smooth
comp_23=    if ((int)vis_version == 1)      tiles *= 1. + 0.35*(smoothstep(0, 2, treb_smooth) - 0.5)*vis_intensity + vis_shift;
comp_24=    else if ((int)vis_version == 2) tiles *= 1. + 0.50*(smoothstep(0, 2, treb_att) - 0.5)*vis_intensity + vis_shift;
comp_25=    else                            tiles *= 1. + 0.0*vis_intensity + vis_shift;
comp_26=  #else
comp_27=    tiles *= 1. + 0.25*(smoothstep(0, 2, treb_att) - 0.5);
comp_28=  #endif
comp_29=
comp_30=  float2 fpos = frac(tiles*uv2) - 0.5;
comp_31=  float d = max(abs(fpos.x), abs(fpos.y));
comp_32=  float k = 5./texsize.y;
comp_33=  float s = smoothstep(-k, k, 0.25 - d);
comp_34=  float3 col = float3(s, 0.5*s, 0.1 - 0.1*s);
comp_35=  col += 1./cosh(-2.5*(lenv(u - p) + lenv(u)))*float3(1, 0.5, 0.1);
comp_36=
comp_37=  // electric filaments: brightness follows the low end
comp_38=  float fil = 1.;
comp_39=  #ifdef bass_smooth
comp_40=    if ((int)vis_version == 1)      fil += 0.50*(smoothstep(0, 2, bass_smooth) - 0.5)*vis_intensity + vis_shift;
comp_41=    else if ((int)vis_version == 2) fil += 0.80*(smoothstep(0, 2, bass_att) - 0.5)*vis_intensity + vis_shift;
comp_42=    else                            fil += 0.0*vis_intensity + vis_shift;
comp_43=  #else
comp_44=    fil += 0.40*(smoothstep(0, 2, bass_att) - 0.5);
comp_45=  #endif
comp_46=
comp_47=  float c = cos(10.*lenv(uv2) + 4.*time);
comp_48=  col += fil*(0.5 + 0.5*c)*float3(0.5, 1, 1) *
comp_49=         exp(-9.*abs(cos(9.*a + time)*u.x
comp_50=                   + sin(9.*a + time)*u.y
comp_51=                   + 0.1*c));
comp_52=
comp_53=  ret = float4(col, 1.0);
comp_54=}
comp_55=
