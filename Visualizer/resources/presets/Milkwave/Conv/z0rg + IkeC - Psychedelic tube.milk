MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// z0rg - Psychedelic tube / https://www.shadertoy.com/view/sdcGRX
comp_2=// License: Creative Commons Attribution-NonCommercial-ShareAlike 3.0 (Shadertoy default)
comp_3=// Transpiled to HLSL using Milkwave
comp_4=// Adapted: the original is a 2-pass shader whose Buffer A feeds itself (previous frame
comp_5=// via iChannel2). A MilkDrop comp shader cannot read the previous frame, so the temporal
comp_6=// echo/trail pass is omitted; the raymarched tube, stripes and texture overlay are kept.
comp_7=
comp_8=// CONV: setting iChannel samplers to default noise texture
comp_9=#define iChannel0 sampler_noise_lq
comp_10=
comp_11=// CONV: adding helper functions
comp_12=float2 mod_conv(float2 x, float2 y) { return x - y * floor(x / y); }
comp_13=
comp_14=// CONV2: guarded length helpers (legacy compiler reports lenv() as division by zero)
comp_15=float lenv(float2 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_16=float lenv(float3 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_17=float lenv(float4 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_18=
comp_19=#define sat(a) clamp(a, 0., 1.)
comp_20=#define FFT(a) 0.5
comp_21=
comp_22=// row-vector rotation, equivalent to GLSL v * mat2(c,-s,s,c)
comp_23=float2x2 r2d(float a) { float c = cos(a), s = sin(a); return float2x2(c, s, -s, c); }
comp_24=
comp_25=float2 _min(float2 a, float2 b) { return a.x < b.x ? a : b; }
comp_26=
comp_27=float2 map(float3 p) {
comp_28=  float2 acc = float2(1000., -1.);
comp_29=
comp_30=  p.xy -= float2(sin(p.z+time), cos(p.z*.5+time))*.5;
comp_31=  p.y += sin(p.z*2.+time)*.1;
comp_32=  // tube radius breathes with the low end (base look is audio-independent)
comp_33=  float trad = 0.125;
comp_34=  #ifdef bass_smooth
comp_35=    if ((int)vis_version == 1)      trad += 0.25*(smoothstep(0, 2, bass_smooth) - 0.5)*vis_intensity + vis_shift;
comp_36=    else if ((int)vis_version == 2) trad += 0.40*(smoothstep(0, 2, bass_att) - 0.5)*vis_intensity + vis_shift;
comp_37=    else                            trad += 0.0*vis_intensity + vis_shift;
comp_38=  #else
comp_39=    trad += 0.20*(smoothstep(0, 2, bass_att) - 0.5);
comp_40=  #endif
comp_41=  float2 tube = float2(-(lenv(p.xy)-2.-trad+sin(p.z*.25)), 0.);
comp_42=  acc = _min(acc, tube);
comp_43=
comp_44=  return acc;
comp_45=}
comp_46=
comp_47=static float3 accCol;
comp_48=
comp_49=float3 trace(float3 ro, float3 rd, int steps) {
comp_50=  accCol = float3(0., 0., 0.);
comp_51=  float3 p = ro;
comp_52=  float3 outv = float3(-1., -1., -1.);
comp_53=  for (int i = 0; i < steps; ++i) {
comp_54=    float2 res = map(p);
comp_55=    if (res.x < 0.01) {
comp_56=      outv = float3(res.x, distance(p, ro), res.y);
comp_57=      i = steps;
comp_58=    } else {
comp_59=      accCol += float3(1., .5, sin(p.z)*.5+.5)*pow(1.-sat(res.x/.7), 30.)*.3;
comp_60=      p += rd*res.x*.7;
comp_61=    }
comp_62=  }
comp_63=  return outv;
comp_64=}
comp_65=
comp_66=float3 getCam(float3 rd, float2 u) {
comp_67=  float fov = 1.;
comp_68=  float3 r = normalize(cross(rd, float3(0.,1.,0.)));
comp_69=  float3 un = normalize(cross(rd, r));
comp_70=  return normalize(rd+fov*(r*u.x+un*u.y));
comp_71=}
comp_72=
comp_73=float3 getNorm(float3 p, float d) {
comp_74=  float2 e = float2(0.01, 0.);
comp_75=  return normalize(float3(d, d, d)-float3(map(p-e.xyy).x, map(p-e.yxy).x, map(p-e.yyx).x));
comp_76=}
comp_77=
comp_78=float _sqr(float2 p, float2 s) {
comp_79=  float2 l = abs(p)-s;
comp_80=  return max(l.x, l.y);
comp_81=}
comp_82=
comp_83=float3 rdr(float2 u) {
comp_84=  float3 col = float3(1., 1., 1.);
comp_85=  float t = time*2.;
comp_86=  float3 ro = float3(sin(time)*.15, cos(time*.5)*.12, -12.+t);
comp_87=  float3 ta = float3(0., 0., t);
comp_88=  float3 rd = normalize(ta-ro);
comp_89=  rd.xz = mul(rd.xz, r2d(sin(time*.5)*.15));
comp_90=  rd.yz = mul(rd.yz, r2d(sin(time+.5)*.15));
comp_91=  rd = getCam(rd, u);
comp_92=  float3 res = trace(ro, rd, 256);
comp_93=  if (res.y > 0.) {
comp_94=    float3 p = ro+rd*res.y;
comp_95=    float3 n = getNorm(p, res.x);
comp_96=    col = n*.5+.5;
comp_97=    float3 ldir = p-float3(0., 0., 0.);
comp_98=    col = sat(dot(normalize(ldir), n))*float3(1., 1., 1.);
comp_99=    col += accCol;
comp_100=    col = pow(col, float3(3., 3., 3.));
comp_101=    float2 rep = float2(.9, .5);
comp_102=    float2 luv = float2(atan2(p.y, p.x), p.z+time);
comp_103=    float2 id = floor((luv+.5*rep)/rep);
comp_104=    luv.x += sin(id.y*.5)*time*2.;
comp_105=    luv = mod_conv(luv+.5*rep, rep)-.5*rep;
comp_106=    // dash width follows the high end
comp_107=    float dashw = 0.169;
comp_108=    #ifdef bass_smooth
comp_109=      if ((int)vis_version == 1)      dashw += 0.10*(smoothstep(0, 2, treb_smooth) - 0.5)*vis_intensity + vis_shift;
comp_110=      else if ((int)vis_version == 2) dashw += 0.16*(smoothstep(0, 2, treb_att) - 0.5)*vis_intensity + vis_shift;
comp_111=      else                            dashw += 0.0*vis_intensity + vis_shift;
comp_112=    #else
comp_113=      dashw += 0.08*(smoothstep(0, 2, treb_att) - 0.5);
comp_114=    #endif
comp_115=    float shape = _sqr(luv, float2(dashw, .05));
comp_116=    float3 rgb = lerp(col, float3(1., 1., 1.), 1.-sat(shape*50.));
comp_117=    rgb += pow(FFT(.0),2.)*2.*float3(1., .5, sin(p.z*10.)*.5+.5)*(1.-sat(shape*1.))*(1.-sat(lenv(u)));
comp_118=    col = lerp(col, rgb, sin(time*5.+p.z*.5)*.5+.5);
comp_119=    col += 0.05*tex2D(iChannel0, float2(atan2(p.y, p.x)*2., lenv(p.xy*.1)-.25*time)*.1).xyz;
comp_120=    col = lerp(col, col.zyx, sin(time*1.+p.z*.1)*.5+.5);
comp_121=  }
comp_122=
comp_123=  return col;
comp_124=}
comp_125=
comp_126=shader_body {
comp_127=  float2 fragCoord = uv*texsize.xy;
comp_128=  float2 u_rd = float2(uv.x-0.5, 0.5-uv.y)*texsize.xy/texsize.xx;
comp_129=
comp_130=  float3 col = rdr(u_rd);
comp_131=  col *= 1.+pow(FFT(.1), 1.)*2.;
comp_132=
comp_133=  ret = float4(col, 1.0);
comp_134=}
comp_135=
