MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// diatribes - Blue Red Shiny 2 / https://www.shadertoy.com/view/7cjGRR
comp_2=// License: Creative Commons Attribution-NonCommercial-ShareAlike 3.0 (Shadertoy default)
comp_3=// Transpiled to HLSL using Milkwave
comp_4=
comp_5=float lenv(float2 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_6=float lenv(float3 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_7=float lenv(float4 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_8=
comp_9=#define T (sin(time*.6)*16.+time*1e2)
comp_10=#define P(z) (float3(cos((z)*.011)*16.+cos((z) * .012)  *24., cos((z)*.01)*4., (z)))
comp_11=#define N normalize
comp_12=
comp_13=// accumulated line lights, filled by map()
comp_14=static float4 lights;
comp_15=
comp_16=float boxen(float3 p) {
comp_17=  p = abs(frac(p/2e1)*2e1 - 1e1) - 1.;
comp_18=  return min(p.x, min(p.y, p.z));
comp_19=}
comp_20=
comp_21=float map(float3 p) {
comp_22=  // tube radii breathe with the low end of the spectrum
comp_23=  float rads = 1;
comp_24=  #ifdef bass_smooth
comp_25=    if ((int)vis_version == 1)      rads += 1.0*(smoothstep(0, 2, bass_smooth) - 0.5)*vis_intensity + vis_shift;
comp_26=    else if ((int)vis_version == 2) rads += 0.5*(smoothstep(0, 2, bass_att) - 0.5)*vis_intensity + vis_shift;
comp_27=    else                            rads += 0.0*vis_intensity + vis_shift;
comp_28=  #else
comp_29=    rads += 0.2*(smoothstep(0, 2, bass_att) - 0.5);
comp_30=  #endif
comp_31=
comp_32=  float3 q = P(p.z);
comp_33=  float m, g = q.y - p.y + 6.;
comp_34=
comp_35=  m = boxen(p);
comp_36=
comp_37=  p.xy -= q.xy;
comp_38=
comp_39=  // squiggly lines along z
comp_40=  float red, blue;
comp_41=  float e = min(red = lenv(p.xy - sin(p.z / 12. + float2(0, 1.3)) * 12.) - 1.*rads,
comp_42=                blue = lenv(p.xy - sin(p.z / 16. + float2(0, .7)) * 16.) - 2.*rads);
comp_43=
comp_44=  // CONV: neutral fill in both light terms - a coloured constant is what survives once the
comp_45=  // tube lights fade, which made distant spirals drift green (then dark blue)
comp_46=  lights += float4(1e1, 1, 1, 0) / (.1 + abs(red));
comp_47=  lights += float4(1, 1, 1e1, 0) / (.1 + abs(blue)/1e1);
comp_48=
comp_49=  p = abs(p);
comp_50=
comp_51=  float tex = abs(lenv(sin(p*cos(p.yzx/3e1)*4.)/(p*4. + 1e-4)));
comp_52=  float tun = min(32. - p.x - p.y, 24. - p.y);
comp_53=
comp_54=  float d = max(min(m, g), tun) - tex;
comp_55=  return min(e, d);
comp_56=}
comp_57=
comp_58=shader_body {
comp_59=  // MOUSE: pointer Y zooms - up = zoom in, down = zoom out (0.90x .. 1.30x around the frame centre);
comp_60=  // pointer X pans the view left/right. Centre + released button give the identity transform, so the
comp_61=  // untouched frame stays byte-identical.
comp_62=  float2 mwMouse = (mouse.xy - 0.5) * saturate(mouse.z);
comp_63=  float mwZoomAmt = mwMouse.y > 0.0 ? 0.6 : 0.2;   // zoom in generously, out carefully
comp_64=  float mwZoom = 1.0 + mwMouse.y * mwZoomAmt;
comp_65=  uv = (uv - 0.5) / mwZoom + 0.5 + float2(mwMouse.x * 0.35, 0.0);
comp_66=  float4 mwDead = float4(0.5, 0.5, 0.0, 0.0);   // superseded: the old mouse code below now reads a centred, released pointer
comp_67=
comp_68=  float4 o = 0;
comp_69=  float2 u = float2((uv.x - 0.5)*texsize.x/texsize.y, -(uv.y - 0.5));
comp_70=  u.y -= .2;
comp_71=
comp_72=  int i;
comp_73=  float s = 0., d = 0.05;
comp_74=
comp_75=  float3 p = P(T), ro = p;
comp_76=  float3 Z = N(P(T + 2.) - p);
comp_77=  float3 X = N(float3(Z.z, 0., -Z.x));
comp_78=
comp_79=  // rotated ray direction: vec3(R(a)*u, 1) * mat3(-X, cross(X,Z), Z)
comp_80=  float a = sin(T*.005)*.4;
comp_81=  float3 vv = float3(cos(a)*u.x + cos(a + 11.)*u.y, cos(a + 33.)*u.x + cos(a)*u.y, 1.);
comp_82=  float3 D = N(float3(dot(vv, -X), dot(vv, cross(X, Z)), dot(vv, Z)));
comp_83=  // MOUSE: holding the mouse button looks around - pointer X steers yaw, pointer Y steers pitch.
comp_84=  // Independent of the audio versions; saturate(mwDead.z) keeps the un-pressed frame identical.
comp_85=  float mMx = (mwDead.x - 0.5) * saturate(mwDead.z);
comp_86=  float mMy = (mwDead.y - 0.5) * saturate(mwDead.z);
comp_87=  float mYaw = mMx * 0.85, mPitch = mMy * 0.5;
comp_88=  float mCy = cos(mYaw), mSy = sin(mYaw);
comp_89=  D.xz = mul(transpose(float2x2(mCy, mSy, -mSy, mCy)), D.xz);
comp_90=  float mCp = cos(mPitch), mSp = sin(mPitch);
comp_91=  D.yz = mul(transpose(float2x2(mCp, mSp, -mSp, mCp)), D.yz);
comp_92=
comp_93=  lights = 0;
comp_94=  for (i = 0; i < 100; i++) {
comp_95=    p = ro + D * d;
comp_96=    s = map(p) * .8;
comp_97=    d += s;
comp_98=    o += lights + 1./max(s, .01);
comp_99=  }
comp_100=
comp_101=  // normal, tetrahedron technique
comp_102=  float h = 0.005;
comp_103=  float2 k = float2(1, -1);
comp_104=  float3 n = N(k.xyy*map(p + k.xyy*h) +
comp_105=               k.yyx*map(p + k.yyx*h) +
comp_106=               k.yxy*map(p + k.yxy*h) +
comp_107=               k.xxx*map(p + k.xxx*h));
comp_108=
comp_109=  o *= (.1 + max(dot(n, -D), 0.));
comp_110=
comp_111=  // reflection march
comp_112=  float4 ref = 0;
comp_113=  lights = 0;
comp_114=  p += n*.05;
comp_115=  D = reflect(D, n);
comp_116=  for (i = 0; i < 50; i++) {
comp_117=    s = map(p) * .8;
comp_118=    ref += lights + 1./max(s, .01);
comp_119=    p += D * s;
comp_120=  }
comp_121=
comp_122=  o += o*ref;
comp_123=  // CONV: hue-preserving tone map. The old per-channel boost exp(float4(1e1,2,1,0)*d/5e2)
comp_124=  // scaled red, green and blue differently, so the colour of a spiral changed with distance;
comp_125=  // one shared boost only changes brightness (and fades to white), tanh keeps it in range.
comp_126=  o = tanh(max(o, 0.) / 1e9 * exp(2.0 * d / 5e2));
comp_127=  ret = o;
comp_128=}
comp_129=