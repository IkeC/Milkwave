MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// ProSureString + IkeC - cube go spinny / https://www.shadertoy.com/view/tcXyWX
comp_2=// Transpiled to HLSL using Milkwave
comp_3=
comp_4=#define tx sin(time)*0.2+1
comp_5=#define LOOPS 64
comp_6=
comp_7=float map(float3 p) {
comp_8=
comp_9=  float a = time+(sin(time*.3)*3.);
comp_10=  p.xy = tx*mul(p.xy, transpose(float2x2(cos(a), -sin(a), sin(a), cos(a))));
comp_11=  p.yz = tx*mul(p.yz, transpose(float2x2(cos(a), -sin(a), sin(a), cos(a))));
comp_12=  p.xz = tx*mul(p.xz, transpose(float2x2(cos(a), sin(a), -sin(a), cos(a))));
comp_13=
comp_14=  float bo = max(abs(p).x-.8, max(abs(p).y-.8, abs(p).z-.8));
comp_15=
comp_16=  return bo;
comp_17=  // max(-to,sp);//bo; //min(sp,bo);
comp_18=}
comp_19=
comp_20=float3 palette(float t){
comp_21=  return 0.35 + 0.5*cos(6.2831*(float3(0.3,0.5,0.7)*t + float3(0,0.2,0.4) * sin(time * .2)));
comp_22=}
comp_23=
comp_24=shader_body {
comp_25=  // MOUSE: pointer Y zooms - up = zoom in, down = zoom out (0.90x .. 1.30x around the frame centre);
comp_26=  // pointer X pans the view left/right. Centre + released button give the identity transform, so the
comp_27=  // untouched frame stays byte-identical.
comp_28=  float2 mwMouse = (mouse.xy - 0.5) * saturate(mouse.z);
comp_29=  float mwZoomAmt = mwMouse.y > 0.0 ? 0.6 : 0.2;   // zoom in generously, out carefully
comp_30=  float mwZoom = 1.0 + mwMouse.y * mwZoomAmt;
comp_31=  uv = (uv - 0.5) / mwZoom + 0.5 + float2(mwMouse.x * 0.35, 0.0);
comp_32=  float4 fragColor = 0;
comp_33=  // CONV: Center on screen, then try some aspect correction
comp_34=  uv = (uv*2) - 1;
comp_35=  uv *= aspect.xy;
comp_36=  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_37=  uv = float2(uv.x, -uv.y);
comp_38=
comp_39=  #ifdef bass_smooth
comp_40=    uv *= (int)vis_version > 2 ? 1*vis_intensity+vis_shift : (1-0.4*smoothstep(0,2,(int)vis_version == 1 ? bass_smooth : bass_att))*vis_intensity+vis_shift;
comp_41=  #else
comp_42=    uv *= 1-0.1*smoothstep(0,2,bass_att);
comp_43=  #endif
comp_44=
comp_45=  float3 ro = float3(0,0,-5.0);
comp_46=  float3 rd = normalize(float3(uv, 1.5));
comp_47=  float3 col = float3(0.0, 0.0, 0.0);
comp_48=
comp_49=  // float dis;
comp_50=
comp_51=  float t = 0.0;
comp_52=  for(float i=0.;i<LOOPS;i++){
comp_53=    float3 p = ro + rd * t;
comp_54=    float d = map(p);
comp_55=    if(d < 0.001) i=LOOPS;
comp_56=    else {
comp_57=      t += d * 0.7;
comp_58=      col += palette(t*0.1) / (d+0.9);
comp_59=    }
comp_60=  }
comp_61=
comp_62=  fragColor = float4(col/(10.0+col),1.0);
comp_63=  // fragColor = float4(pow(col, float3(-100000, -100000, -100000)),1.0); // gamma
comp_64=  ret = fragColor;
comp_65=}