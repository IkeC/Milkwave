MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// etrujillo + IkeC - Glassy with odd rotation / https://www.shadertoy.com/view/3XdXWX
comp_2=// Transpiled to HLSL using Milkwave
comp_3=
comp_4=#define tx sin(time)*0.5+1
comp_5=
comp_6=float map(float3 p) {
comp_7=  p = abs(frac(p) - 0.5);
comp_8=  return abs(min(length(p.xy) - 0.175, min(p.x, p.y) + 1e-3)) + 1e-3;
comp_9=}
comp_10=
comp_11=float3 estimateNormal(float3 p) {
comp_12=  float eps = 0.001;
comp_13=  return normalize(float3(
comp_14=  map(p + float3(eps, 0.0, 0.0)) - map(p - float3(eps, 0.0, 0.0)),
comp_15=  map(p + float3(0.0, eps, 0.0)) - map(p - float3(0.0, eps, 0.0)),
comp_16=  map(p + float3(0.0, 0.0, eps)) - map(p - float3(0.0, 0.0, eps))
comp_17=  ));
comp_18=}
comp_19=
comp_20=shader_body {
comp_21=  // MOUSE: pointer Y zooms - up = zoom in, down = zoom out (0.90x .. 1.30x around the frame centre);
comp_22=  // pointer X pans the view left/right. Centre + released button give the identity transform, so the
comp_23=  // untouched frame stays byte-identical.
comp_24=  float2 mwMouse = (mouse.xy - 0.5) * saturate(mouse.z);
comp_25=  float mwZoomAmt = mwMouse.y > 0.0 ? 0.6 : 0.2;   // zoom in generously, out carefully
comp_26=  float mwZoom = 1.0 + mwMouse.y * mwZoomAmt;
comp_27=  uv = (uv - 0.5) / mwZoom + 0.5 + float2(mwMouse.x * 0.35, 0.0);
comp_28=  float4 O = 0;
comp_29=  // CONV: Center on screen, then try some aspect correction
comp_30=  uv *= aspect.xy;
comp_31=  uv.x += -0.35;
comp_32=  uv.y += 0.1;
comp_33=
comp_34=  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_35=  uv = float2(uv.x, uv.y);
comp_36=
comp_37=  float2 C = uv;
comp_38=  float2 r = C;
comp_39=  r.x += 0.07; //0.08;
comp_40=  r.y += 0.15; //0.12;
comp_41=  C.y*=1.03;
comp_42=
comp_43=  float t = time;
comp_44=  float z = frac(dot(C, sin(C))) - 0.5;
comp_45=  float4 col = float4(0.0, 0.0, 0.0, 0.0);
comp_46=  float4 p;
comp_47=
comp_48=  for (float i = 0.0; i < 77.0; i++) {
comp_49=    // Ray direction
comp_50=    p = float4(-z * normalize(float3(C - 0.75 * r, r.y)), 0.1 * t);
comp_51=    p.z -= t;
comp_52=
comp_53=    // add some movement
comp_54=    float tf = time*0.1;
comp_55=    p.x += 0.2*sin(tf);
comp_56=    p.y += 0.1*sin(tf);
comp_57=
comp_58=    float4 q = p;
comp_59=
comp_60=    // Apply "bugged" rotation matrices for glitchy fractal distortion
comp_61=    p.xy = mul(p.xy, transpose(float2x2(cos(2.0 + q.z + float4(0,11,33,0)))));
comp_62=    p.xy = mul(p.xy, transpose(float2x2(cos(q + float4(0,11,33,0)))));
comp_63=
comp_64=    // Distance estimation
comp_65=    float d = map(p.xyz);
comp_66=
comp_67=    // Estimate lighting
comp_68=    float3 pos = p.xyz;
comp_69=    float3 lightDir = normalize(float3(0.3, 0.5, 1.0));
comp_70=    float3 viewDir = normalize(float3(uv.xy, 1.0));
comp_71=    float3 n = estimateNormal(pos);
comp_72=    float3 reflectDir = reflect(viewDir, n);
comp_73=
comp_74=    // Fake environment reflection (sky blue + fade to white)
comp_75=    float3 envColor = lerp(float3(0.8, 0.4, 0.8), float3(1,1,1), 0.5 + 0.5 * reflectDir.y);
comp_76=    
comp_77=
comp_78=    // Specular highlight
comp_79=    float spec = pow(max(dot(reflectDir, lightDir), 0.0), 32.0);
comp_80=
comp_81=    // Funky palette color using original method
comp_82=    float4 baseColor = (1.0 + sin(0.5 * q.z + length(p.xyz - q.xyz) + float4(0,4,3,6)))
comp_83=    / (0.5 + 2.0 * dot(q.xy, q.xy));
comp_84=
comp_85=    #ifdef bass_smooth
comp_86=      float fac = (int)vis_version > 2 ? 1+vis_intensity+vis_shift : (1 + 4*smoothstep(0,2,(int)vis_version == 1 ? bass_smooth : bass_att))*vis_intensity+vis_shift;
comp_87=    #else
comp_88=      float fac = 1 + 1*smoothstep(0,2,bass_att);
comp_89=    #endif
comp_90=
comp_91=    // Combine base color + environment reflection + specular highlight
comp_92=    float3 finalColor = baseColor.rgb * fac * 0.1 + envColor * 0.9 + float3(spec,spec,spec) * 1.2;
comp_93=
comp_94=    // Brightness weighted accumulation
comp_95=    col.rgb += finalColor / d;
comp_96=
comp_97=    z += 0.7 * d;
comp_98=  }
comp_99=
comp_100=  // Compress brightness range
comp_101=  ret = float4(tanh(col.rgb / 2e4), 1.0);
comp_102=}