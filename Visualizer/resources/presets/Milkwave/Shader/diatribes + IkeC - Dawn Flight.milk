MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// diatribes + IkeC - Dawn Flight / https://www.shadertoy.com/view/WXdGzn
comp_2=// Transpiled to HLSL using Milkwave
comp_3=
comp_4=#define tx sin(time)*0.5+1
comp_5=#define STEPS 64
comp_6=
comp_7=shader_body {
comp_8=  // MOUSE: pointer Y zooms - up = zoom in, down = zoom out (0.90x .. 1.30x around the frame centre);
comp_9=  // pointer X pans the view left/right. Centre + released button give the identity transform, so the
comp_10=  // untouched frame stays byte-identical.
comp_11=  float2 mwMouse = (mouse.xy - 0.5) * saturate(mouse.z);
comp_12=  float mwZoomAmt = mwMouse.y > 0.0 ? 0.6 : 0.2;   // zoom in generously, out carefully
comp_13=  float mwZoom = 1.0 + mwMouse.y * mwZoomAmt;
comp_14=  uv = (uv - 0.5) / mwZoom + 0.5 + float2(mwMouse.x * 0.35, 0.0);
comp_15=  float4 o = 0;
comp_16=  // CONV: Center on screen, then try some aspect correction
comp_17=  uv = uv*2-1;
comp_18=  uv *= aspect.xy;
comp_19=  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_20=  //uv = float2(uv.x, -uv.y);
comp_21=  float2 u = uv;
comp_22=
comp_23=  u.y+=-0.4;
comp_24=  
comp_25=  uv.x*=0.8;
comp_26=  uv.y+=-1.0;
comp_27=  
comp_28=  float T = time*2;
comp_29=  float i=0,d,s,t=T;
comp_30=  float3  q,p = float3(uv,1);
comp_31=  u = (u-p.xy/2.)/p.y;
comp_32=  
comp_33=  // sway camera side-to-side and up-and-down
comp_34=  
comp_35=  #ifdef bass_smooth
comp_36=    float fac = (int)vis_version > 2 ? 1*vis_intensity+vis_shift : (0.8+0.4*smoothstep(0,2,(int)vis_version == 1 ? bass_smooth : bass_att))*vis_intensity+vis_shift;
comp_37=  #else
comp_38=    float fac = 0.95+0.1*smoothstep(0,2,bass_att);
comp_39=  #endif
comp_40=  
comp_41=  u += float2(cos(t*.2)*.3, 0.5*fac*cos(t*.2)*.1);
comp_42=  
comp_43=  float f1 = 0.7;
comp_44=  
comp_45=  for(o*=i; i++<STEPS;
comp_46=  // min of cloud plane (8.-q.y) and terrain plane (2. + p.y)
comp_47=  d += s = f1 * min(.05+abs(8.-q.y)*.25, 2. + p.y) * .7,
comp_48=  // grayscale color, with minimum amount
comp_49=  o += max(s,.01))
comp_50=  // we're now in the above for-loop body
comp_51=  // march, float3(u*d,d+t),p.x+=t*2. is equivalent to
comp_52=  // p = ro + rd * d, p.x += t * 2., p.z += t;
comp_53=  // or march a step, move to the right, and move forward
comp_54=  for (q = p = float3(u*d,d+t),p.x+=t*2.,s = .04; s < 1.;
comp_55=  // we're in the noise loop now
comp_56=  // apply noise to the terrain plane
comp_57=  p += abs(dot(sin(p * s * 4.), p-p+.05)) / s,
comp_58=  // apply noise to the cloud plane
comp_59=  q += abs(dot(sin(t+q * s * 16.), p-p+.008)) / s,
comp_60=  // shift x because the noise has a directional bias,
comp_61=  // this just "un-does" the bias a bit
comp_62=  p.x++,
comp_63=  // grow noise by s += s
comp_64=  s += s);
comp_65=  // tanh is good easy tone mapping, multiply by color float4,
comp_66=  // divide down the brightness, add the sun ( / length(u))
comp_67=  o = tanh(float4(4,2,fac,1)*o*o / 1e4 / pow(length(u-.02),.5));
comp_68=  ret = o;
comp_69=}