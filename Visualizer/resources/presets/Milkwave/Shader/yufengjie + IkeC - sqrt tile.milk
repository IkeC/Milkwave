MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// yufengjie + IkeC - sqrt tile / https://www.shadertoy.com/view/wfSyDz
comp_2=// Transpiled to HLSL using Milkwave
comp_3=
comp_4=#define tx sin(time)*0.5+1
comp_5=#define T time
comp_6=
comp_7=shader_body {
comp_8=  // MOUSE: holding the right button tilts the scene, pointer X sets the angle. sin(0)=0 / cos(0)=1,
comp_9=  // so the frame without a pressed button stays byte-identical.
comp_10=  float mwTilt = (mouse.x - 0.5) * 0.5 * saturate(mouse.z);
comp_11=  float mwTiltS = sin(mwTilt), mwTiltC = cos(mwTilt);
comp_12=  uv = float2(uv.x * mwTiltC - uv.y * mwTiltS, uv.x * mwTiltS + uv.y * mwTiltC);
comp_13=  float4 O = 0;
comp_14=  float2 I = uv;
comp_15=  // CONV: Center on screen, then try some aspect correction
comp_16=  uv = (uv*2) - 1;
comp_17=  uv *= aspect.xy;
comp_18=  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_19=  uv = float2(uv.x, -uv.y);
comp_20=  uv *= 1.5;
comp_21=  uv.y+=0.09;
comp_22=
comp_23=  uv *= sin(time*0.1)*0.5+1;
comp_24=  //uv *= 0.3;
comp_25=
comp_26=  float2 R = uv.xy;
comp_27=  // float2 uv = (I*2.-R)/R.y;
comp_28=
comp_29=  O.rgb *= 0.;
comp_30=  O.a = 1.;
comp_31=
comp_32=  uv*=10.;
comp_33=  float2 id = floor(uv);
comp_34=  uv = frac(uv);
comp_35=  
comp_36=  #ifdef bass_smooth
comp_37=    float fac = (int)vis_version > 2 ? 1*vis_intensity+vis_shift : (0.85 + 0.3*smoothstep(0, 2, (int)vis_version == 1 ? bass_smooth : bass_att))*vis_intensity+vis_shift;
comp_38=  #else
comp_39=    float fac = 0.85 + 0.3*smoothstep(0, 2, bass_att);
comp_40=  #endif
comp_41=
comp_42=  float d = sqrt(10*uv.x*uv.y*(1.-uv.x)*(1.-uv.y));
comp_43=  float3 col = 1 + sin(float3(fac*3,2,1)+dot(id,id)*2.+T*4.);
comp_44=  O.rgb += col*d;
comp_45=  ret = O;
comp_46=}