MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// rucksack + IkeC - swirly curly braces / https://www.shadertoy.com/view/wf2cRm
comp_2=// Transpiled to HLSL using Milkwave
comp_3=
comp_4=#define tx sin(time)*0.5+1
comp_5=
comp_6=// 0.5 <= tx <= 1.5
comp_7=
comp_8=float tunnel(float3 p) {
comp_9=  return 1. - (length(p.xy) - .9);
comp_10=}
comp_11=
comp_12=float dist(float3 p) {
comp_13=  return tunnel(p);
comp_14=}
comp_15=
comp_16=shader_body {
comp_17=  // MOUSE: pointer Y zooms - up = zoom in, down = zoom out (0.90x .. 1.30x around the frame centre);
comp_18=  // pointer X pans the view left/right. Centre + released button give the identity transform, so the
comp_19=  // untouched frame stays byte-identical.
comp_20=  float2 mwMouse = (mouse.xy - 0.5) * saturate(mouse.z);
comp_21=  float mwZoomAmt = mwMouse.y > 0.0 ? 0.6 : 0.2;   // zoom in generously, out carefully
comp_22=  float mwZoom = 1.0 + mwMouse.y * mwZoomAmt;
comp_23=  uv = (uv - 0.5) / mwZoom + 0.5 + float2(mwMouse.x * 0.35, 0.0);
comp_24=  float4 fragColor = 0;
comp_25=  float2 fragCoord  = uv;
comp_26=  // CONV: Center on screen, then try some aspect correction
comp_27=  uv = (uv*2) - 1;
comp_28=  uv *= aspect.xy;
comp_29=  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_30=  uv = float2(uv.x, -uv.y);
comp_31=
comp_32=  // Normalized pixel coordinates (from 0 to 1)
comp_33=  // float2 uv = (fragCoord-.5*uv.xy)/uv.y;
comp_34=  float3 rd = normalize(float3(uv, 1.));
comp_35=
comp_36=  float t = time*.9;
comp_37=  float3 ro = float3(0, 0, t);
comp_38=
comp_39=  #ifdef bass_smooth
comp_40=    float fac = (int)vis_version > 2 ? 1*vis_intensity+vis_shift : (0.8+0.4*smoothstep(0,2,(int)vis_version == 1 ? bass_smooth : bass_att))*vis_intensity+vis_shift;
comp_41=  #else
comp_42=    float fac = 0.95+0.1*smoothstep(0,2,bass_att);
comp_43=  #endif
comp_44=  
comp_45=  float d = 0.;
comp_46=  float3 col = float3(0, 0, 0);
comp_47=  for (int i = 0; i < 100; i++) {
comp_48=    float3 p = ro + rd*d;
comp_49=
comp_50=    // Warp
comp_51=    for (float s = 1.; s < 2.; s *= 1.39)
comp_52=    p += sin(t + p.zyx*3.)*.2;
comp_53=
comp_54=    // Translucent step
comp_55=    float dd = .005 + abs(dist(p)) * .15;
comp_56=    d += dd;
comp_57=
comp_58=    // funky color stuff
comp_59=    // so it just offsets each color component
comp_60=    // then puts it through cos to wrap it
comp_61=    float3 phase_offset = float3(fac*3,1.9,0.1);
comp_62=    col += (1. + cos(d+phase_offset)) / dd;
comp_63=  }
comp_64=
comp_65=  // and then back from cos space I suppose
comp_66=  col = tanh(col / 3000.);
comp_67=  // tried
comp_68=  // col *= .0001;
comp_69=  // and that just makes very dark version that looks worse
comp_70=
comp_71=  // Output gamma corrected
comp_72=  fragColor = float4(pow(col, float3(2.2, 2.2, 2.2)),1.0);
comp_73=  ret = fragColor;
comp_74=}