MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// Shane - Mandelbrot Pattern Decoration / https://www.shadertoy.com/view/ttscWn
comp_2=// License: Creative Commons Attribution-NonCommercial-ShareAlike 3.0 (Shadertoy default)
comp_3=// Transpiled to HLSL using Milkwave
comp_4=
comp_5=// CONV: adding helper functions
comp_6=float mod_conv(float x, float y) { return x - y * floor(x / y); }
comp_7=float2 mod_conv(float2 x, float2 y) { return x - y * floor(x / y); }
comp_8=
comp_9=// CONV2: guarded length helpers (legacy compiler reports lenv() as division by zero)
comp_10=float lenv(float2 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_11=float lenv(float3 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_12=
comp_13=shader_body {
comp_14=  float2 fragCoord = float2(uv.x*texsize.x, (1.-uv.y)*texsize.y);
comp_15=  float3 col = 0;
comp_16=
comp_17=  // decoration grid: cells per unit, breathes with the high end
comp_18=  float gsz = 8.;
comp_19=  #ifdef bass_smooth
comp_20=    if ((int)vis_version == 1)      gsz *= 1. + 0.30*(smoothstep(0, 2, treb_smooth) - 0.5)*vis_intensity + vis_shift;
comp_21=    else if ((int)vis_version == 2) gsz *= 1. + 0.50*(smoothstep(0, 2, treb_att) - 0.5)*vis_intensity + vis_shift;
comp_22=    else                            gsz *= 1. + 0.0*vis_intensity + vis_shift;
comp_23=  #else
comp_24=    gsz *= 1. + 0.20*(smoothstep(0, 2, treb_att) - 0.5);
comp_25=  #endif
comp_26=
comp_27=  // layer colour gain, lifts with the low end
comp_28=  float cgain = 1.;
comp_29=  #ifdef bass_smooth
comp_30=    if ((int)vis_version == 1)      cgain += 0.12*(smoothstep(0, 2, bass_smooth) - 0.5)*vis_intensity + vis_shift;
comp_31=    else if ((int)vis_version == 2) cgain += 0.20*(smoothstep(0, 2, bass_att) - 0.5)*vis_intensity + vis_shift;
comp_32=    else                            cgain += 0.0*vis_intensity + vis_shift;
comp_33=  #else
comp_34=    cgain += 0.10*(smoothstep(0, 2, bass_att) - 0.5);
comp_35=  #endif
comp_36=
comp_37=  #define AA 2
comp_38=  // MOUSE: holding the button drags the fractal canvas - pointer X turns it, pointer Y pans it.
comp_39=  // At zero rotation/pan both transforms are exact identities, so the un-pressed frame is unchanged.
comp_40=  float2 mMouse = (mouse.xy - 0.5) * saturate(mouse.z);
comp_41=  float mAng = mMouse.x * 0.5;                 // +-0.25 rad at full pointer travel
comp_42=  float2 mShift = float2(mMouse.y * 0.6, mMouse.y * 0.3);   // +-0.3 / +-0.15 in canvas units
comp_43=  float2x2 mMat = float2x2(cos(mAng), sin(mAng), -sin(mAng), cos(mAng));
comp_44=  for (int j = 0; j < AA; j++) {
comp_45=    for (int i = 0; i < AA; i++) {
comp_46=
comp_47=      // Offset centered coordinate, standard AA
comp_48=      float2 p = (fragCoord + float2(i, j)/float(AA) - texsize.xy*.5)/texsize.y;
comp_49=
comp_50=      // time, rotating back and forth
comp_51=      float ttm = cos(sin(time/8.))*6.2831;
comp_52=
comp_53=      // rotate and translate the canvas
comp_54=      p = mul(p, transpose(float2x2(cos(ttm), sin(ttm), -sin(ttm), cos(ttm))));
comp_55=      p -= float2(cos(time/2.)/2., sin(time/3.)/5.);
comp_56=      // MOUSE: turn and pan on top of the automatic canvas motion
comp_57=      p = mul(p, transpose(mMat));
comp_58=      p += mShift;
comp_59=
comp_60=      // jump off point and zoom
comp_61=      float zm = (200. + sin(time/7.)*50.);
comp_62=      float2 cc = float2(-.57735 + .004, .57735) + p/zm;
comp_63=
comp_64=      float2 z = 0, dz = 0;
comp_65=      int iter = 128;
comp_66=      int ik = iter;   // bail out value
comp_67=      float3 fog = 0;
comp_68=
comp_69=      for (int k = 0; k < iter; k++) {
comp_70=        // derivative z' = 2*z*z' + 1, position z = z*z + c (complex, written out)
comp_71=        dz = float2(z.x*dz.x - z.y*dz.y, z.x*dz.y + z.y*dz.x)*2. + float2(1, 0);
comp_72=        z = float2(z.x*z.x - z.y*z.y, 2.*z.x*z.y) + cc;
comp_73=
comp_74=        // out of bounds: record the break number and leave the loop
comp_75=        if (dot(z, z) > 1./.005) {
comp_76=          ik = k;
comp_77=          k = iter;      // ps_3_0 has no break
comp_78=        }
comp_79=      }
comp_80=
comp_81=      float ln = step(0., lenv(z)/15.5 - 1.);
comp_82=
comp_83=      // distance shading, smooth colouring via log
comp_84=      float d = sqrt(1./max(lenv(dz), .0001))*log(dot(z, z));
comp_85=      d = clamp(d*50., 0., 1.);
comp_86=
comp_87=      // flag successive layers
comp_88=      float dir = mod_conv(float(ik), 2.) < .5 ? -1. : 1.;
comp_89=
comp_90=      float sh = (float(iter - ik))/float(iter);
comp_91=      float2 tuv = z/320.;
comp_92=
comp_93=      // rotate the repeat coordinates for parallax
comp_94=      float tm = (-ttm*sh*sh*16.);
comp_95=      tuv = mul(tuv, transpose(float2x2(cos(tm), sin(tm), -sin(tm), cos(tm))));
comp_96=      tuv = abs(mod_conv(tuv, 1./gsz) - 1./(2.*gsz));
comp_97=
comp_98=      // grid of circles plus grid boundaries
comp_99=      float pat = smoothstep(0., 1./lenv(dz), lenv(tuv) - 1./(4.*gsz));
comp_100=      pat = min(pat, smoothstep(0., 1./lenv(dz), abs(max(tuv.x, tuv.y) - 1./(2.*gsz)) - .04/(2.*gsz)));
comp_101=
comp_102=      // layer colour from the shaded distance
comp_103=      float3 lCol = pow(min(float3(1.5, 1, 1)*min(d*.85, .96), 1.), float3(1, 3, 16))*1.15;
comp_104=      lCol = dir < .0 ? lCol*min(pat, ln) : (sqrt(lCol)*.5 + .7)*max(1. - pat, 1. - ln);
comp_105=      lCol *= cgain;
comp_106=
comp_107=      // fake reflection for the highlights
comp_108=      float3 rd = normalize(float3(p, 1.));
comp_109=      rd = reflect(rd, float3(0, 0, -1));
comp_110=      float diff = clamp(dot(z*.5 + .5, rd.xy), 0., 1.)*d;
comp_111=
comp_112=      // offset reflective pattern
comp_113=      tuv = z/200.;
comp_114=      tm = -tm/1.5 + .5;
comp_115=      tuv = mul(tuv, transpose(float2x2(cos(tm), sin(tm), -sin(tm), cos(tm))));
comp_116=      tuv = abs(mod_conv(tuv, 1./gsz) - 1./(2.*gsz));
comp_117=      pat = smoothstep(0., 1./lenv(dz), lenv(tuv) - 1./(4.*gsz));
comp_118=      pat = min(pat, smoothstep(0., 1./lenv(dz), abs(max(tuv.x, tuv.y) - 1./(2.*gsz)) - .04/(2.*gsz)));
comp_119=
comp_120=      // add the gloss
comp_121=      lCol += lerp(lCol, float3(1, 1, 1)*ln, .5)*diff*diff*.5*(pat*.6 + .6);
comp_122=
comp_123=      // swizzle the colour on every sixth layer
comp_124=      if (mod_conv(float(ik), 6.) < .5) lCol = lCol.yxz;
comp_125=      lCol = lerp(lCol.xzy, lCol, d/1.2);
comp_126=
comp_127=      // dark fringes on the layers for depth
comp_128=      lCol = lerp(lCol, float3(0, 0, 0), (1. - step(0., -(lenv(z)*.05*float(ik)/float(iter) - 1.)))*.95);
comp_129=
comp_130=      // fog
comp_131=      lCol = lerp(fog, lCol, sh*d);
comp_132=
comp_133=      col += min(lCol, 1.);
comp_134=    }
comp_135=  }
comp_136=
comp_137=  col /= float(AA*AA);
comp_138=
comp_139=  // subtle vignette
comp_140=  col *= pow(16.*(1. - uv.x)*(1. - uv.y)*uv.x*uv.y, 1./8.)*1.15;
comp_141=
comp_142=  ret = float4(sqrt(max(col, 0.)), 1.0);
comp_143=}