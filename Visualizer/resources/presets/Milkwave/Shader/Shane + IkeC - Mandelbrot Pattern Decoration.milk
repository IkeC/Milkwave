MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// Shane - Mandelbrot Pattern Decoration / https://www.shadertoy.com/view/ttscWn
comp_2=// License: Creative Commons Attribution-NonCommercial-ShareAlike 3.0 (Shadertoy default)
comp_3=// Transpiled to HLSL using Milkwave
comp_4=
comp_5=// CONV: adding helper functions
comp_6=float mod_conv(float x, float y) { return x - y * floor(x / y); }
comp_7=float2 mod_conv(float2 x, float2 y) { return x - y * floor(x / y); }
comp_8=
comp_9=// CONV2: guarded length helpers (legacy compiler reports lenv() as division by zero)
comp_10=float lenv(float2 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_11=float lenv(float3 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_12=
comp_13=shader_body {
comp_14=  // MOUSE: pointer Y zooms - up = zoom in, down = zoom out (0.90x .. 1.30x around the frame centre);
comp_15=  // pointer X pans the view left/right. Centre + released button give the identity transform, so the
comp_16=  // untouched frame stays byte-identical.
comp_17=  float2 mwMouse = (mouse.xy - 0.5) * saturate(mouse.z);
comp_18=  float mwZoomAmt = mwMouse.y > 0.0 ? 0.6 : 0.2;   // zoom in generously, out carefully
comp_19=  float mwZoom = 1.0 + mwMouse.y * mwZoomAmt;
comp_20=  uv = (uv - 0.5) / mwZoom + 0.5 + float2(mwMouse.x * 0.35, 0.0);
comp_21=  float4 mwDead = float4(0.5, 0.5, 0.0, 0.0);   // superseded: the old mouse code below now reads a centred, released pointer
comp_22=
comp_23=  float2 fragCoord = float2(uv.x*texsize.x, (1.-uv.y)*texsize.y);
comp_24=  float3 col = 0;
comp_25=
comp_26=  // decoration grid: cells per unit, breathes with the high end
comp_27=  float gsz = 8.;
comp_28=  #ifdef bass_smooth
comp_29=    if ((int)vis_version == 1)      gsz *= 1. + 0.30*(smoothstep(0, 2, treb_smooth) - 0.5)*vis_intensity + vis_shift;
comp_30=    else if ((int)vis_version == 2) gsz *= 1. + 0.50*(smoothstep(0, 2, treb_att) - 0.5)*vis_intensity + vis_shift;
comp_31=    else                            gsz *= 1. + 0.0*vis_intensity + vis_shift;
comp_32=  #else
comp_33=    gsz *= 1. + 0.20*(smoothstep(0, 2, treb_att) - 0.5);
comp_34=  #endif
comp_35=
comp_36=  // layer colour gain, lifts with the low end
comp_37=  float cgain = 1.;
comp_38=  #ifdef bass_smooth
comp_39=    if ((int)vis_version == 1)      cgain += 0.12*(smoothstep(0, 2, bass_smooth) - 0.5)*vis_intensity + vis_shift;
comp_40=    else if ((int)vis_version == 2) cgain += 0.20*(smoothstep(0, 2, bass_att) - 0.5)*vis_intensity + vis_shift;
comp_41=    else                            cgain += 0.0*vis_intensity + vis_shift;
comp_42=  #else
comp_43=    cgain += 0.10*(smoothstep(0, 2, bass_att) - 0.5);
comp_44=  #endif
comp_45=
comp_46=  #define AA 2
comp_47=  // MOUSE: holding the button drags the fractal canvas - pointer X turns it, pointer Y pans it.
comp_48=  // At zero rotation/pan both transforms are exact identities, so the un-pressed frame is unchanged.
comp_49=  float2 mMouse = (mwDead.xy - 0.5) * saturate(mwDead.z);
comp_50=  float mAng = mMouse.x * 0.5;                 // +-0.25 rad at full pointer travel
comp_51=  float2 mShift = float2(mMouse.y * 0.6, mMouse.y * 0.3);   // +-0.3 / +-0.15 in canvas units
comp_52=  float2x2 mMat = float2x2(cos(mAng), sin(mAng), -sin(mAng), cos(mAng));
comp_53=  for (int j = 0; j < AA; j++) {
comp_54=    for (int i = 0; i < AA; i++) {
comp_55=
comp_56=      // Offset centered coordinate, standard AA
comp_57=      float2 p = (fragCoord + float2(i, j)/float(AA) - texsize.xy*.5)/texsize.y;
comp_58=
comp_59=      // time, rotating back and forth
comp_60=      float ttm = cos(sin(time/8.))*6.2831;
comp_61=
comp_62=      // rotate and translate the canvas
comp_63=      p = mul(p, transpose(float2x2(cos(ttm), sin(ttm), -sin(ttm), cos(ttm))));
comp_64=      p -= float2(cos(time/2.)/2., sin(time/3.)/5.);
comp_65=      // MOUSE: turn and pan on top of the automatic canvas motion
comp_66=      p = mul(p, transpose(mMat));
comp_67=      p += mShift;
comp_68=
comp_69=      // jump off point and zoom
comp_70=      float zm = (200. + sin(time/7.)*50.);
comp_71=      float2 cc = float2(-.57735 + .004, .57735) + p/zm;
comp_72=
comp_73=      float2 z = 0, dz = 0;
comp_74=      int iter = 128;
comp_75=      int ik = iter;   // bail out value
comp_76=      float3 fog = 0;
comp_77=
comp_78=      for (int k = 0; k < iter; k++) {
comp_79=        // derivative z' = 2*z*z' + 1, position z = z*z + c (complex, written out)
comp_80=        dz = float2(z.x*dz.x - z.y*dz.y, z.x*dz.y + z.y*dz.x)*2. + float2(1, 0);
comp_81=        z = float2(z.x*z.x - z.y*z.y, 2.*z.x*z.y) + cc;
comp_82=
comp_83=        // out of bounds: record the break number and leave the loop
comp_84=        if (dot(z, z) > 1./.005) {
comp_85=          ik = k;
comp_86=          k = iter;      // ps_3_0 has no break
comp_87=        }
comp_88=      }
comp_89=
comp_90=      float ln = step(0., lenv(z)/15.5 - 1.);
comp_91=
comp_92=      // distance shading, smooth colouring via log
comp_93=      float d = sqrt(1./max(lenv(dz), .0001))*log(dot(z, z));
comp_94=      d = clamp(d*50., 0., 1.);
comp_95=
comp_96=      // flag successive layers
comp_97=      float dir = mod_conv(float(ik), 2.) < .5 ? -1. : 1.;
comp_98=
comp_99=      float sh = (float(iter - ik))/float(iter);
comp_100=      float2 tuv = z/320.;
comp_101=
comp_102=      // rotate the repeat coordinates for parallax
comp_103=      float tm = (-ttm*sh*sh*16.);
comp_104=      tuv = mul(tuv, transpose(float2x2(cos(tm), sin(tm), -sin(tm), cos(tm))));
comp_105=      tuv = abs(mod_conv(tuv, 1./gsz) - 1./(2.*gsz));
comp_106=
comp_107=      // grid of circles plus grid boundaries
comp_108=      float pat = smoothstep(0., 1./lenv(dz), lenv(tuv) - 1./(4.*gsz));
comp_109=      pat = min(pat, smoothstep(0., 1./lenv(dz), abs(max(tuv.x, tuv.y) - 1./(2.*gsz)) - .04/(2.*gsz)));
comp_110=
comp_111=      // layer colour from the shaded distance
comp_112=      float3 lCol = pow(min(float3(1.5, 1, 1)*min(d*.85, .96), 1.), float3(1, 3, 16))*1.15;
comp_113=      lCol = dir < .0 ? lCol*min(pat, ln) : (sqrt(lCol)*.5 + .7)*max(1. - pat, 1. - ln);
comp_114=      lCol *= cgain;
comp_115=
comp_116=      // fake reflection for the highlights
comp_117=      float3 rd = normalize(float3(p, 1.));
comp_118=      rd = reflect(rd, float3(0, 0, -1));
comp_119=      float diff = clamp(dot(z*.5 + .5, rd.xy), 0., 1.)*d;
comp_120=
comp_121=      // offset reflective pattern
comp_122=      tuv = z/200.;
comp_123=      tm = -tm/1.5 + .5;
comp_124=      tuv = mul(tuv, transpose(float2x2(cos(tm), sin(tm), -sin(tm), cos(tm))));
comp_125=      tuv = abs(mod_conv(tuv, 1./gsz) - 1./(2.*gsz));
comp_126=      pat = smoothstep(0., 1./lenv(dz), lenv(tuv) - 1./(4.*gsz));
comp_127=      pat = min(pat, smoothstep(0., 1./lenv(dz), abs(max(tuv.x, tuv.y) - 1./(2.*gsz)) - .04/(2.*gsz)));
comp_128=
comp_129=      // add the gloss
comp_130=      lCol += lerp(lCol, float3(1, 1, 1)*ln, .5)*diff*diff*.5*(pat*.6 + .6);
comp_131=
comp_132=      // swizzle the colour on every sixth layer
comp_133=      if (mod_conv(float(ik), 6.) < .5) lCol = lCol.yxz;
comp_134=      lCol = lerp(lCol.xzy, lCol, d/1.2);
comp_135=
comp_136=      // dark fringes on the layers for depth
comp_137=      lCol = lerp(lCol, float3(0, 0, 0), (1. - step(0., -(lenv(z)*.05*float(ik)/float(iter) - 1.)))*.95);
comp_138=
comp_139=      // fog
comp_140=      lCol = lerp(fog, lCol, sh*d);
comp_141=
comp_142=      col += min(lCol, 1.);
comp_143=    }
comp_144=  }
comp_145=
comp_146=  col /= float(AA*AA);
comp_147=
comp_148=  // subtle vignette
comp_149=  col *= pow(16.*(1. - uv.x)*(1. - uv.y)*uv.x*uv.y, 1./8.)*1.15;
comp_150=
comp_151=  ret = float4(sqrt(max(col, 0.)), 1.0);
comp_152=}