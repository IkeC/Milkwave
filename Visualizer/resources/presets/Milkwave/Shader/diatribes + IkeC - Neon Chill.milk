MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// diatribes + IkeC - Neon Chill / https://www.shadertoy.com/view/tcXfW8
comp_2=// Transpiled to HLSL using Milkwave
comp_3=
comp_4=shader_body {
comp_5=  // MOUSE: pointer Y zooms - up = zoom in, down = zoom out (0.90x .. 1.30x around the frame centre);
comp_6=  // pointer X pans the view left/right. Centre + released button give the identity transform, so the
comp_7=  // untouched frame stays byte-identical.
comp_8=  float2 mwMouse = (mouse.xy - 0.5) * saturate(mouse.z);
comp_9=  float mwZoomAmt = mwMouse.y > 0.0 ? 0.6 : 0.2;   // zoom in generously, out carefully
comp_10=  float mwZoom = 1.0 + mwMouse.y * mwZoomAmt;
comp_11=  uv = (uv - 0.5) / mwZoom + 0.5 + float2(mwMouse.x * 0.35, 0.0);
comp_12=  float4 o = 0;
comp_13=  uv = (uv*2) - 1;
comp_14=  uv *= aspect.xy;
comp_15=  uv = float2(uv.x, -uv.y);
comp_16=
comp_17=  // zoom in and out over time
comp_18=  uv*=sin(time*0.2)*0.4+1.2;
comp_19=
comp_20=  float2 u = uv;
comp_21=  float t=time * .2;
comp_22=  float3  p = float3(uv,1);
comp_23=  // u =(u+u-p.xy)/p.y;
comp_24=  u = mul(u, transpose(float2x2(cos(length(u*3.5)+float4(0,33,11,0)))));
comp_25=
comp_26=  // tanh doesn't work so well in HLSL/Milkwave, so we're using an alternative (see below)
comp_27=  /*
comp_28=  o  = tanh((float4(.5,.1,2,0)/(.001*length(u.x+sin(8. *t-u.y*1.)*.1))
comp_29=  +  float4( 1,.1,0,0)/(.002*length(u.x+sin(4. *t-u.y*2.)*.2))
comp_30=  +  float4( 1,.6,0,0)/(.003*length(u.x+sin(3. *t-u.y*4.)*.3))
comp_31=  +  float4( 1, 2,0,0)/(.004*length(u.x+sin(2. *t-u.y*8.)*.4)))
comp_32=  /2e4);
comp_33=  */
comp_34=
comp_35=  float shift1 = 0, shift2 = 0, shift3 = 0, shift4 = 0; 
comp_36=  #ifdef bass_smooth
comp_37=    if (vis_version == 1) {
comp_38=      shift1 = (-0.5+smoothstep(0,2,bass_smooth))*vis_intensity+vis_shift;
comp_39=      shift2 = (-0.5+smoothstep(0,2,mid_smooth))*vis_intensity+vis_shift;
comp_40=      shift3 = (-0.5+smoothstep(0,2,treb_smooth))*vis_intensity+vis_shift;
comp_41=      shift4 = (-0.5+smoothstep(0,2,vol_smooth))*vis_intensity+vis_shift;
comp_42=    } 
comp_43=    else if (vis_version == 2) {
comp_44=      shift1 = 0.4*smoothstep(0,2,bass_att)*vis_intensity+vis_shift;
comp_45=      shift2 = 0.4*smoothstep(0,2,mid_att)*vis_intensity+vis_shift;
comp_46=      shift3 = 0.4*smoothstep(0,2,treb_att)*vis_intensity+vis_shift;
comp_47=      shift4 = 0.4*smoothstep(0,2,vol_att)*vis_intensity+vis_shift;
comp_48=    }
comp_49=    else {
comp_50=      shift1 = shift2 = shift3 = shift4 = (-1+vis_intensity)+vis_shift;
comp_51=    }
comp_52=  #else
comp_53=    shift1 = 0.4*smoothstep(0,2,bass_att);
comp_54=    shift2 = 0.4*smoothstep(0,2,mid_att);
comp_55=    shift3 = 0.4*smoothstep(0,2,treb_att);
comp_56=    shift4 = 0.4*smoothstep(0,2,vol_att);
comp_57=  #endif
comp_58=  
comp_59=  float4 x = (
comp_60=  float4(0.5+shift1, 0.1, 2, 0) / (0.001 * length(u.x + sin(8.0 * t - u.y * 1.0) * 0.1)) +
comp_61=  float4(1.0+shift2, 0.1, 0, 0) / (0.002 * length(u.x + sin(4.0 * t - u.y * 2.0) * 0.2)) +
comp_62=  float4(1.0, 0.6-shift3, 0, 0) / (0.003 * length(u.x + sin(3.0 * t - u.y * 4.0) * 0.3)) +
comp_63=  float4(1.0, 2.0, shift4, 0) / (0.004 * length(u.x + sin(2.0 * t - u.y * 8.0) * 0.4))
comp_64=  ) / 20000.0;
comp_65=
comp_66=  o = (2.0 / (1.0 + exp(-2.0 * x))) - 1.0;
comp_67=
comp_68=  ret = o;
comp_69=}