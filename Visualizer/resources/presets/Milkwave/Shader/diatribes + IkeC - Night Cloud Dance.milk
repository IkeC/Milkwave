MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// diatribes + IkeC - Night Cloud Dance / https://www.shadertoy.com/view/3cjcWD
comp_2=// Transpiled to HLSL using Milkwave
comp_3=
comp_4=#define tx sin(time)*0.5+1
comp_5=// 0.5 <= tx <= 1.5
comp_6=
comp_7=shader_body {
comp_8=  // MOUSE: pointer Y zooms - up = zoom in, down = zoom out (0.90x .. 1.30x around the frame centre);
comp_9=  // pointer X pans the view left/right. Centre + released button give the identity transform, so the
comp_10=  // untouched frame stays byte-identical.
comp_11=  float2 mwMouse = (mouse.xy - 0.5) * saturate(mouse.z);
comp_12=  float mwZoomAmt = mwMouse.y > 0.0 ? 0.6 : 0.2;   // zoom in generously, out carefully
comp_13=  float mwZoom = 1.0 + mwMouse.y * mwZoomAmt;
comp_14=  uv = (uv - 0.5) / mwZoom + 0.5 + float2(mwMouse.x * 0.35, 0.0);
comp_15=  float4 o = 0;
comp_16=  // CONV: Center on screen, then try some aspect correction
comp_17=  uv = (uv*2) - 1;
comp_18=  uv *= aspect.xy;
comp_19=  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_20=  uv = float2(uv.x, -uv.y);
comp_21=  uv*=1.3;
comp_22=  float2 u = uv;
comp_23=
comp_24=  float d,a,e,i=0,s,t = time*.5;
comp_25=  float3  ep, p = float3(uv.x, uv.y, 0);
comp_26=
comp_27=
comp_28=  // scale coords
comp_29=  //u = (u+u-p.xy)/p.y;
comp_30=  
comp_31=  u += float2(cos(t*.4)*.3, cos(t*.8)*.1);
comp_32=  
comp_33=  #ifdef bass_smooth
comp_34=    float fac = (int)vis_version > 2 ? 0.8-0.1*vis_intensity+vis_shift : (0.9-0.5*smoothstep(0,2,(int)vis_version == 1 ? bass_smooth : bass_att))*vis_intensity+vis_shift;
comp_35=  #else
comp_36=    float fac = 0.8-0.1*smoothstep(0,2,bass_att);
comp_37=  #endif
comp_38=
comp_39=  for(o*=i; i++<1e2;
comp_40=
comp_41=  // accumulate distance
comp_42=  d += s = min(.02+.6*abs(s),e=max(.8*e, .01)),
comp_43=
comp_44=  // grayscale color
comp_45=  o += 1./(s+e*2.))
comp_46=
comp_47=  // noise loop start, march
comp_48=  for (p = float3(u*d,d+t),
comp_49=  // p = ro + rd *d, p.z + t;
comp_50=
comp_51=  // entity (orb) position
comp_52=  ep = p - float3(
comp_53=  sin(sin(t)+t*.4) * 8.,
comp_54=  sin(sin(t)+t*.2) *2.,
comp_55=  16.+t+cos(t)*8.),
comp_56=
comp_57=  // orb sphere
comp_58=  e = 2 * length(ep) +.2,
comp_59=
comp_60=  // plane, mix with entity/orb
comp_61=  s = lerp(e*.02,4.+p.y, smoothstep(0., 12., length(ep))),
comp_62=
comp_63=  // noise params
comp_64=  a = .4; a < 8.; a *= 1.4)
comp_65=
comp_66=  // apply noise
comp_67=  s -= abs(dot(cos(t+.2*p.z+p * a ), .11+p-p)) / a;
comp_68=
comp_69=  // tanh tonemap, blue tint, brightness, moon
comp_70=  o = tanh(float4(1,fac*2,6,0)*o/1e1/length(u-.65));
comp_71=  ret = o;
comp_72=}