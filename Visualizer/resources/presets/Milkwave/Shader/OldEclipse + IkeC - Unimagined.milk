MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// OldEclipse - Unimagined / https://www.shadertoy.com/view/NflSD8
comp_2=// License: Creative Commons Attribution-NonCommercial-ShareAlike 3.0 (Shadertoy default)
comp_3=// Transpiled to HLSL using Milkwave
comp_4=
comp_5=#define tx (sin(time)*0.5+1)
comp_6=
comp_7=// CONV: adding helper functions
comp_8=float mod_conv(float x, float y) { return x - y * floor(x / y); }
comp_9=float2 mod_conv(float2 x, float2 y) { return x - y * floor(x / y); }
comp_10=float3 mod_conv(float3 x, float3 y) { return x - y * floor(x / y); }
comp_11=float4 mod_conv(float4 x, float4 y) { return x - y * floor(x / y); }
comp_12=
comp_13=// CONV2: guarded length helpers (legacy compiler reports lenv() as division by zero)
comp_14=float lenv(float2 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_15=float lenv(float3 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_16=float lenv(float4 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_17=
comp_18=shader_body {
comp_19=  float4 O = 0;
comp_20=  float2 I  = uv;
comp_21=  // CONV: Center on screen, then try some aspect correction
comp_22=  uv = (uv*2) - 1;
comp_23=  uv *= aspect.xy;
comp_24=  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_25=  uv = float2(uv.x, -uv.y);
comp_26=  // CONV: Adjust viewpoint (x,y individually or both)
comp_27=  uv += float2(0,0) + 0;
comp_28=  uv *= float2(1,1) * 1;
comp_29=
comp_30=  // AUDIO: 1 = calm (bass_smooth), 2 = more reactive (bass_att), 3+ = static - see the remote's Version tooltip
comp_31=#ifdef bass_smooth
comp_32=  float aRng = (int)vis_version == 1 ? 0.34 : 0.45;
comp_33=  float aFac = (int)vis_version > 2 ? 1*vis_intensity+vis_shift
comp_34=    : (1.0 - aRng*0.5 + smoothstep(0,2,(int)vis_version == 1 ? bass_smooth : bass_att)*aRng) * vis_intensity + vis_shift;
comp_35=#else
comp_36=  float aFac = (1.0 - 0.15) + smoothstep(0,2,bass_att)*0.30;
comp_37=#endif
comp_38=  float aDev = aFac - 1.0;   // 0 at the track average, +loud, -quiet
comp_39=  // AUDIO: v1 needs bigger multipliers - its bass_smooth band is an averaged value
comp_40=  float aCol = (int)vis_version == 1 ? 1.1 : 1.3;   // colour reaction scale
comp_41=  float aMorp = (int)vis_version == 1 ? 0.45 : 0.25;  // shape morph reaction scale
comp_42=
comp_43=  // Ray direction for this pixel (constant across the march) and the MOUSE camera turn:
comp_44=  // holding the button rotates the ray away from the base view, pointer X = yaw, pointer Y = pitch.
comp_45=  // At zero rotation the ray is bit-identical to the untouched one.
comp_46=  float2 fc = float2(I.x, 1.0 - I.y) * texsize.xy;   // CONV: Shadertoy fragCoord is in pixels, y up
comp_47=  float3 rd = normalize(float3(fc + fc, 1) - texsize.xyy);
comp_48=  float2 mRot = (mouse.xy - 0.5) * saturate(mouse.z) * float2(1.0, 0.6);
comp_49=  float mCy = cos(mRot.x), mSy = sin(mRot.x);
comp_50=  rd.xz = float2(rd.x * mCy - rd.z * mSy, rd.x * mSy + rd.z * mCy);
comp_51=  float mCp = cos(mRot.y), mSp = sin(mRot.y);
comp_52=  rd.yz = float2(rd.y * mCp - rd.z * mSp, rd.y * mSp + rd.z * mCp);
comp_53=
comp_54=  // Iterator, distance travelled, density
comp_55=  float i = 0., t = 0., v = 0.;
comp_56=  // Raymarching loop
comp_57=  O *= i;
comp_58=  for (i = 0.; i < 50.; i++) {
comp_59=    float3 p = t * rd;
comp_60=    // Rotation of xy coordinates based on distance travelled
comp_61=    float rot = t*.15;
comp_62=    // CONV: the original is p.xy *= mat2(cos(rot+vec4(0,11,33,0))); the transpiler emitted
comp_63=    // cos(ang) for the rot+0 term, and `ang` is an unrelated wrapper uniform, which skewed the
comp_64=    // matrix and squashed the whole image
comp_65=    p.xy = float2(p.x*cos(rot) + p.y*cos(rot+11.), p.x*cos(rot+33.) + p.y*cos(rot));
comp_66=    // Move forward
comp_67=    p.z-=time;
comp_68=    // Coordinate repetition
comp_69=    p=mod_conv(p,4.)-2.;
comp_70=    // Density from mix between sphere and line sdf based on distance travelled
comp_71=    v = lerp(abs(lenv(p)-1.),lenv(p.xz),saturate(.5-.5*cos(t) + aDev*aMorp))+.01;   // AUDIO: morph bias between the two sdfs (saturated: a negative blend weight would make the density negative)
comp_72=    // Travel forwards based on density
comp_73=    t+=v*.3;
comp_74=    // Color accumulation based on density and distance travelled
comp_75=    O+=exp(sin(t+float4(0,2,4,0) + aDev*aCol*1.2))/v;   // AUDIO: the colour phase follows the level
comp_76=  }
comp_77=
comp_78=  // Tone mapping (max: a negative accumulator would tone-map to black)
comp_79=  O = tanh(max(O, 0.)/2e2);
comp_80=  ret = O;
comp_81=}