MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// paranoidray + IkeC - String Theory 2 / https://www.shadertoy.com/view/33sSzf
comp_2=// Transpiled to HLSL using Milkwave
comp_3=
comp_4=// original code from XorDev all credit belongs to him!
comp_5=// https://x.com/XorDev/status/1914698293554139442
comp_6=// https://twigl.app?ol=true&ss=-OOTrxZCfc7skbElm-8u
comp_7=
comp_8=#define tx sin(time)*0.5+1
comp_9=
comp_10=shader_body {
comp_11=  // MOUSE: pointer Y zooms - up = zoom in, down = zoom out (0.90x .. 1.30x around the frame centre);
comp_12=  // pointer X pans the view left/right. Centre + released button give the identity transform, so the
comp_13=  // untouched frame stays byte-identical.
comp_14=  float2 mwMouse = (mouse.xy - 0.5) * saturate(mouse.z);
comp_15=  float mwZoomAmt = mwMouse.y > 0.0 ? 0.6 : 0.2;   // zoom in generously, out carefully
comp_16=  float mwZoom = 1.0 + mwMouse.y * mwZoomAmt;
comp_17=  uv = (uv - 0.5) / mwZoom + 0.5 + float2(mwMouse.x * 0.35, 0.0);
comp_18=  float4 fragColor;
comp_19=  float2 fragCoord;
comp_20=  // CONV: Center on screen, then try some aspect correction
comp_21=  uv = (uv*2) - 1;
comp_22=  uv *= aspect.xy;
comp_23=  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_24=  uv = float2(uv.x, -uv.y);
comp_25=
comp_26=  float3 r = float3(uv, 1.0);
comp_27=  float4 o = 0;
comp_28=  float t = time;
comp_29=  float3 p;
comp_30=  
comp_31=  #ifdef bass_smooth
comp_32=    float fac = (int)vis_version > 2 ? 0.9*vis_intensity+vis_shift : (0.8+0.2*smoothstep(0,2,(int)vis_version == 1 ? bass_smooth : bass_att))*vis_intensity+vis_shift;
comp_33=  #else
comp_34=    float fac = 0.9+0.05*smoothstep(0,2,bass_att);
comp_35=  #endif
comp_36=  
comp_37=  for (float i = 0.0, z = 0.0, d; i < 100.0; i++) {
comp_38=    // Ray direction, modulated by time and camera
comp_39=    p = z * normalize(float3(uv, 0.5));
comp_40=    p.z += t;
comp_41=
comp_42=    // Rotating plane using a cos matrix
comp_43=    float rot = 10*sin(time*0.02);
comp_44=    float4 angle = float4(rot, 33.0, 11.0, 0.0);
comp_45=    float4 a = z * 0.2 + t * 0.1 + angle;
comp_46=    p.xy = mul(p.xy, transpose(float2x2(cos(a.x), -sin(a.x), sin(a.x), cos(a.x))));
comp_47=
comp_48=    // Distance estimator
comp_49=    z += d = length(cos(p + cos(p.yzx + p.z - t * 0.2)).xy) / 6.0*fac;
comp_50=
comp_51=    // Color accumulation using sin palette
comp_52=    o += (sin(p.x + t + float4(0, 2, 3, 0)) + 1.0) / d;
comp_53=  }
comp_54=
comp_55=  o = tanh(o / 5000.0);
comp_56=  ret = float4(o.rgb, 1.0);
comp_57=}