comp_265=float2 mapRefrac(float3 p) {
comp_266=  float d  = icosahedral(p, 1.0 + mwDeviation() * 0.12);
comp_267=  float id = 0.0;
comp_268=
comp_269=  return float2(d, id);
comp_270=}
comp_271=
comp_272=float2 mapSolid(float3 p) {
comp_273=  p.xz = rotate2D(p.xz, time * 1.25);
comp_274=  p.yx = rotate2D(p.yx, time * 1.85);
comp_275=  p.y += sin(time) * 0.25;
comp_276=  p.x += cos(time) * 0.25;
comp_277=
comp_278=  float d = lenv(p) - (0.25 + mwDeviation() * 0.06);
comp_279=  float id = 1.0;
comp_280=  float pulse = pow(sin(time * 2.) * 0.5 + 0.5, 9.0) * 2.;
comp_281=
comp_282=  d = lerp(d, sdBox_1117569599(p, float3(0.175, 0.175, 0.175) * (1.0 + mwDeviation() * 0.30)), pulse);
comp_283=
comp_284=  return float2(d, id);
comp_285=}
