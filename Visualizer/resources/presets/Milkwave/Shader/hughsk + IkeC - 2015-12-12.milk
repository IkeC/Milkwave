comp_183=void orbitCamera_421267681(
comp_184=in float camAngle,
comp_185=in float camHeight,
comp_186=in float camDistance,
comp_187=in float2 screenResolution,
comp_188=out float3 rayOrigin,
comp_189=out float3 rayDirection,
comp_190=in float2 coord
comp_191=) {
comp_192=  float2 screenPos = squareFrame_1062606552(screenResolution, coord);
comp_193=  float3 rayTarget = float3(0.0, 0.0, 0.0);
comp_194=
comp_195=  rayOrigin = float3(
comp_196=  camDistance * sin(camAngle),
comp_197=  camHeight,
comp_198=  camDistance * cos(camAngle)
comp_199=  );
comp_200=
comp_201=  rayDirection = getRay_870892966(rayOrigin, rayTarget, screenPos, 2.0);
comp_202=}
