comp_124=float beckmannDistribution_2315452051(float x, float roughness) {
comp_125=  float NdotH = max(x, 0.0001);
comp_126=  float cos2Alpha = NdotH * NdotH;
comp_127=  float tan2Alpha = (cos2Alpha - 1.0) / cos2Alpha;
comp_128=  float roughness2 = roughness * roughness;
comp_129=  float denom = 3.141592653589793 * roughness2 * cos2Alpha * cos2Alpha;
comp_130=  return exp(tan2Alpha / roughness2) / denom;
comp_131=}
