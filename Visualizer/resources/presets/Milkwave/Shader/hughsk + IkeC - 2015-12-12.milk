comp_220=float fogFactorExp2_529295689(
comp_221=float dist,
comp_222=float density
comp_223=) {
comp_224=  const float LOG2 = -1.442695;
comp_225=  float d = density * dist;
comp_226=  return 1.0 - clamp(exp2(d * d * LOG2), 0.0, 1.0);
comp_227=}
