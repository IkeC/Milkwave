comp_133=float cookTorranceSpecular_1460171947(
comp_134=float3 lightDirection,
comp_135=float3 viewDirection,
comp_136=float3 surfaceNormal,
comp_137=float roughness,
comp_138=float fresnel) {
comp_139=
comp_140=  float VdotN = max(dot(viewDirection, surfaceNormal), 0.0);
comp_141=  float LdotN = max(dot(lightDirection, surfaceNormal), 0.0);
comp_142=
comp_143=  float3 H = normalize(lightDirection + viewDirection);
comp_144=
comp_145=  float NdotH = max(dot(surfaceNormal, H), 0.0);
comp_146=  float VdotH = max(dot(viewDirection, H), 0.000001);
comp_147=  float LdotH = max(dot(lightDirection, H), 0.000001);
comp_148=  float G1 = (2.0 * NdotH * VdotN) / VdotH;
comp_149=  float G2 = (2.0 * NdotH * LdotN) / LdotH;
comp_150=  float G = min(1.0, min(G1, G2));
comp_151=
comp_152=  float D = beckmannDistribution_2315452051(NdotH, roughness);
comp_153=
comp_154=  float F = pow(1.0 - VdotN, fresnel);
comp_155=
comp_156=  return  G * F * D / max(3.14159265 * VdotN, 0.000001);
comp_157=}
