comp_110=  const float3 v2 = float3(-1.0,-1.0, 1.0);
comp_111=  const float3 v3 = float3(-1.0, 1.0,-1.0);
comp_112=  const float3 v4 = float3( 1.0, 1.0, 1.0);
comp_113=
comp_114=  return normalize( v1 * mapSolid( pos + v1*eps ).x +
comp_115=  v2 * mapSolid( pos + v2*eps ).x +
comp_116=  v3 * mapSolid( pos + v3*eps ).x +
