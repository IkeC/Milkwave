comp_236=static float3 n4 = float3(0.577,0.577,0.577);
comp_237=static float3 n5 = float3(-0.577,0.577,0.577);
comp_238=static float3 n6 = float3(0.577,-0.577,0.577);
comp_239=static float3 n7 = float3(0.577,0.577,-0.577);
comp_240=static float3 n8 = float3(0.000,0.357,0.934);
comp_241=static float3 n9 = float3(0.000,-0.357,0.934);
comp_242=static float3 n10 = float3(0.934,0.000,0.357);
comp_243=static float3 n11 = float3(-0.934,0.000,0.357);
comp_244=static float3 n12 = float3(0.357,0.934,0.000);
comp_245=static float3 n13 = float3(-0.357,0.934,0.000);
comp_246=
comp_247=float icosahedral(float3 p, float r) {
comp_248=  float s = abs(dot(p,n4));
comp_249=  s = max(s, abs(dot(p,n5)));
comp_250=  s = max(s, abs(dot(p,n6)));
comp_251=  s = max(s, abs(dot(p,n7)));
comp_252=  s = max(s, abs(dot(p,n8)));
comp_253=  s = max(s, abs(dot(p,n9)));
comp_254=  s = max(s, abs(dot(p,n10)));
comp_255=  s = max(s, abs(dot(p,n11)));
comp_256=  s = max(s, abs(dot(p,n12)));
comp_257=  s = max(s, abs(dot(p,n13)));
comp_258=  return s - r;
comp_259=}
