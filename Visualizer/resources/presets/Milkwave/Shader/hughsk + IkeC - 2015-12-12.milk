comp_36=float2 calcRayIntersection_3975550108(float3 rayOrigin, float3 rayDir, float maxd, float precis) {
comp_37=  float latest = precis * 2.0;
comp_38=  float dist   = +0.0;
comp_39=  float type   = -1.0;
comp_40=  float2  res    = float2(-1.0, -1.0);
comp_41=
comp_42=  for (int i=min(frame,0); i < 50; i++) {
comp_43=    // CONV: replaced break with breaking condition
comp_44=    if (latest < precis || dist > maxd)  i = 50;
comp_45=
comp_46=    float2 result = mapRefrac(rayOrigin + rayDir * dist);
comp_47=
comp_48=    latest = result.x;
comp_49=    type   = result.y;
comp_50=    dist  += latest;
comp_51=  }
comp_52=
comp_53=  if (dist < maxd) {
comp_54=    res = float2(dist, type);
comp_55=  }
comp_56=
comp_57=  return res;
comp_58=}
