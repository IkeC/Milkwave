comp_313=shader_body {
comp_314=  float4 fragColor = 0;
comp_315=  float2 fragCoord = uv;
comp_316=  // CONV: Center on screen, then try some aspect correction
comp_317=  uv = (uv*2) - 1;
comp_318=  uv *= aspect.xy;
comp_319=  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_320=  uv = float2(uv.x, -uv.y);
comp_321=  // CONV: Adjust viewpoint (x,y individually or both)
comp_322=  uv += float2(0,0) + 0;
comp_323=  uv *= float2(1,1) * 1;
comp_324=
comp_325=  float3 ro, rd;
comp_326=
comp_327=  float2  suv      = uv;
comp_328=  float2  pixCoord = float2(fragCoord.x, 1.0-fragCoord.y) * texsize.xy;
comp_329=  float dist     = 4.5;
comp_330=  float rotation = mouse.z > 0.0
comp_331=  ? 6. * mouse.x
comp_332=  : time * 0.45;
comp_333=  float height = mouse.z > 0.0
comp_334=  ? 5. * (mouse.y * 2.0 - 1.0)
comp_335=  : -0.2;
comp_336=
comp_337=  orbitCamera_421267681(rotation, height, dist, texsize.xy, ro, rd, pixCoord);
comp_338=
comp_339=  float3 color = bg(ro, rd);
comp_340=  float2 t = calcRayIntersection_3975550108(ro, rd);
comp_341=  if (t.x > -0.5) {
comp_342=    float3 pos = ro + rd * t.x;
comp_343=    float3 nor = calcNormal_3606979787(pos);
comp_344=    float3 ldir1 = normalize(float3(0.8, 1, 0));
comp_345=    float3 ldir2 = normalize(float3(-0.4, -1.3, 0));
comp_346=    float3 lcol1 = float3(0.6, 0.5, 1.1);
comp_347=    float3 lcol2 = float3(1.4, 0.9, 0.8) * 0.7;
comp_348=
comp_349=    float3 ref = refract(rd, nor, 0.97);
comp_350=    float2 u = calcRayIntersection_766934105(ro + ref * 0.1, ref);
comp_351=    if (u.x > -0.5) {
comp_352=      float3 pos2 = ro + ref * u.x;
comp_353=      float3 nor2 = calcNormal_1245821463(pos2);
comp_354=      float spec = cookTorranceSpecular_1460171947(ldir1, -ref, nor2, 0.6, 0.95) * 2.;
comp_355=      float diff1 = 0.05 + max(0., dot(ldir1, nor2));
comp_356=      float diff2 = max(0., dot(ldir2, nor2));
comp_357=
comp_358=      color = spec + (diff1 * lcol1 + diff2 * lcol2);
comp_359=    }
comp_360=
comp_361=    else {
comp_362=      color = bg(ro + ref * 0.1, ref) * 1.1;
comp_363=    }
comp_364=
comp_365=    color += color * cookTorranceSpecular_1460171947(ldir1, -rd, nor, 0.2, 0.9) * 2.;
comp_366=    color += 0.05;
comp_367=  }
comp_368=
comp_369=  float vignette = 1.0;   // vignette removed on request
comp_370=
comp_371=  color.r = smoothstep(0.05, 0.995, color.r);
comp_372=  color.b = smoothstep(-0.05, 0.95, color.b);
comp_373=  color.g = smoothstep(-0.1, 0.95, color.g);
comp_374=  color.b *= vignette;
comp_375=
comp_376=  // AUDIO: the whole frame breathes with the level on top of the shape pulse (0 at version 3+)
comp_377=  color *= 1.0 + mwDeviation() * 0.06;
comp_378=
comp_379=  fragColor.rgb = color;
comp_380=  fragColor.a   = clamp(t.x, 0.5, 1.0);
comp_381=  ret = fragColor;
comp_382=}