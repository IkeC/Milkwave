comp_204=float sdBox_1117569599(float3 position, float3 dimensions) {
comp_205=  float3 d = abs(position) - dimensions;
comp_206=
comp_207=  return min(max(d.x, max(d.y,d.z)), 0.0) + lenv(max(d, 0.0));
comp_208=}
