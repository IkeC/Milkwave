comp_291=float3 bg(float3 ro, float3 rd) {
comp_292=  float3 col = 0.1 + (
comp_293=  palette(clamp((random_2281831123(rd.xz + sin(time * 0.1)) * 0.5 + 0.5) * 0.035 - rd.y * 0.5 + 0.35, -1.0, 1.0)
comp_294=  , float3(0.5, 0.45, 0.55)
comp_295=  , float3(0.5, 0.5, 0.5)
comp_296=  , float3(1.05, 1.0, 1.0)
comp_297=  , float3(0.275, 0.2, 0.19)
comp_298=  )
comp_299=  );
comp_300=
comp_301=  float t = intersectPlane(ro, rd, float3(0, 1, 0), 4.);
comp_302=
comp_303=  if (t > 0.0) {
comp_304=    float3 p = ro + rd * t;
comp_305=    float g = (1.0 - pow(abs(sin(p.x) * cos(p.z)), 0.25));
comp_306=
comp_307=    col += (1.0 - fogFactorExp2_529295689(t, 0.04)) * g * float3(5, 4, 2) * 0.075;
comp_308=  }
comp_309=
comp_310=  return col;
comp_311=}
