comp_92=float3 calcNormal_3606979787(float3 pos, float eps) {
comp_93=  const float3 v1 = float3( 1.0,-1.0,-1.0);
comp_94=  const float3 v2 = float3(-1.0,-1.0, 1.0);
comp_95=  const float3 v3 = float3(-1.0, 1.0,-1.0);
comp_96=  const float3 v4 = float3( 1.0, 1.0, 1.0);
comp_97=
comp_98=  return normalize( v1 * mapRefrac( pos + v1*eps ).x +
comp_99=  v2 * mapRefrac( pos + v2*eps ).x +
comp_100=  v3 * mapRefrac( pos + v3*eps ).x +
comp_101=  v4 * mapRefrac( pos + v4*eps ).x );
comp_102=}
