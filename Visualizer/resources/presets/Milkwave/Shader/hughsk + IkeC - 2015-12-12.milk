comp_229=float intersectPlane(float3 ro, float3 rd, float3 nor, float dist) {
comp_230=  float denom = dot(rd, nor);
comp_231=  float t = -(dot(ro, nor) + dist) / denom;
comp_232=
comp_233=  return t;
comp_234=}
