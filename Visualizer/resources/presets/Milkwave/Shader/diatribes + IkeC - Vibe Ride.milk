MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// diatribes + IkeC - Vibe Ride / https://www.shadertoy.com/view/wcBfR3
comp_2=// Transpiled to HLSL using Milkwave
comp_3=
comp_4=#define tx (sin(time)*0.5+1)
comp_5=
comp_6=#define T (time*.5)
comp_7=#define P(z) (float3(cos((z) * .12) * 16., cos((z) * .1) * 16., (z)))
comp_8=#define R(a) float2x2(cos(a), -sin(a), sin(a), cos(a))
comp_9=#define N normalize
comp_10=
comp_11=float tunnel(float3 p) {
comp_12=  p.xy -= P(p.z).xy;
comp_13=  return cos(p.z*.2)*.45+.6 - length(p.xy);
comp_14=}
comp_15=
comp_16=float fractal(float3 p) {
comp_17=  float s,w,l;
comp_18=
comp_19=  p.z *= .3;
comp_20=  p.x -= 1.25;
comp_21=  p += cos(p.yzx*6.)*.3;
comp_22=  for (s=0.,w=1.; s++ < 8.; p *= l, w *= l )
comp_23=  p  = abs(sin(p))-1.,
comp_24=  l = 1.25/dot(p,p);
comp_25=
comp_26=  return length(p)/w;
comp_27=}
comp_28=
comp_29=float map(float3 p) {
comp_30=  return max(fractal(p), tunnel(p));
comp_31=}
comp_32=
comp_33=shader_body {
comp_34=  // MOUSE: pointer Y zooms - up = zoom in, down = zoom out (0.90x .. 1.30x around the frame centre);
comp_35=  // pointer X pans the view left/right. Centre + released button give the identity transform, so the
comp_36=  // untouched frame stays byte-identical.
comp_37=  float2 mwMouse = (mouse.xy - 0.5) * saturate(mouse.z);
comp_38=  float mwZoomAmt = mwMouse.y > 0.0 ? 0.6 : 0.2;   // zoom in generously, out carefully
comp_39=  float mwZoom = 1.0 + mwMouse.y * mwZoomAmt;
comp_40=  uv = (uv - 0.5) / mwZoom + 0.5 + float2(mwMouse.x * 0.35, 0.0);
comp_41=  float4 o = 0;
comp_42=  // CONV: Center on screen, then try some aspect correction
comp_43=  uv = (uv*2) - 1;
comp_44=  uv *= aspect.xy;
comp_45=  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_46=  uv = float2(uv.x, -uv.y);
comp_47=
comp_48=  uv.x+=0.3;
comp_49=
comp_50=  float2 u = uv;
comp_51=  float s=.1,d=0.,i=0.;
comp_52=  
comp_53=  float angle = sin(T * 0.2) * 0.4;
comp_54=  float2 rotatedU = mul(R(angle), u); 
comp_55=
comp_56=
comp_57=  float3 r = float3(uv,1);
comp_58=  //u = (u-r.xy/2.)/r.y;
comp_59=  
comp_60=  float3  e = float3(.001,0,0),
comp_61=  p = P(T),ro=p,
comp_62=  Z = N( P(T+1.) - p),
comp_63=
comp_64=  X = N(float3(Z.z,0,-Z.z)),
comp_65=  D = mul(float3(rotatedU, 1.0), float3x3(-X, cross(X, Z), Z));
comp_66=
comp_67=  o = float4(0, 0, 0, 0);
comp_68=  for(;i++ < 128.;)
comp_69=  p = ro + D * d * .5,
comp_70=  d += s = map(p),
comp_71=  o += 2.*float4(16,2,1,0) + .03*float4(1,2,5,4)/(.001+abs(s));
comp_72=
comp_73=  o *= o;
comp_74=  //o = tanh(sqrt(o / 1e9 * exp(d/2.)));
comp_75=  
comp_76=  float fac = 1e9;
comp_77=  float shift = 2.8;
comp_78=  
comp_79=  // react to audio
comp_80=  #ifdef bass_smooth
comp_81=    if (vis_version == 1) {
comp_82=      float range = pow(4, vis_intensity);
comp_83=      fac = fac * (1+2*range-clamp(0,2,bass_smooth)*range);
comp_84=    } else if (vis_version == 2) {
comp_85=      float range = pow(1.5, vis_intensity);
comp_86=      fac = fac * (1+2*range-smoothstep(0,2,bass_att)*range);
comp_87=    }
comp_88=    shift += vis_shift;
comp_89=  #else
comp_90=    fac = fac * (4-smoothstep(0,2,bass_att)*1.5);
comp_91=  #endif
comp_92=  
comp_93=  o = saturate(sqrt(o / fac * exp(d/shift)));
comp_94=  
comp_95=  ret = o;
comp_96=}