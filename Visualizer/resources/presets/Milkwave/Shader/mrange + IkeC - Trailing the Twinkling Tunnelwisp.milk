MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// mrange + IkeC - Trailing the Twinkling Tunnelwisp / https://www.shadertoy.com/view/WfcGWj
comp_2=// Transpiled to HLSL using Milkwave
comp_3=
comp_4=#define tx sin(time)*0.5+1
comp_5=
comp_6=float g(float4 p,float s) {
comp_7=  return abs(dot(sin(p*=s),cos(p.zxwy))-1.)/s;
comp_8=}
comp_9=
comp_10=shader_body {
comp_11=  // MOUSE: pointer Y zooms - up = zoom in, down = zoom out (0.90x .. 1.30x around the frame centre);
comp_12=  // pointer X pans the view left/right. Centre + released button give the identity transform, so the
comp_13=  // untouched frame stays byte-identical.
comp_14=  float2 mwMouse = (mouse.xy - 0.5) * saturate(mouse.z);
comp_15=  float mwZoomAmt = mwMouse.y > 0.0 ? 0.6 : 0.2;   // zoom in generously, out carefully
comp_16=  float mwZoom = 1.0 + mwMouse.y * mwZoomAmt;
comp_17=  uv = (uv - 0.5) / mwZoom + 0.5 + float2(mwMouse.x * 0.35, 0.0);
comp_18=  float4 O = 0;
comp_19=  // CONV: Center on screen, then try some aspect correction
comp_20=  uv = (uv*2)-1;
comp_21=  uv *= aspect.xy;
comp_22=  uv = float2(-uv.x, -uv.y);
comp_23=  uv *= 1.5;
comp_24=  // uv.x*=1.1;
comp_25=  // uv.y*=0.8;
comp_26=
comp_27=  uv.y-=1.9;
comp_28=
comp_29=  float2 C=uv;
comp_30=  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_31=
comp_32=  C.x+=-0.1;
comp_33=  C.y+=0.95;
comp_34=
comp_35=  // FYI: This code is intended to be as small as possible.
comp_36=  // As a consequence even harder to read than usual.
comp_37=
comp_38=  float i, d, z, s, T = time;
comp_39=  float4 o, q, p, U=float4(2,1,0,3);
comp_40=  for (
comp_41=  // Store resolution
comp_42=  float2 r = uv.xy
comp_43=  // Step through the scene, up to 78 steps
comp_44=  ; ++i < 79.
comp_45=  // Advance along the ray by current distance estimate (+ epsilon)
comp_46=  // The epsilon makes the cave walls somewhat translucent
comp_47=  ; z += d + 5E-4
comp_48=  // Compute ray direction, scaled by distance
comp_49=  , q = float4(normalize(float3(C-.5*r, r.y)) * z, .2)
comp_50=  // Traverse through the cave
comp_51=  , q.z -= T/5
comp_52=  // Save sign before mirroring
comp_53=  , s = q.y + .1
comp_54=  // Creates the water reflection effect
comp_55=  , q.y = abs(s)
comp_56=  , p = q
comp_57=  , p.y -= .11
comp_58=  // Twist cave walls based on depth
comp_59=  // This uses a trick that a 2D rotation matrix
comp_60=  // float2x2(cos(a), sin(a), -sin(a), cos(a)) can be approximated with:
comp_61=  // float2x2(cos(a + float4(0,11,33,0)))
comp_62=  // 22/7 ~= PI, then 11 ~= 3.5*PI and 33 ~= 10.5*PI
comp_63=  // sin(a) = cos(a-0.5*PI) = cos(a-0.5*PI+4*PI) = cos(a+3.5*PI)
comp_64=  // -sin(a) = cos(a-1.5*PI) = cos(a-1.5*PI+12*PI) = cos(a+10.5*PI)
comp_65=  // If that makes sense to you.
comp_66=  , p.xy = mul(p.xy, transpose(float2x2(cos(11.*U.zywz - 2. * p.z ))))
comp_67=  , p.y -= .2
comp_68=  // Combine gyroid fields at two scales for more detail
comp_69=  , d = abs(g(p,8.) - g(p,24.)) / 4.
comp_70=  // Base glow color varies with distance from center
comp_71=  , p = 1. + cos(.7 * U + 5. * q.z)
comp_72=  )
comp_73=  // Accumulate glow — brighter and sharper if not mirrored (above axis)
comp_74=  o += (s > 0. ? 1. : .1) * p.w * p / max(s > 0. ? d : d*d*d, 5E-4)
comp_75=  ;
comp_76=  
comp_77=  #ifdef bass_smooth
comp_78=    float fac = (int)vis_version > 2 ? 0.2*vis_intensity+vis_shift : (0.1 + 0.2*smoothstep(0,2,(int)vis_version == 1 ? bass_smooth : bass_att))*vis_intensity+vis_shift;
comp_79=  #else
comp_80=    float fac = 0.1 + 0.05*smoothstep(0,2,bass_att);
comp_81=  #endif
comp_82=  
comp_83=  T *= 0.2;
comp_84=  
comp_85=  // Add pulsing glow for the “tunnelwisp”
comp_86=  o += fac*(1.4 + sin(T) * sin(1.7 * T) * sin(2.3 * T))
comp_87=  * 1E3 * U / length(q.xy);
comp_88=
comp_89=  // Apply tanh for soft tone mapping
comp_90=  ret = tanh(o / 1E5);
comp_91=}