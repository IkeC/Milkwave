MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// ADOB - Waves Remix / https://www.shadertoy.com/view/4ljGD1
comp_2=// License: Creative Commons Attribution-NonCommercial-ShareAlike 3.0 (Shadertoy default)
comp_3=// Transpiled to HLSL using Milkwave
comp_4=
comp_5=#define tx (sin(time)*0.5+1)
comp_6=
comp_7=// CONV: setting iChannel samplers to default noise texture
comp_8=#define iChannel0 sampler_noise_lq
comp_9=
comp_10=// CONV: adding helper functions
comp_11=float mod_conv(float x, float y) { return x - y * floor(x / y); }
comp_12=float2 mod_conv(float2 x, float2 y) { return x - y * floor(x / y); }
comp_13=float3 mod_conv(float3 x, float3 y) { return x - y * floor(x / y); }
comp_14=float4 mod_conv(float4 x, float4 y) { return x - y * floor(x / y); }
comp_15=
comp_16=// CONV2: guarded length helpers (legacy compiler reports lenv() as division by zero)
comp_17=float lenv(float2 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_18=float lenv(float3 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_19=float lenv(float4 v) { return sqrt(max(dot(v, v), 0.000001)); }
comp_20=
comp_21=float squared(float value) { return value * value; }
comp_22=
comp_23=float getAmp(float frequency) {
comp_24=  // AUDIO: bass/mid/treble bands instead of the FFT - version 1 reads the smoothed bands,
comp_25=  // version 2 the attack bands, version > 2 the original noise texture (static)
comp_26=  float aNoise = tex2D(iChannel0, float2(frequency / 512.0, 0)).x;
comp_27=  #ifdef bass_smooth
comp_28=    float aBand = frequency < 60.0 ? ((int)vis_version == 1 ? bass_smooth : bass_att)
comp_29=                : frequency < 250.0 ? ((int)vis_version == 1 ? mid_smooth : mid_att)
comp_30=                : ((int)vis_version == 1 ? treb_smooth : treb_att);
comp_31=    return (int)vis_version > 2 ? aNoise : lerp(aNoise, 0.5 * aBand, saturate(vis_intensity));
comp_32=  #else
comp_33=    float aBand = frequency < 60.0 ? bass_att : frequency < 250.0 ? mid_att : treb_att;
comp_34=    return lerp(aNoise, 0.5 * aBand, 0.5);
comp_35=  #endif
comp_36=}
comp_37=
comp_38=float getWeight(float f) {
comp_39=  return (+ getAmp(f-2.0) + getAmp(f-1.0) + getAmp(f+2.0) + getAmp(f+1.0) + getAmp(f)) / 5.0; }
comp_40=
comp_41=  shader_body {
comp_42=  // MOUSE: pointer Y zooms - up = zoom in, down = zoom out (0.90x .. 1.30x around the frame centre);
comp_43=  // pointer X pans the view left/right. Centre + released button give the identity transform, so the
comp_44=  // untouched frame stays byte-identical.
comp_45=  float2 mwMouse = (mouse.xy - 0.5) * saturate(mouse.z);
comp_46=  float mwZoomAmt = mwMouse.y > 0.0 ? 0.6 : 0.2;   // zoom in generously, out carefully
comp_47=  float mwZoom = 1.0 + mwMouse.y * mwZoomAmt;
comp_48=  uv = (uv - 0.5) / mwZoom + 0.5 + float2(mwMouse.x * 0.35, 0.0);
comp_49=  float4 mwDead = float4(0.5, 0.5, 0.0, 0.0);   // superseded: the old mouse code below now reads a centred, released pointer
comp_50=
comp_51=    float4 fragColor = 0;
comp_52=    float2 fragCoord  = uv;
comp_53=    // CONV: Center on screen, then try some aspect correction
comp_54=    uv = (uv*2) - 1;
comp_55=    uv *= aspect.xy;
comp_56=    // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_57=    uv = float2(uv.x, -uv.y);
comp_58=    // CONV: Adjust viewpoint (x,y individually or both)
comp_59=    uv += float2(0,0) + 0;
comp_60=    uv *= float2(1,1) * 1;
comp_61=    // CONV: holding the mouse button tilts the scene slightly, pointer X sets the angle
comp_62=    float aTilt = (mwDead.x - 0.5) * 0.5 * saturate(mwDead.z);
comp_63=    float aTiltS = sin(aTilt), aTiltC = cos(aTilt);
comp_64=    uv = float2(uv.x * aTiltC - uv.y * aTiltS, uv.x * aTiltS + uv.y * aTiltC);
comp_65=    // AUDIO: 1 = calm (bass_smooth), 2 = more reactive (bass_att), 3+ = static - see the remote's Version tooltip
comp_66=    #ifdef bass_smooth
comp_67=      float aRng = (int)vis_version == 1 ? 0.26 : 0.45;
comp_68=      float aFac = (int)vis_version > 2 ? 1*vis_intensity+vis_shift
comp_69=        : (1.0 - aRng*0.5 + smoothstep(0,2,(int)vis_version == 1 ? bass_smooth : bass_att)*aRng) * vis_intensity + vis_shift;
comp_70=    #else
comp_71=      float aFac = (1.0 - 0.15) + smoothstep(0,2,bass_att)*0.30;
comp_72=    #endif
comp_73=    float aDev = aFac - 1.0;   // 0 at the track average, +loud, -quiet
comp_74=    float aBe  = aDev * 4.0;   // beat scale used by the colour reaction
comp_75=    // AUDIO: the wave displacement follows the music bands (smooth/att) instead of the noise texture (see getAmp)
comp_76=
comp_77=    float2 uvTrue = fragCoord.xy / texsize.xy;
comp_78=    // float2 uv = -1.0 + 2.0 * uvTrue;
comp_79=
comp_80=    float lineIntensity;
comp_81=    float glowWidth;
comp_82=    float3 color = float3(0.0, 0.0, 0.0);
comp_83=
comp_84=    for(float i = 0.0; i < 5.0; i++) {
comp_85=
comp_86=      uv.y += (0.2 * sin(uv.x + i/7.0 - time * 0.6));
comp_87=      float Y = uv.y + getWeight(squared(i) * 20.0) *
comp_88=      (tex2D(iChannel0, float2(uvTrue.x, 1)).x - 0.5);
comp_89=      lineIntensity = 0.4 + squared(1.6 * abs(mod_conv(uvTrue.x + i / 1.3 + time,2.0) - 1.0));
comp_90=      glowWidth = abs(lineIntensity / (150.0 * Y));
comp_91=      color += float3(glowWidth * (2.0 + sin(time * 0.13)),
comp_92=      glowWidth * (2.0 - sin(time * 0.23)),
comp_93=      glowWidth * (2.0 - cos(time * 0.19)));
comp_94=    }
comp_95=
comp_96=    fragColor = float4(color, 1.0);
comp_97=    ret = fragColor;
comp_98=    // AUDIO: the line colours rotate slowly with the level
comp_99=    ret = lerp(ret, ret.zyx, aBe * 0.15);
comp_100=  }
comp_101=