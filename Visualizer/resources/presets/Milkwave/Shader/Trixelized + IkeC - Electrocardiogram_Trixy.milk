MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// Trixelized + IkeC - Electrocardiogram_Trixy / https://www.shadertoy.com/view/McycDt
comp_2=// Transpiled to HLSL using Milkwave
comp_3=
comp_4=#define PI 3.141
comp_5=
comp_6=shader_body {
comp_7=  // MOUSE: holding the right button tilts the scene, pointer X sets the angle. sin(0)=0 / cos(0)=1,
comp_8=  // so the frame without a pressed button stays byte-identical.
comp_9=  float mwTilt = (mouse.x - 0.5) * 0.5 * saturate(mouse.z);
comp_10=  float mwTiltS = sin(mwTilt), mwTiltC = cos(mwTilt);
comp_11=  uv = float2(uv.x * mwTiltC - uv.y * mwTiltS, uv.x * mwTiltS + uv.y * mwTiltC);
comp_12=  float4 fragColor = 0;
comp_13=  float2 fragCoord  = uv;
comp_14=  // CONV: Center on screen, then try some aspect correction
comp_15=  uv = (uv*2) - 1;
comp_16=  uv *= aspect.xy;
comp_17=  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_18=  uv = float2(uv.x, -uv.y);
comp_19=
comp_20=  // float2 uv = (fragCoord - (0.5 * uv.xy)) / uv.y;
comp_21=
comp_22=  float hei = 0.0;
comp_23=  
comp_24=  // Wobble
comp_25=  hei += sin(uv.x * 42.0) * 0.005;
comp_26=  hei += sin(uv.x * 20.0) * 0.010;
comp_27=  
comp_28=  // Heartbeat
comp_29=  const float hb_size = 0.20;
comp_30=  const float hb_smooth = 0.15;
comp_31=  float hb_mult = smoothstep(
comp_32=  hb_size + hb_smooth,
comp_33=  hb_size - hb_smooth,
comp_34=  abs(uv.x)
comp_35=  );
comp_36=  
comp_37=  float hb_hei = sin(uv.x / hb_size * PI);
comp_38=  hei = lerp(hei, hb_hei, hb_mult);
comp_39=
comp_40=  #ifdef bass_smooth
comp_41=    float fac = (int)vis_version > 2 ? 1*vis_intensity+vis_shift : (0.75 + 0.5*smoothstep(0,2,(int)vis_version == 1 ? bass_smooth : bass_att))*vis_intensity+vis_shift;
comp_42=  #else
comp_43=    float fac = 0.8 + 0.4*smoothstep(0,2,bass_att);
comp_44=  #endif
comp_45=  
comp_46=  hei*=fac;
comp_47=
comp_48=  // Line + glow value
comp_49=  float val = 0.0;
comp_50=  val += smoothstep(
comp_51=  0.010,
comp_52=  0.005,
comp_53=  abs(hei / 3.0 - uv.y)
comp_54=  );
comp_55=  val += smoothstep(
comp_56=  0.125,
comp_57=  -0.1,
comp_58=  abs(hei / 3.0 - uv.y)
comp_59=  );
comp_60=  
comp_61=  // Base color
comp_62=  float anim = (uv.x - time) / 2.0;
comp_63=  float3 col = pow(frac(anim)*val, 1.5)
comp_64=  * float3(0.250, 1.000, 0.250);
comp_65=
comp_66=  // Grid
comp_67=  float grid_x = abs(1.0 - 2.0 * frac(uv.x * 6.0));
comp_68=  float grid_y = abs(1.0 - 2.0 * frac(uv.y * 12.0));
comp_69=  col += smoothstep(0.1, 0.0, min(grid_x, grid_y))
comp_70=  * (uv.y + 0.5)
comp_71=  * float3(0.1, 0.2, 0.2);
comp_72=
comp_73=  // Output to screen
comp_74=  fragColor = float4(col, 1.0);
comp_75=  ret = fragColor;
comp_76=}