MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
comp_1=// diatribes + IkeC - Starfire1 / https://www.shadertoy.com/view/3fXcWl
comp_2=// Transpiled to HLSL using Milkwave
comp_3=
comp_4=#define tx sin(time)*0.5+1
comp_5=
comp_6=shader_body {
comp_7=  // MOUSE: pointer Y zooms - up = zoom in, down = zoom out (0.90x .. 1.30x around the frame centre);
comp_8=  // pointer X pans the view left/right. Centre + released button give the identity transform, so the
comp_9=  // untouched frame stays byte-identical.
comp_10=  float2 mwMouse = (mouse.xy - 0.5) * saturate(mouse.z);
comp_11=  float mwZoomAmt = mwMouse.y > 0.0 ? 0.6 : 0.2;   // zoom in generously, out carefully
comp_12=  float mwZoom = 1.0 + mwMouse.y * mwZoomAmt;
comp_13=  uv = (uv - 0.5) / mwZoom + 0.5 + float2(mwMouse.x * 0.35, 0.0);
comp_14=  float4 o = 0;
comp_15=
comp_16=  uv *= aspect.xy;
comp_17=
comp_18=  float T = time*0.1;
comp_19=  float Tx = 0.8*sin(T*1)*0.5+1.3;
comp_20=  float Ty = sin(T*0.7)*0.2+1.3;
comp_21=
comp_22=  float2 u = uv;
comp_23=  uv = float2(uv.x, -uv.y);
comp_24=  uv.x += Tx;
comp_25=  uv.y += Ty;
comp_26=
comp_27=  u.x+=-0.13;
comp_28=  u.y+=-0.4;
comp_29=
comp_30=  u.x*=2;
comp_31=  u.y*=1.3;
comp_32=
comp_33=  #ifdef bass_smooth
comp_34=    float fac = (int)vis_version > 2 ? 0.5*vis_intensity+vis_shift : (smoothstep(2,0,(int)vis_version == 1 ? bass_smooth : bass_att)*0.5)*vis_intensity+vis_shift;
comp_35=  #else
comp_36=    float fac = smoothstep(2,0,bass_att)*0.1;
comp_37=  #endif
comp_38=  float pump = 0.04*fac;
comp_39=
comp_40=  float i=0,a,d,s,t=time;
comp_41=  float3  p,
comp_42=  r = float3(uv,1);
comp_43=  for(o*=i; i++<1e2;
comp_44=  d += s = .005+abs(s) * .5,
comp_45=  o += float4(11,2.7-cos(.5*t)*.6,fac,0)/s)
comp_46=  for (p = float3(((u-r.xy/2.)/r.y+cos(t*.3)*float2(.02,.03)) * d, d - 9.),
comp_47=  s = length(p) - 5.8+pump,
comp_48=  a = 1.; a < 24.; a += a)
comp_49=  p += cos(.15*t+a+p.yzx*3.)*.3,
comp_50=  s -= abs(dot(sin(.14*t+p * a * 6.), .05+p-p)) / a;
comp_51=  o = tanh(o / 1e4);
comp_52=  ret = o;
comp_53=}